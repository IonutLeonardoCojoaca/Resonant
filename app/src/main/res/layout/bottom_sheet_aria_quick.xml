<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_aria_gradient"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_menu_aria_selected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Aria"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/ariaQuickContextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_medium"
                android:text="Veo lo que estás escuchando"
                android:textColor="@color/textTheme"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/ariaQuickCloseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/secondaryColorTheme" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ariaQuickResponseCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardsTheme"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/dividerOverlay"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ariaQuickStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/unageo_bold"
                    android:text="¿Alguna pregunta?"
                    android:textColor="@color/secondaryColorTheme"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/ariaQuickProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/secondaryColorTheme"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/ariaQuickResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="7"
                android:text="Estoy aquí. Pregúntame por la música que ves o pídeme que controle el reproductor."
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/ariaQuickInputContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_aria_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/ariaQuickInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/unageo_medium"
            android:hint="Pregunta a Aria…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:maxLines="3"
            android:padding="0dp"
            android:textColor="@color/white"
            android:textColorHint="@color/textTheme"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/ariaQuickMicButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_aria_mic_button"
            android:contentDescription="Hablar con Aria"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/secondaryColorTheme" />

        <ImageButton
            android:id="@+id/ariaQuickSendButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_aria_send_button"
            android:contentDescription="Enviar a Aria"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ariaQuickOpenChatButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/unageo_bold"
        android:text="Abrir conversación completa"
        android:textAllCaps="false"
        android:textColor="@color/textTheme"
        app:icon="@drawable/ic_keyboard_arrow_up"
        app:iconGravity="textEnd"
        app:iconTint="@color/textTheme" />

</LinearLayout>
