<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ariaQuickRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/ariaQuickContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

    <!-- Response card — hidden until Aria replies. Swipe UP → full conversation. -->
    <LinearLayout
        android:id="@+id/ariaQuickResponseCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aria_gemini_response_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- Drag affordance: swiping this card upward opens the complete Aria chat. -->
        <View
            android:id="@+id/ariaQuickDragHandle"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- Status row: label + progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/ariaQuickStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/unageo_bold"
                android:text="¡Hola! ¿En qué te puedo ayudar hoy?"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="1dp" />

            <ProgressBar
                android:id="@+id/ariaQuickProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="#AAAAAA"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Response body text -->
        <TextView
            android:id="@+id/ariaQuickResponseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="6"
            android:text="Aria es una IA y puede cometer errores."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <!-- Song disambiguation choices — visible only while Aria is waiting for the
             user to pick between two or more matching songs. -->
        <LinearLayout
            android:id="@+id/ariaQuickDisambiguationList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Context label -->
        <TextView
            android:id="@+id/ariaQuickContextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/unageo_medium"
            android:text="Veo lo que estás escuchando"
            android:textColor="#55FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Input pill (Gemini-style dark capsule) -->
    <LinearLayout
        android:id="@+id/ariaQuickInputContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_aria_gemini_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <!-- Input text field -->
        <EditText
            android:id="@+id/ariaQuickInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/unageo_medium"
            android:hint="Pregunta a Aria…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:maxLines="3"
            android:padding="0dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="15sp" />

        <!-- Mic button -->
        <ImageButton
            android:id="@+id/ariaQuickMicButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_aria_gemini_send"
            android:contentDescription="Hablar con Aria"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            app:tint="#CCCCCC" />

        <!-- Send button -->
        <ImageButton
            android:id="@+id/ariaQuickSendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_aria_gemini_send"
            android:contentDescription="Enviar a Aria"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="#CCCCCC" />

    </LinearLayout>

    </LinearLayout>

</FrameLayout>
