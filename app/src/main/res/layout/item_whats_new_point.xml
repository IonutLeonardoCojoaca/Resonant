<?xml version="1.0" encoding="utf-8"?>
<!-- Punto de una página de novedades: insignia con check de acento + título y explicación. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_surface_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/pointBadge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="✓"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pointTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_bold"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            tools:text="Escucha en grupo" />

        <TextView
            android:id="@+id/pointDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/textTheme"
            android:textSize="12.5sp"
            tools:text="Salas Unisound para sonar a la vez con tus amigos" />
    </LinearLayout>
</LinearLayout>
