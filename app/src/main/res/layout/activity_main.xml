<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primaryColorTheme">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/primaryColorTheme"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:navGraph="@navigation/nav_graph"
            app:defaultNavHost="true" />

        <View
            android:id="@+id/dim_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:alpha="0"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/gradientBottom"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/bg_gradient_bottom_navigation"/>

        <FrameLayout
            android:id="@+id/mini_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/miniPlayerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:minHeight="64dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                app:strokeColor="@color/transparent"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="#33FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/songImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/ic_disc"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/RoundedCornersImage"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5"/>

                    <LinearLayout
                        android:id="@+id/songDataPlayer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/playerActions"
                        app:layout_constraintStart_toEndOf="@+id/songImage"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/swipeHintLeft"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_chevron_left_mini"
                            android:alpha="0.35"
                            android:contentDescription="@null"
                            app:tint="@color/secondaryColorTheme" />

                        <LinearLayout
                            android:id="@+id/songTextContainer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="4dp">

                            <TextView
                                android:id="@+id/songTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="marquee"
                                android:fontFamily="@font/unageo_medium"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:text="Song Title"
                                android:textColor="@color/secondaryColorTheme"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/songArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="marquee"
                                android:fontFamily="@font/unageo_medium"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:text="Artist Name"
                                android:textColor="@color/textTheme"
                                android:textSize="12sp"
                                android:alpha="0.7"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/swipeHintRight"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_chevron_right_mini"
                            android:alpha="0.35"
                            android:contentDescription="@null"
                            app:tint="@color/secondaryColorTheme" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/playerActions"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Like button -->
                        <ImageButton
                            android:id="@+id/miniPlayerLikeButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_favorite_border"
                            android:contentDescription="Me gusta"
                            app:tint="@color/secondaryColorTheme" />

                        <!-- Play/Pause button -->
                        <FrameLayout
                            android:id="@+id/playButtonContainer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="4dp">

                            <ImageButton
                                android:id="@+id/playPauseButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_play_background"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                android:elevation="0dp" />

                            <View
                                android:id="@+id/playmixRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_playmix_ring"
                                android:visibility="gone"
                                android:elevation="1dp" />

                        </FrameLayout>

                        <!-- Queue button -->
                        <ImageButton
                            android:id="@+id/miniPlayerQueueButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_queue_list"
                            android:contentDescription="Cola de reproducción"
                            app:tint="@color/secondaryColorTheme" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbarPlayer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="-4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:thumb="@color/transparent"
                        android:progressTint="@color/secondaryColorTheme"
                        android:progressBackgroundTint="#33FFFFFF"
                        android:splitTrack="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueFloatingButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="Abrir cola de reproducción"
                android:elevation="12dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="Cola · 0"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="#26262B"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_queue_list"
                app:iconGravity="textStart"
                app:iconPadding="5dp"
                app:iconSize="15dp"
                app:iconTint="@color/white"
                app:rippleColor="#33FFFFFF"
                app:strokeColor="#66E21616"
                app:strokeWidth="1dp" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/playbackDeviceBar"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="1dp"
            app:layout_goneMarginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#241010"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toTopOf="@+id/mini_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_devices"
                    app:tint="@color/secondaryColorTheme" />

                <TextView
                    android:id="@+id/playbackDeviceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#A8A8A8" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/BottomNavigationViewStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:clipToPadding="false"
            app:itemBackground="@android:color/transparent"
            app:itemIconTint="@color/nav_item_color_selector"
            app:itemTextColor="@color/nav_item_color_selector"
            app:labelVisibilityMode="labeled"
            android:fitsSystemWindows="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_navigation_menu" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/downloadProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginBottom="5dp"
            app:cardBackgroundColor="#171717"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp"
            android:translationZ="20dp"
            android:visibility="gone"
            app:strokeWidth="0dp"
            app:strokeColor="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@+id/mini_player"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:paddingHorizontal="15dp">

                <ImageView
                    android:id="@+id/dlIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/secondaryColorTheme"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/downloadText"
                    app:layout_constraintBottom_toBottomOf="@+id/downloadText"/>

                <TextView
                    android:id="@+id/downloadText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Iniciando descarga..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/unageo_medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@+id/dlIcon"
                    app:layout_constraintEnd_toStartOf="@+id/downloadPercentText"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/downloadPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:fontFamily="@font/unageo_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/downloadText"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/downloadProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:trackColor="#404040"
                    app:indicatorColor="@color/secondaryColorTheme"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/downloadText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#111"
        android:fitsSystemWindows="true">
        <include layout="@layout/drawer_index"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
