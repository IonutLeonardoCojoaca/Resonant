<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@id/topBar">

            <!-- Hero por capas con parallax (ChartHero) -->
            <include
                android:id="@+id/chartHero"
                layout="@layout/view_chart_hero" />

            <!-- Toolbar con botón atrás (siempre visible) -->
            <!-- Barra estándar fija (TopBar): atrás + título que aparece al plegar (ChartHero). -->
            <LinearLayout
                android:id="@+id/topBar"
                style="@style/TopBar"
                android:layout_gravity="top"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/TopBar.Back" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    style="@style/TopBar.Title.Collapsed"
                    tools:text="Top Diario" />
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Selector de periodo fijo: se queda pegado bajo la toolbar al colapsar. -->
        <FrameLayout
            android:id="@+id/periodSelectorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColorTheme"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <include
                android:id="@+id/periodSelector"
                layout="@layout/view_chart_period_selector" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation_fade_slide"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/screen_bottom_inset"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- ProgressBar -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLoader"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        app:lottie_autoPlay="false"
        app:lottie_enableMergePathsForKitKatAndAbove="true"
        app:lottie_fileName="loader.json"
        app:lottie_loop="true"
        app:lottie_repeatCount="-1" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
