<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            style="@style/TopBar">

            <ImageButton
                android:id="@+id/arrowGoBackButton"
                style="@style/TopBar.Back"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/title"
                style="@style/TopBar.Title"
                android:text="Todos los Géneros" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Genre List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAllGenres"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="@dimen/screen_bottom_inset"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_genre"
                android:layoutAnimation="@anim/layout_animation_fall_down"/>
                
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/secondaryColorTheme"/>

            <!-- Error View -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:visibility="gone"
                android:gravity="center">
                
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_error"
                    app:tint="@color/textTheme" />
                    
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error al cargar géneros"
                    android:textColor="@color/textTheme"
                    android:layout_marginTop="8dp" />
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reintentar"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
