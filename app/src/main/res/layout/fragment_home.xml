<?xml version="1.0" encoding="utf-8"?>
<!--
    Inicio. Capas, de atrás adelante:
      1. homeAurora: luz de marca que deriva despacio y toma los colores de lo último que sonó (parallax al hacer scroll).
      2. homeScrollView: barra (avatar, campana, buscar), saludo, buscador, accesos rápidos, "Sigue escuchando" y secciones.
      3. Cabecera de búsqueda flotante (ScrollHeaderBehavior), que aparece al bajar.
    Lo controla HomeFragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.HomeFragment">

    <!-- ═══ Capa 1: aurora ═══ -->
    <FrameLayout
        android:id="@+id/homeAuroraLayer"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:importantForAccessibility="noHideDescendants">

        <com.example.resonant.ui.views.AuroraView
            android:id="@+id/homeAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mx_scrim" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/superiorToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Inicio"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/userProfile"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/userProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircularUserImage" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Campana de la bandeja (add-notifications): solo visible con features.notifications. -->
            <FrameLayout
                android:id="@+id/notificationBellButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/notifications_bell_description"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/searchButton"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_notifications_bell"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/notificationBellBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="18dp"
                    android:paddingHorizontal="5dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ─── Saludo ─── -->
        <LinearLayout
            android:id="@+id/homeGreetingBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp">

            <TextView
                android:id="@+id/homeDateEyebrow"
                style="@style/RsEyebrow"
                tools:text="SÁBADO · 18 DE OCTUBRE" />

            <TextView
                android:id="@+id/homeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/white"
                android:textSize="34sp"
                tools:text="Buenas noches," />

            <TextView
                android:id="@+id/homeGreetingName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_extra_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="34sp"
                tools:text="Ionut" />

            <TextView
                android:id="@+id/homeGreetingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="14sp"
                tools:text="Algo tranquilo para cerrar el día." />
        </LinearLayout>

        <!-- ─── Buscador ─── -->
        <LinearLayout
            android:id="@+id/homeSearchPill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_rs_glass_pill"
            android:clickable="true"
            android:contentDescription="Buscar en Resonant"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/unageo_medium"
                android:text="¿Qué te apetece escuchar?"
                android:textColor="@color/textTheme"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ─── Accesos rápidos (los rellena HomeFragment) ─── -->
        <HorizontalScrollView
            android:id="@+id/homeShortcutsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/homeShortcuts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ─── Sigue escuchando ─── -->
        <FrameLayout
            android:id="@+id/homeHeroCard"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_rs_hero_card"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:outlineSpotShadowColor="@color/rs_brand_start"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/homeHeroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rs_hero_scrim" />

            <FrameLayout
                android:id="@+id/homeHeroCoverFrame"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_mx_cover"
                android:elevation="16dp"
                android:rotation="-5">

                <ImageView
                    android:id="@+id/homeHeroCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="160dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <TextView
                    android:id="@+id/homeHeroEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_rs_hero_tag"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:paddingHorizontal="9dp"
                    android:text="SIGUE ESCUCHANDO"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/homeHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    tools:text="Don't Stop The Music" />

                <TextView
                    android:id="@+id/homeHeroArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="Rihanna" />

                <ImageButton
                    android:id="@+id/homeHeroPlay"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_rs_play_white"
                    android:contentDescription="Reproducir"
                    android:elevation="4dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="#FF111111" />
            </LinearLayout>
        </FrameLayout>

        <!-- HISTORY SECTION -->
        <RelativeLayout
            android:id="@+id/historyPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/historyTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/historyFeatured"
                    style="@style/RsSectionTitle"
                    android:text="Retoma desde donde lo has dejado" />

                <TextView
                    style="@style/RsSectionSubtitle"
                    android:text="Vuelve a lo que estabas escuchando" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/historyTextContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listHistoryRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerHistoryItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorHistory"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/textTheme" />

                    <TextView
                        android:id="@+id/tvErrorHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/unageo_medium"
                        android:text="No hay historial"
                        android:textColor="@color/textTheme"
                        android:textSize="14sp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- RECENT FAVORITES SECTION ("lo que te ha gustado") -->
        <RelativeLayout
            android:id="@+id/recentFavoritesPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/recentFavoritesTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/recentFavoritesFeatured"
                    style="@style/RsSectionTitle"
                    android:text="Favoritos recientes" />

                <TextView
                    style="@style/RsSectionSubtitle"
                    android:text="Lo último que has guardado con un corazón" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/recentFavoritesTextContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listRecentFavoritesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerRecentFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/artistPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/artistTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/artistFeatured"
                    style="@style/RsSectionTitle"
                    android:text="" />

                <TextView
                    style="@style/RsSectionSubtitle"
                    android:text="Elegidos según lo que escuchas" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/artistTextContainer">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listArtistsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerArtistItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorArtists"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="@color/textTheme" />
                    <TextView android:id="@+id/tvErrorArtists" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No se pudieron cargar" android:textColor="@color/textTheme" android:textSize="14sp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- ALBUMS SECTION -->
        <RelativeLayout
            android:id="@+id/albumsPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/albumTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/albumsFeatured"
                    style="@style/RsSectionTitle"
                    android:text="" />

                <TextView
                    style="@style/RsSectionSubtitle"
                    android:text="Discos que encajan con tu gusto" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/albumTextContainer">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listAlbumsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerAlbumItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <include layout="@layout/item_album_shimmer_placeholder" />
                        <include layout="@layout/item_album_shimmer_placeholder" />
                        <include layout="@layout/item_album_shimmer_placeholder" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorAlbums"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="@color/textTheme" />
                    <TextView android:id="@+id/tvErrorAlbums" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No disponible" android:textColor="@color/textTheme" android:textSize="14sp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- RECOMMENDED SONGS SECTION (entre Álbumes para ti y Artistas que más escuchas) -->
        <LinearLayout
            android:id="@+id/titleSongsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/songsFeatured"
                style="@style/RsSectionTitle"
                android:text="" />

            <TextView
                style="@style/RsSectionSubtitle"
                android:text="Canciones seleccionadas para ti" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/listSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allSongList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"/>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerSongLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/shimmerSongItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include layout="@layout/item_song_shimmer_placeholder" />
                    <include layout="@layout/item_song_shimmer_placeholder" />
                    <include layout="@layout/item_song_shimmer_placeholder" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/layoutErrorSongs"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="@color/textTheme" />
                <TextView android:id="@+id/tvErrorSongs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No se encontraron canciones" android:textColor="@color/textTheme" android:textSize="14sp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- TOP ARTISTS SECTION (Artistas que más escuchas) -->
        <LinearLayout
            android:id="@+id/topArtistsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <TextView
                android:id="@+id/tvTopArtistsTitle"
                style="@style/RsSectionTitle"
                android:text="Artistas que más escuchas" />

            <TextView
                style="@style/RsSectionSubtitle"
                android:text="Los que más suenan en tu cuenta" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/topArtistsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="8dp"
                android:scrollbars="none" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <!-- TOP ALBUMS SECTION (Álbumes más escuchados) -->
        <LinearLayout
            android:id="@+id/topAlbumsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <TextView
                android:id="@+id/tvTopAlbumsTitle"
                style="@style/RsSectionTitle"
                android:text="Álbumes más escuchados" />

            <TextView
                style="@style/RsSectionSubtitle"
                android:text="Los discos a los que más vuelves" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/topAlbumsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listTopAlbums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="8dp"
                android:scrollbars="none" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerTopAlbums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <!-- MOST LISTENED SONGS SECTION -->
        <LinearLayout
            android:id="@+id/titleTopSongsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvTopSongsTitle"
                style="@style/RsSectionTitle"
                android:text="Tus más escuchadas" />

            <TextView
                style="@style/RsSectionSubtitle"
                android:text="Tu top personal de canciones" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listTopSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="250dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/allTopSongList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerTopSongs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeeMoreTopSongs"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:backgroundTint="@color/rs_glass"
                android:fontFamily="@font/unageo_semi_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="22dp"
                android:text="Ver más"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_keyboard_arrow_down"
                app:iconGravity="textEnd"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/rs_glass_stroke"
                app:strokeWidth="1dp"
                tools:visibility="visible"/>
        </LinearLayout>
    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating search header — always rendered on top -->
    <include
        layout="@layout/view_search_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

</FrameLayout>
