<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/superiorToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Inicio"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/userProfile"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/userProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircularUserImage" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- HISTORY SECTION -->
        <RelativeLayout
            android:id="@+id/historyPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/historyTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <TextView
                    android:id="@+id/historyFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Retoma desde donde lo has dejado"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_gravity="start"/>

            </FrameLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/historyTextContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listHistoryRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerHistoryItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorHistory"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="#808080" />

                    <TextView
                        android:id="@+id/tvErrorHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/unageo_medium"
                        android:text="No hay historial"
                        android:textColor="#808080"
                        android:textSize="14sp"/>

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

        <!-- RECENT FAVORITES SECTION ("lo que te ha gustado") -->
        <RelativeLayout
            android:id="@+id/recentFavoritesPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/recentFavoritesTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <TextView
                    android:id="@+id/recentFavoritesFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Favoritos recientes"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_gravity="start"/>

            </FrameLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/recentFavoritesTextContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listRecentFavoritesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerRecentFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/artistPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/artistTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/artistFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_gravity="start"/>
            </FrameLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/artistTextContainer">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listArtistsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerArtistItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                            <include layout="@layout/item_artist_shimmer_placeholder"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorArtists"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="#808080" />
                    <TextView android:id="@+id/tvErrorArtists" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No se pudieron cargar" android:textColor="#808080" android:textSize="14sp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- ALBUMS SECTION -->
        <RelativeLayout
            android:id="@+id/albumsPrincipalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/albumTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/albumsFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_gravity="center_vertical|left"/>
            </FrameLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/albumTextContainer">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listAlbumsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/shimmerAlbumItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <include layout="@layout/item_album_shimmer_placeholder" />
                        <include layout="@layout/item_album_shimmer_placeholder" />
                        <include layout="@layout/item_album_shimmer_placeholder" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/layoutErrorAlbums"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="#808080" />
                    <TextView android:id="@+id/tvErrorAlbums" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No disponible" android:textColor="#808080" android:textSize="14sp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- RECOMMENDED SONGS SECTION (entre Álbumes para ti y Artistas que más escuchas) -->
        <FrameLayout
            android:id="@+id/titleSongsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/songsFeatured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text=""
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_gravity="center_vertical|start"/>
        </FrameLayout>

        <RelativeLayout
            android:id="@+id/listSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allSongList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"/>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerSongLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/shimmerSongItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include layout="@layout/item_song_shimmer_placeholder" />
                    <include layout="@layout/item_song_shimmer_placeholder" />
                    <include layout="@layout/item_song_shimmer_placeholder" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/layoutErrorSongs"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_alert" app:tint="#808080" />
                <TextView android:id="@+id/tvErrorSongs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/unageo_medium" android:text="No se encontraron canciones" android:textColor="#808080" android:textSize="14sp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- TOP ARTISTS SECTION (Artistas que más escuchas) -->
        <TextView
            android:id="@+id/tvTopArtistsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/unageo_bold"
            android:text="Artistas que más escuchas"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/topArtistsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="8dp"
                android:scrollbars="none" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                    <include layout="@layout/item_artist_shimmer_placeholder"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- TOP ALBUMS SECTION (Álbumes más escuchados) -->
        <TextView
            android:id="@+id/tvTopAlbumsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/unageo_bold"
            android:text="Álbumes más escuchados"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/topAlbumsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listTopAlbums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="8dp"
                android:scrollbars="none" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerTopAlbums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                    <include layout="@layout/item_album_shimmer_placeholder"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- MOST LISTENED SONGS SECTION -->
        <FrameLayout
            android:id="@+id/titleTopSongsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/tvTopSongsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Tus más escuchadas"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_gravity="center_vertical|start"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/listTopSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="250dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/allTopSongList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerTopSongs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                        <include layout="@layout/item_song_shimmer_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeeMoreTopSongs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="10dp"
                android:text="Ver más"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="@font/unageo_medium"
                android:backgroundTint="@color/discTheme"
                app:cornerRadius="25dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="24dp"
                app:icon="@drawable/ic_keyboard_arrow_down"
                app:iconGravity="textEnd"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                android:visibility="gone"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                tools:visibility="visible"/>

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating search header — always rendered on top -->
    <include
        layout="@layout/view_search_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

</FrameLayout>