<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="15dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/songImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            app:shapeAppearanceOverlay="@style/RoundedCornersImage"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/songData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/songImage"
            android:layout_marginStart="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/songTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="@color/white"
                android:fontFamily="@font/unageo_bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/songArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/subtitleBottomSheet"
                android:fontFamily="@font/unageo_medium"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/songStreams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/textBottomSheet"
                android:fontFamily="@font/unageo_regular"
                android:textSize="12sp"/>

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerOverlay"
        app:layout_constraintBottom_toBottomOf="@+id/relativeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout">

        <TextView
            style="@style/OptionRow"
            android:id="@+id/seeSongButton"
            android:drawableStart="@drawable/ic_song"
            android:text="Ver información"/>

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playNextButton"
            android:drawableStart="@drawable/ic_play_next_compact"
            android:text="Reproducir a continuación" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToQueueButton"
            android:drawableStart="@drawable/ic_queue_add"
            android:text="Añadir a la cola" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToRoomButton"
            android:drawableStart="@drawable/ic_add"
            android:text="Añadir a la sala"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/goToAlbumButton"
            android:drawableStart="@drawable/ic_album_outline"
            android:text="Ir al álbum"
            android:visibility="gone"/>

        <TextView
            style="@style/OptionRow"
            android:id="@+id/goToArtistButton"
            android:drawableStart="@drawable/ic_artist_person"
            android:text="Ir al artista"/>

        <TextView
            style="@style/OptionRow"
            android:id="@+id/shareSongButton"
            android:drawableStart="@drawable/ic_share"
            android:text="Compartir"/>

        <TextView
            style="@style/OptionRow"
            android:id="@+id/downloadSongButton"
            android:drawableStart="@drawable/ic_download_done"
            android:text="Descargar" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToFavoriteButton"
            android:drawableStart="@drawable/ic_add_favorite"
            android:text="Añadir a favoritos" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToPlaylistButton"
            android:drawableStart="@drawable/ic_menu_add_selected"
            android:text="Agregar a playlist" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToPlaymixButton"
            android:drawableStart="@drawable/ic_playmix"
            android:text="Añadir a PlayMix" />

        <TextView
            style="@style/OptionRow.Muted"
            android:id="@+id/cancelButton"
            android:drawableStart="@drawable/ic_cancel"
            android:text="Cancelar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
