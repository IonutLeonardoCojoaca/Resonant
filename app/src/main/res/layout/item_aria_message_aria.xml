<?xml version="1.0" encoding="utf-8"?>
<!--
    Respuesta de Aria. Cabecera de agente (avatar + nombre + chip de la acción que
    ha ejecutado) y debajo texto y resultados a ancho completo. Los carruseles
    sangran hasta el borde de la pantalla (márgenes negativos + clipChildren=false).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:layout_marginBottom="22dp">

    <!-- Cabecera del agente -->
    <LinearLayout
        android:id="@+id/ariaHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_aria_avatar">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star_ai"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/unageo_bold"
            android:text="Aria"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- Chip de la herramienta/acción que ha usado el agente -->
        <TextView
            android:id="@+id/ariaIntentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_semi_bold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ariaBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ariaMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_regular"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/textEmphasisHigh"
            android:textSize="14sp" />

        <!-- ── Tarjeta de entidad (playlist / artista / álbum), por capas ── -->
        <FrameLayout
            android:id="@+id/ariaPlaylistCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_aria_glass_panel"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone">

            <!-- Capa 1: portada desenfocada (se mueve con parallax al hacer scroll) -->
            <ImageView
                android:id="@+id/ariaCardBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:scaleX="1.35"
                android:scaleY="1.35" />

            <!-- Capa 2: velo para legibilidad -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_aria_card_scrim"
                android:importantForAccessibility="no" />

            <!-- Capa 3: brillo de marca -->
            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-90dp"
                android:layout_marginEnd="-70dp"
                android:alpha="0.45"
                android:background="@drawable/bg_aria_ai_glow"
                android:importantForAccessibility="no" />

            <!-- Capa 4: contenido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ariaCardCover"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:background="@drawable/bg_aria_cover_placeholder"
                        android:elevation="6dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ariaCardKindLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_bold"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:textColor="@color/aria_accent_text"
                            android:textSize="10.5sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/ariaPlaylistCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/unageo_bold"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/ariaPlaylistCardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/unageo_medium"
                            android:maxLines="1"
                            android:textColor="@color/textTheme"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ariaCardOpenButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_aria_brand_pill"
                            android:drawablePadding="4dp"
                            android:fontFamily="@font/unageo_bold"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="7dp"
                            android:text="Abrir"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:drawableEnd="@drawable/ic_chevron_right_mini"
                            android:drawableTint="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/ariaCardDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/dividerOverlay"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/ariaCardGenresScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ariaCardGenresRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/ariaCardTracksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/unageo_bold"
                        android:text="Top canciones"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ariaCardTrack1"
                        style="@style/AriaCardTrackRow"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ariaCardTrack2"
                        style="@style/AriaCardTrackRow"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ariaCardTrack3"
                        style="@style/AriaCardTrackRow"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- ── Estadísticas del usuario (consulta_usuario) ── -->
        <include layout="@layout/include_aria_user_stats_card"/>

        <!-- ── Racha y motivo de una recomendación (add-aria-context-v2) ── -->
        <include layout="@layout/include_aria_streak_card"/>

        <include layout="@layout/include_aria_pick_card"/>

        <!-- ── Canciones (recomendaciones, vista previa de playlist, desambiguación) ── -->
        <include layout="@layout/include_aria_song_cards"/>

        <!-- ── Artistas relacionados (carrusel) ── -->
        <include layout="@layout/include_aria_related_artists"/>

        <!-- ── Siguientes pasos sugeridos ── -->
        <LinearLayout
            android:id="@+id/ariaFollowupsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/ariaFollowupsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ariaFollowupsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

    <!-- Hora + valoración -->
    <LinearLayout
        android:id="@+id/ariaFeedbackRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/ariaTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_regular"
            android:textColor="@color/textTertiaryAlpha"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/ariaLikeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_aria_feedback_button"
            android:contentDescription="Me gusta esta respuesta"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_thumb_up" />

        <ImageButton
            android:id="@+id/ariaDislikeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_aria_feedback_button"
            android:contentDescription="No me gusta esta respuesta"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_thumb_down" />
    </LinearLayout>
</LinearLayout>
