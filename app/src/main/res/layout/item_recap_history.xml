<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/recapHistoryItemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/unageo_medium"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:text="Septiembre 2026" />

    <TextView
        android:id="@+id/recapHistoryItemBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unageo_bold"
        android:text="@string/recap_history_unseen"
        android:textColor="@color/secondaryColorTheme"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
