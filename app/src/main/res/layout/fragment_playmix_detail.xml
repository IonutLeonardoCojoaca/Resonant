<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.PlaymixDetailFragment">

    <!-- ═══════════════════════════════════════════
         PARALLAX HEADER
    ═══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@color/primaryColorTheme"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false"
            app:contentScrim="@color/primaryColorTheme">

            <!-- Cover image – parallax background (full bleed) -->
            <ImageView
                android:id="@+id/playmixCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/cardsTheme"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.55" />

            <!-- Dark gradient scrim from transparent-top → black-bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_playmix_header_scrim"
                app:layout_collapseMode="pin" />

            <!-- Resplandor de marca (atardecer) bajo el título -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_playmix_hero_glow"
                android:importantForAccessibility="no"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.3" />

            <!-- Marca PlayMix: los dos discos que se solapan, grandes y muy sutiles -->
            <ImageView
                android:id="@+id/playmixHeroMark"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-70dp"
                android:layout_marginBottom="30dp"
                android:alpha="0.12"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_playmix"
                app:tint="@color/playmix_accent"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4" />

            <!-- Info panel at bottom of header -->
            <LinearLayout
                android:id="@+id/playmixDataContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp"
                android:paddingTop="80dp"
                app:layout_collapseMode="none">

                <!-- Eyebrow de marca -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_playmix"
                        app:tint="@color/playmix_accent" />

                    <TextView
                        android:id="@+id/playmixEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/unageo_bold"
                        android:letterSpacing="0.18"
                        android:text="PLAYMIX"
                        android:textColor="@color/playmix_accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Title row + play button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playmixName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/white"
                        android:textSize="30sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="@color/playmix_accent"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        app:cornerRadius="40dp"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="36dp"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

                <TextView
                    android:id="@+id/playmixDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_regular"
                    android:maxLines="1"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Dueño de una Playmix ajena (playmix-sharing-discovery) -->
                <TextView
                    android:id="@+id/playmixOwnerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Datos del set en píldoras -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playmixNumberOfTracks"
                        style="@style/PlaymixStatChip" />

                    <TextView
                        android:id="@+id/playmixDuration"
                        style="@style/PlaymixStatChip"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/playmixBlendSummary"
                        style="@style/PlaymixStatChip"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <!-- Estado de la descarga sin conexión (collection-queue-offline) -->
                    <TextView
                        android:id="@+id/playmixDownloadChip"
                        style="@style/PlaymixStatChip"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Visibilidad, me gusta y compartir (playmix-sharing-discovery); ocultos con la capacidad apagada -->
                <LinearLayout
                    android:id="@+id/playmixSocialRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/playmixVisibilityChip"
                        style="@style/PlaymixStatChip"
                        android:drawablePadding="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/playmixLikeButton"
                        style="@style/PlaymixStatChip"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:contentDescription="Me gusta"
                        android:drawablePadding="4dp"
                        android:focusable="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/playmixShareButton"
                        style="@style/PlaymixStatChip"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:drawablePadding="4dp"
                        android:focusable="true"
                        android:text="Compartir" />

                </LinearLayout>

            </LinearLayout>

            <!-- Pinned top bar (back + title on collapse + settings) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="top"
                android:paddingHorizontal="10dp"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/arrowGoBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/playmixTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/settingsBackground"
                    app:layout_constraintStart_toEndOf="@+id/arrowGoBackButton"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/settingsBackground"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/settingsButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_item_settings_vertical"
                        app:tint="@color/white"
                        android:clickable="false"
                        android:focusable="false" />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════
         SCROLLABLE CONTENT
    ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Curva de tempo del set -->
            <LinearLayout
                android:id="@+id/tempoFlowSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_surface_panel"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_bold"
                        android:letterSpacing="0.16"
                        android:text="CURVA DE TEMPO"
                        android:textColor="@color/textTheme"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tempoFlowRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unageo_bold"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.example.resonant.ui.views.PlaymixTempoFlowView
                    android:id="@+id/tempoFlowView"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/setlistLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.16"
                android:text="EL SET"
                android:textColor="@color/textTheme"
                android:textSize="10sp" />

            <!-- Song + transition list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/songTransitionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="250dp" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/noSongsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="@font/unageo_regular"
                android:gravity="center"
                android:text="Este PlayMix está vacío.\nAñade canciones para empezar a mezclar."
                android:textColor="@color/textTheme"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Enlace a una Playmix que no existe o no se puede ver (playmix-sharing-discovery) -->
            <TextView
                android:id="@+id/playmixUnavailableText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="@font/unageo_regular"
                android:gravity="center"
                android:text="Esta Playmix no está disponible"
                android:textColor="@color/textTheme"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loader -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLoader"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        app:lottie_fileName="loader.json"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_repeatCount="-1"
        app:lottie_enableMergePathsForKitKatAndAbove="true" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
