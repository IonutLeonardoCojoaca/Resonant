<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacío / error de una colección (historial, descargas): icono, título,
     explicación y una acción opcional (reintentar, ir a explorar...). Lo rellena CollectionState. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginBottom="90dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="36dp"
    android:visibility="gone"
    tools:visibility="visible">

    <FrameLayout
        android:id="@+id/stateIconBadge"
        android:layout_width="76dp"
        android:layout_height="76dp">

        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/white"
            tools:src="@drawable/ic_recent" />
    </FrameLayout>

    <TextView
        android:id="@+id/stateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="Aún no has escuchado nada" />

    <TextView
        android:id="@+id/stateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/textTheme"
        android:textSize="14sp"
        tools:text="Las canciones que escuches aparecerán aquí" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stateAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/unageo_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="22dp"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:cornerRadius="22dp"
        tools:text="Explorar música"
        tools:visibility="visible" />
</LinearLayout>
