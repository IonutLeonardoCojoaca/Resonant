<?xml version="1.0" encoding="utf-8"?>
<!-- Barra fija de las fichas: atrás sobre la portada y título que aparece al plegar la cabecera (DetailHero).
     Estilos TopBar.* (la misma barra que el resto de pantallas, en su variante sobre imagen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TopBar">

    <ImageButton
        android:id="@+id/detailBack"
        style="@style/TopBar.Back.OnImage" />

    <TextView
        android:id="@+id/detailToolbarTitle"
        style="@style/TopBar.Title.Collapsed.OnImage" />
</LinearLayout>
