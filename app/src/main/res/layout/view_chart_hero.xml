<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabecera por capas de las pantallas de rankings (charts, artistas, álbumes, comunidad).
    Cada capa (heroLayer*) es un contenedor a pantalla completa que ChartHero desplaza
    a distinta velocidad al colapsar (parallax); dentro, los logos/textos se animan
    en la entrada sin pelearse con ese desplazamiento. Las translationX/Y de los logos
    son su posición de reposo. Acento, logos y textos los pone ChartHero.bind().
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:clipChildren="true">

    <FrameLayout
        android:id="@+id/heroLayerGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/heroGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/heroLayerBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/heroIconBack"
            android:layout_width="230dp"
            android:layout_height="253dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:translationX="80dp"
            android:translationY="64dp"
            tools:src="@drawable/ic_resonant_gradient_green" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/heroLayerFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/heroIconFront"
            android:layout_width="96dp"
            android:layout_height="106dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:translationX="-150dp"
            android:translationY="-50dp"
            tools:src="@drawable/ic_resonant_gradient_green" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_chart_hero_scrim"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/heroLayerText"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/heroTextBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/heroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textSize="11sp"
                tools:text="Ranking de canciones"
                tools:textColor="#2EE6A8" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="34sp"
                tools:text="Top Diario" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/textTheme"
                android:textSize="14sp"
                tools:text="Lo más escuchado hoy" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chart_period_track"
                android:fontFamily="@font/unageo_semi_bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="48 playlists · 12 creadores"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
