<?xml version="1.0" encoding="utf-8"?>
<!--
    Conector entre dos canciones del set de PlayMix: el raíl sigue, con un nodo de mezcla, y al
    lado una tarjeta con el mini diagrama de volumen, el modo (automático / avanzada), los datos
    de la mezcla y las acciones (escuchar la transición y más opciones).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/transitionRail"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginStart="21dp"
        android:background="@drawable/bg_playmix_rail"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/transitionNode"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toBottomOf="@id/transitionCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/transitionCard">

        <ImageView
            android:id="@+id/transitionNodeIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_playmix" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/transitionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="51dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_playmix_connector"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.resonant.ui.views.PlaymixMixGlyphView
            android:id="@+id/transitionGlyph"
            android:layout_width="58dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_playmix_glyph"
            android:importantForAccessibility="no"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transitionEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:textColor="@color/playmix_accent"
                    android:textSize="9.5sp"
                    tools:text="AUTO" />

                <View
                    android:id="@+id/transitionVerdictDot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/transitionVerdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/unageo_semi_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/textTheme"
                    android:textSize="10sp"
                    tools:text="Encaje bueno" />
            </LinearLayout>

            <TextView
                android:id="@+id/transitionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Blend automático" />

            <TextView
                android:id="@+id/transitionDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/textTheme"
                android:textSize="11.5sp"
                tools:text="Beatmatch · 128 → 126 BPM" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/waveformPreviewButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_playmix_icon_button"
            android:contentDescription="Escuchar la transición"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/transitionMoreButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones de la transición"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_item_settings_vertical"
            app:tint="@color/textTheme" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
