<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@id/topBar">

            <!-- Hero por capas con parallax (ChartHero) -->
            <include
                android:id="@+id/chartHero"
                layout="@layout/view_chart_hero" />

            <!-- Barra estándar fija (TopBar): atrás + título que aparece al plegar (ChartHero). -->
            <LinearLayout
                android:id="@+id/topBar"
                style="@style/TopBar"
                android:layout_gravity="top"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/TopBar.Back" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    style="@style/TopBar.Title.Collapsed"
                    android:text="Top Artistas" />
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Selector de periodo fijo bajo la toolbar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColorTheme"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <include
                android:id="@+id/periodSelector"
                layout="@layout/view_chart_period_selector" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="100dp">

            <!-- FEATURED ARTIST SECTION (TOP 1) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/featuredArtistCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="26dp"
                app:cardBackgroundColor="@color/cardsTheme"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Galería (capa de fondo con parallax suave al hacer scroll) -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/artistGalleryPager"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@drawable/gradient_bottom_overlay"
                        app:layout_constraintBottom_toBottomOf="@id/artistGalleryPager"
                        app:layout_constraintTop_toTopOf="@id/artistGalleryPager" />

                    <TextView
                        android:id="@+id/featuredRankBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_rank_badge_gold"
                        android:fontFamily="@font/unageo_bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="#1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/featuredArtistName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:maxLines="1"
                        android:text="Cargando..."
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        app:layout_constraintBottom_toTopOf="@+id/featuredArtistStats"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/featuredArtistStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/unageo_medium"
                        android:text="Artista más escuchado del periodo"
                        android:textColor="@color/textSecondaryAlpha"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@+id/btnViewFeatured"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewFeatured"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/unageo_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver Perfil"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- SECTION HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:text="En el ranking"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/unageo_medium"
                android:includeFontPadding="false"
                android:text="Del puesto #2 en adelante"
                android:textColor="@color/textTheme"
                android:textSize="13sp" />

            <!-- LIST OF OTHER ARTISTS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_fade_slide"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:paddingBottom="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
