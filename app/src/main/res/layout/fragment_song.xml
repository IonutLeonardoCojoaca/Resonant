<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.SongFragment"
    android:background="@color/primaryColorTheme">

    <ImageView
        android:id="@+id/blurrySongImageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentBottom="true"
        android:translationY="120dp"
        android:background="@drawable/bg_gradient_bottom_navigation"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentTop="true"
        android:translationY="-120dp"
        android:rotation="180"
        android:background="@drawable/bg_gradient_bottom_navigation"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="5dp"
        android:paddingHorizontal="15dp">

        <FrameLayout
            android:id="@+id/arrowGoBackBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginVertical="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/arrowGoBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:background="@drawable/ic_arrow_back"
                android:clickable="false"
                android:focusable="false"/>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/albumInfoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/settingsBackground"
            app:layout_constraintStart_toEndOf="@+id/arrowGoBackBackground"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="10dp">

            <TextView
                android:id="@+id/songAlbumType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_medium"
                android:letterSpacing="0.05"
                android:text="Álbum"
                android:textAllCaps="true"
                android:textColor="@color/textSecondaryAlpha"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/songAlbumName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="24dp"
                android:text="Nombre del Álbum"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginVertical="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/settingsButton"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_item_settings_vertical"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:overScrollMode="always">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/song_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:adjustViewBounds="true"
                android:background="@drawable/ic_disc"
                app:shapeAppearanceOverlay="@style/RoundedCornersImageLarge" />

            <RelativeLayout
                android:id="@+id/songData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="10dp"
                android:paddingTop="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/song_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toLeftOf="@id/shareButton"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:maxLines="1"
                        android:text="Song Title"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/songArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/song_title"
                        android:layout_alignParentStart="true"
                        android:layout_toLeftOf="@id/shareButton"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_regular"
                        android:maxLines="1"
                        android:text="Artist Name"
                        android:textColor="@color/textSecondaryAlpha"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/likeButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_favorite_border" />

                    <ImageButton
                        android:id="@+id/shareButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_toStartOf="@id/likeButton"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_share" />

                </RelativeLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/seekbarContainer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/currentTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/unageo_medium"
                    android:text="00:00"
                    android:textColor="@color/numberTime"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:progressTint="@color/white"
                    android:thumbTint="@color/white" />

                <TextView
                    android:id="@+id/totalTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/unageo_medium"
                    android:text="00:00"
                    android:textColor="@color/numberTime"
                    android:textSize="12sp" />

            </RelativeLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nextSongContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surfaceCardOverlay"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dividerOverlay"
                app:strokeWidth="0dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_skip_next"
                        app:tint="@color/textSecondaryAlpha"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIGUIENTE"
                            android:textColor="@color/textSecondaryAlpha"
                            android:textSize="9sp"
                            android:fontFamily="@font/unageo_medium"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/nextSongInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:fontFamily="@font/unageo_bold"
                            android:ellipsize="end"
                            android:maxLines="1"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playbackDeviceContainer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/playbackDeviceCardBackground"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="0dp"
                app:strokeColor="@color/playbackDeviceCardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_devices"
                        app:tint="@color/secondaryColorTheme" />

                    <TextView
                        android:id="@+id/playbackDeviceText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/textTheme" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/playerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/shuffleButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_random" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/previousSongButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_previous" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/playButtonContainer"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_play_button_circle">

                    <ImageButton
                        android:id="@+id/playPauseButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_play"
                        android:tint="@color/black" />

                    <View
                        android:id="@+id/playmixRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_playmix_ring"
                        android:visibility="gone"
                        android:elevation="1dp" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/nextSongButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_next" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/replay_button"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_replay" />

                </FrameLayout>

            </LinearLayout>

            <!-- ── UP NEXT / LYRICS / RELATED TABS ── -->

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/songTabLayout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_song_tab_track"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/bg_song_tab_bubble"
                app:tabIndicatorColor="@color/secondaryColorTheme"
                app:tabIndicatorGravity="stretch"
                app:tabIndicatorFullWidth="true"
                app:tabIconTint="@color/song_tab_icon_tint"
                app:tabRippleColor="@null">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_tab_upnext" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_tab_lyrics" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_tab_related" />

            </com.google.android.material.tabs.TabLayout>

            <FrameLayout
                android:id="@+id/songTabContent"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="48dp"
                android:background="@drawable/bg_song_tab_panel"
                android:clipToOutline="true">

                <include
                    android:id="@+id/upNextTabContent"
                    layout="@layout/content_song_tab_upnext"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/lyricsTabContent"
                    layout="@layout/content_song_tab_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <include
                    android:id="@+id/relatedTabContent"
                    layout="@layout/content_song_tab_related"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
