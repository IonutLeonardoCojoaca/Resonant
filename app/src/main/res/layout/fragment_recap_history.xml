<?xml version="1.0" encoding="utf-8"?>
<!-- "Tus resúmenes" (Ajustes): lista de resúmenes mensuales; tocar uno abre sus historias. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/recapHistoryBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="@string/recap_history_title" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recapHistoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/screen_bottom_inset" />

        <ProgressBar
            android:id="@+id/recapHistoryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/recapHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/unageo_medium"
            android:gravity="center"
            android:text="@string/recap_history_empty"
            android:textColor="@color/textTheme"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
