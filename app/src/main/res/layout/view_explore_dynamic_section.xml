<?xml version="1.0" encoding="utf-8"?>
<!-- Sección genérica de Explorar v2: cabecera con el título del servidor, motivo
     opcional y una lista (horizontal o grid según el tipo). El shimmer se ve
     mientras la sección está pendiente de su carga diferida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="vertical">

    <include
        android:id="@+id/dynamicSectionHeader"
        layout="@layout/view_explore_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/dynamicSectionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_regular"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/textTheme"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Porque escuchas Bad Omens"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dynamicSectionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingHorizontal="8dp"
            android:scrollbars="none" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/dynamicSectionShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <include layout="@layout/item_album_shimmer_placeholder" />
                <include layout="@layout/item_album_shimmer_placeholder" />
                <include layout="@layout/item_album_shimmer_placeholder" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

    </FrameLayout>
</LinearLayout>
