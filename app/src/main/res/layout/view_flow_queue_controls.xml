<?xml version="1.0" encoding="utf-8"?>
<!-- Controles de Flow compartidos por la hoja de cola y la pestaña "A continuación". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flow_queue_controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="@string/flow_continue_title"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_regular"
                android:text="@string/flow_continue_subtitle"
                android:textColor="@color/textTheme"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/flow_continue_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>
    <!-- Flow v2 (capacidad flowV2): nivel de descubrimiento y guardar la sesión. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/flow_discovery_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flow_level_familiar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/flow_level_familiar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flow_level_balanced"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/flow_level_balanced"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flow_level_discover"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/flow_level_discover"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/flow_save_session"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/unageo_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="0dp"
        android:text="@string/flow_save_session"
        android:textAllCaps="false"
        android:textColor="@color/secondaryColorTheme"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
