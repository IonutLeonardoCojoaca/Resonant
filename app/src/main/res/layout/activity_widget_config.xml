<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración opcional del acceso rápido del widget (add-android-widget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/widgetConfigTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetConfigSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_config_subtitle"
        android:textColor="@color/textTheme"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widgetConfigLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_config_loading"
        android:textColor="@color/textTheme"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/widgetConfigList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />
</LinearLayout>
