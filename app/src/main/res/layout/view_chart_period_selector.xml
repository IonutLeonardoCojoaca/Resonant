<?xml version="1.0" encoding="utf-8"?>
<!--
    Selector de periodo segmentado de las pantallas de rankings. El indicador
    (periodIndicator) se desliza bajo la opción elegida; tamaño, color de acento
    y textos los gestiona ChartPeriodSelector.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_chart_period_track"
    android:padding="4dp">

    <View
        android:id="@+id/periodIndicator"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/periodOption0"
            style="@style/ChartPeriodOption"
            tools:text="Hoy" />

        <TextView
            android:id="@+id/periodOption1"
            style="@style/ChartPeriodOption"
            tools:text="Semana" />

        <TextView
            android:id="@+id/periodOption2"
            style="@style/ChartPeriodOption"
            tools:text="Mes" />

        <TextView
            android:id="@+id/periodOption3"
            style="@style/ChartPeriodOption"
            tools:text="Global" />
    </LinearLayout>
</FrameLayout>
