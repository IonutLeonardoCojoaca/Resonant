<?xml version="1.0" encoding="utf-8"?>
<!-- Generación de una pista con IA: fondo parallax, portada que se revela al terminar, etapas y acciones. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.AiTrackProgressFragment">

    <com.example.resonant.ui.customviews.AiParallaxBackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <LinearLayout
                android:id="@+id/topBar"
                style="@style/TopBar">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/TopBar.Back"
                    android:contentDescription="Volver" />

                <TextView
                    android:id="@+id/topTitle"
                    style="@style/TopBar.Title"
                    android:text="Creando tu pista" />
            </LinearLayout>

            <!-- Portada: placeholder animado mientras se genera; la real entra con escala y giro al terminar. -->
            <FrameLayout
                android:id="@+id/coverStage"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/coverCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="18dp"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp">

                    <View
                        android:id="@+id/coverPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/coverImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:contentDescription="Portada de la pista"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/coverPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/unageo_bold"
                        android:textColor="@color/white"
                        android:textSize="44sp"
                        tools:text="42%" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="26dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="24sp"
                tools:text="Sombras en la Noche" />

            <TextView
                android:id="@+id/trackMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_aria_brand_pill"
                android:fontFamily="@font/unageo_medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="Lyria 3.5 Pro · 2:30 · 140 BPM" />

            <TextView
                android:id="@+id/stageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:textColor="@color/white"
                android:textSize="18sp"
                tools:text="Generando el audio" />

            <TextView
                android:id="@+id/stageDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/unageo_regular"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                tools:text="Lyria toca la pista en tiempo real: tarda más o menos lo que dura." />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/stageProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="14dp"
                app:indicatorColor="@color/white"
                app:trackColor="#33FFFFFF"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <!-- Línea de etapas: filas creadas en AiTrackProgressFragment. -->
            <LinearLayout
                android:id="@+id/stageTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_ai_progress_panel"
                android:orientation="vertical"
                android:padding="16dp" />

            <LinearLayout
                android:id="@+id/doneActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/unageo_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Reproducir"
                    android:textAllCaps="false"
                    android:textColor="#07070C"
                    app:cornerRadius="27dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconTint="#07070C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSongButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/unageo_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Ver canción"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="27dp"
                    app:strokeColor="#66FFFFFF" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:cornerRadius="27dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
