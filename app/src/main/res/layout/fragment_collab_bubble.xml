<?xml version="1.0" encoding="utf-8"?>
<!--
    Collab Finder · mapa completo de un artista. Capas (de atrás a delante):
    foto del artista desenfocada (parallax lento) → glow de acento → cabecera y mapa
    de órbitas → estadísticas, orden y lista de colaboradores.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Capa de fondo: foto del artista desenfocada + fundido al fondo -->
            <FrameLayout
                android:id="@+id/heroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="440dp">

                <ImageView
                    android:id="@+id/ivBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/backdropGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_chart_hero_scrim"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/screen_bottom_inset">

                <!-- Hueco de la barra fija (superiorToolbar), que flota sobre el scroll -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="56dp" />

                <LinearLayout
                    android:id="@+id/headerBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/tvHeaderEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unageo_bold"
                        android:letterSpacing="0.16"
                        android:text="Mapa de colaboraciones"
                        android:textAllCaps="true"
                        android:textColor="#8C9DFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvHeaderArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="2"
                        android:shadowRadius="10"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        tools:text="The Weeknd" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/unageo_medium"
                        android:gravity="center"
                        android:text="Toca cualquier artista para abrir vuestra colaboración"
                        android:textColor="@color/textTheme"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.example.resonant.feature.collabfinder.ui.views.BubbleOrbitView
                    android:id="@+id/bubbleOrbitView"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="2dp" />

                <!-- Estadísticas: tres tarjetas -->
                <LinearLayout
                    android:id="@+id/statsStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <include
                        android:id="@+id/statCollabs"
                        layout="@layout/view_collab_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statSongs"
                        layout="@layout/view_collab_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statYears"
                        layout="@layout/view_collab_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="26dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Todos sus colaboradores"
                    android:textColor="@color/white"
                    android:textSize="19sp" />

                <include
                    android:id="@+id/sortSelector"
                    layout="@layout/view_chart_period_selector"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCollaborators"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/layout_animation_fade_slide"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp"
                    tools:listitem="@layout/item_collaborator_list" />

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra fija sobre la foto desenfocada: botones OnImage (círculo translúcido, blanco literal). -->
    <LinearLayout
        android:id="@+id/superiorToolbar"
        style="@style/TopBar"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back.OnImage"
            android:contentDescription="Volver" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSearchAnother"
            style="@style/TopBar.Action.OnImage"
            android:contentDescription="Buscar otro artista"
            android:src="@drawable/ic_search" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
