<?xml version="1.0" encoding="utf-8"?>
<!-- Controles del editor v2 (spotify-style-transition-engine) dentro del visualizador del editor de transición:
     presets, carriles, ventana, beatmatching y estado del render. Mismos estilos que el editor antiguo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Estado de la mezcla: guardada y renderizada, renderizando o sin guardar -->
    <TextView
        android:id="@+id/mixV2Status"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_preset_chip"
        android:drawablePadding="6dp"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <!-- Preset -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/unageo_medium"
        android:text="Preset"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mixV2PresetRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/mixV2PresetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/unageo_regular"
        android:textColor="#66FFFFFF"
        android:textSize="10sp" />

    <!-- Ventana: mover un compás y beatmatching -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mixV2WindowEarlier"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_preset_chip"
            android:contentDescription="Mover la mezcla un compás antes"
            android:fontFamily="@font/unageo_medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="◀  1 compás"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mixV2WindowLater"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_preset_chip"
            android:contentDescription="Mover la mezcla un compás después"
            android:fontFamily="@font/unageo_medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="1 compás  ▶"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/mixV2KeyA"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_preset_chip"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingHorizontal="8dp"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:text="→"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/mixV2KeyB"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_preset_chip"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingHorizontal="8dp"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_medium"
                android:text="Beatmatching"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mixV2BeatSyncHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/unageo_regular"
                android:textColor="#66FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/mixV2BeatSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>

    <!-- Carriles: una opción por carril (catálogo de lane-options) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/unageo_medium"
        android:text="Carriles"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/mixV2Lanes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>
