<?xml version="1.0" encoding="utf-8"?>
<!--
    Modo del editor de transiciones de PlayMix (motor antiguo): selector «Automático / Avanzado» y, en automático,
    la explicación de lo que hará el motor inteligente. Las canciones y sus tempos ya están en la cabecera.
    Lo controla CrossfadeEditorFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <TextView
        style="@style/MxEyebrow"
        android:text="CÓMO SE MEZCLAN" />

    <include
        android:id="@+id/playmixModeSelector"
        layout="@layout/view_chart_period_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp" />

    <!-- Automático: qué va a pasar y por qué -->
    <LinearLayout
        android:id="@+id/smartModePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_mx_card"
        android:orientation="vertical"
        android:padding="18dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/smartModeBadge"
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/smartModeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_playmix" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/smartModeEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:letterSpacing="0.14"
                    android:text="AUTOMÁTICO"
                    android:textSize="9.5sp"
                    tools:textColor="#FF7A59" />

                <TextView
                    android:id="@+id/smartModeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="Beatmatch de 8 a 16 compases" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/smartModeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/textTheme"
            android:textSize="13sp"
            tools:text="Los tempos casan: B se ajusta al tempo de A, entra en un compás y los graves se intercambian a mitad de la mezcla." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/dividerOverlay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_medium"
            android:text="Se recalcula solo si cambias el orden. Pasa a «Avanzado» para elegir tú los puntos y el estilo."
            android:textColor="@color/textTheme"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
