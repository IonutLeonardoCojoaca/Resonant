<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabecera de modo del editor de transiciones de PlayMix: selector «Blend automático /
    Transición avanzada» y, en automático, la explicación de lo que hará el motor inteligente.
    Lo controla CrossfadeEditorFragment (bindModePanel / updateModePanel).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unageo_bold"
        android:letterSpacing="0.16"
        android:text="CÓMO SE MEZCLAN"
        android:textColor="@color/textTheme"
        android:textSize="10sp" />

    <include
        android:id="@+id/playmixModeSelector"
        layout="@layout/view_chart_period_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp" />

    <!-- Blend automático: qué va a pasar y por qué -->
    <LinearLayout
        android:id="@+id/smartModePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_surface_panel"
        android:orientation="vertical"
        android:padding="16dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/smartModeBadge"
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/smartModeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_playmix" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/smartModeEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:letterSpacing="0.14"
                    android:text="BLEND AUTOMÁTICO"
                    android:textSize="9.5sp"
                    tools:textColor="#FF7A59" />

                <TextView
                    android:id="@+id/smartModeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="Beatmatch a 8–16 compases" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/smartModeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/textTheme"
            android:textSize="13sp"
            tools:text="Los tempos casan: B se ajusta al tempo de A, entra en un compás y los graves se intercambian a mitad de la mezcla." />

        <!-- Canción A → canción B (en automático el bloque de B del editor está oculto) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/smartModeSongA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_semi_bold"
                android:maxLines="1"
                android:textColor="@color/playmix_accent"
                android:textSize="11.5sp"
                tools:text="Summertime" />

            <TextView
                android:id="@+id/smartModeSongB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_semi_bold"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/playmix_accent_end"
                android:textSize="11.5sp"
                tools:text="Always Be My Fault" />
        </LinearLayout>

        <!-- Tempo A → B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/smartModeBpmA"
                style="@style/PlaymixStatChip"
                tools:text="128 BPM" />

            <View
                android:id="@+id/smartModeBpmLink"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/smartModeMatch"
                style="@style/PlaymixStatChip"
                tools:text="± 1,6 %" />

            <View
                android:id="@+id/smartModeBpmLink2"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/smartModeBpmB"
                style="@style/PlaymixStatChip"
                tools:text="126 BPM" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/unageo_medium"
            android:text="Se recalcula solo si cambias el orden. Pasa a «Transición avanzada» para elegir tú los puntos, la curva y la EQ."
            android:textColor="@color/textTheme"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
