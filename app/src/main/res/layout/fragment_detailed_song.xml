<?xml version="1.0" encoding="utf-8"?>
<!--
    Ficha de canción: cabecera por capas con parallax (view_detail_hero) y debajo el "ADN sonoro"
    (tempo, tono con rueda de Camelot, sonoridad y curva de energía con los puntos del tema),
    estilo, álbum, artistas y relacionadas. Lo rellena DetailedSongFragment.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConstraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.DetailedSongFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:background="@color/primaryColorTheme"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/songBackgroundFallback"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="250"
            app:titleEnabled="false"
            app:toolbarId="@id/detailToolbar">

            <include
                android:id="@+id/hero"
                layout="@layout/view_detail_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/detailToolbar"
                layout="@layout/view_detail_toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- ═══ ADN sonoro ═══ -->
            <LinearLayout
                android:id="@+id/sonicSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/RsSectionTitle"
                    android:accessibilityHeading="true"
                    android:text="ADN sonoro"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Tempo -->
                    <LinearLayout
                        android:id="@+id/tileTempo"
                        style="@style/DetailTile"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tempoLabel"
                                style="@style/DetailTileLabel"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="TEMPO" />

                            <View
                                android:id="@+id/bpmPulse"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tempoValue"
                                style="@style/DetailTileValue"
                                tools:text="128" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/unageo_bold"
                                android:text="BPM"
                                android:textColor="@color/textTheme"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tempoFeel"
                            style="@style/DetailTileCaption"
                            tools:text="Bailable · compás 4/4" />
                    </LinearLayout>

                    <!-- Tono -->
                    <LinearLayout
                        android:id="@+id/tileKey"
                        style="@style/DetailTile"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/keyLabel"
                                    style="@style/DetailTileLabel"
                                    android:text="TONO" />

                                <TextView
                                    android:id="@+id/keyValue"
                                    style="@style/DetailTileValue"
                                    android:layout_marginTop="10dp"
                                    tools:text="C♯m" />
                            </LinearLayout>

                            <com.example.resonant.ui.views.CamelotWheelView
                                android:id="@+id/camelotWheel"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/keyName"
                            style="@style/DetailTileCaption"
                            tools:text="Do♯ menor · casa con 11A, 1A, 12B" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sonoridad -->
                <LinearLayout
                    android:id="@+id/tileLoudness"
                    style="@style/DetailTile"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/loudnessLabel"
                                style="@style/DetailTileLabel"
                                android:text="SONORIDAD" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/loudnessValue"
                                    style="@style/DetailTileValue"
                                    tools:text="-8,4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="5dp"
                                    android:fontFamily="@font/unageo_bold"
                                    android:text="LUFS"
                                    android:textColor="@color/textTheme"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/loudnessFeel"
                            style="@style/PlaymixStatChip"
                            android:layout_marginBottom="4dp"
                            tools:text="Alta" />
                    </LinearLayout>

                    <com.example.resonant.ui.views.LevelMeterView
                        android:id="@+id/loudnessMeter"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="14dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DetailTileCaption"
                            android:layout_width="0dp"
                            android:layout_marginTop="0dp"
                            android:layout_weight="1"
                            android:text="Dinámica" />

                        <TextView
                            style="@style/DetailTileCaption"
                            android:layout_marginTop="0dp"
                            android:text="Comprimida" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Energía -->
                <LinearLayout
                    android:id="@+id/tileEnergy"
                    style="@style/DetailTile"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/energyLabel"
                        style="@style/DetailTileLabel"
                        android:text="ENERGÍA A LO LARGO DEL TEMA" />

                    <com.example.resonant.ui.views.EnergySpectrumView
                        android:id="@+id/energySpectrum"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DetailTileCaption"
                            android:layout_width="0dp"
                            android:layout_marginTop="0dp"
                            android:layout_weight="1"
                            android:text="0:00" />

                        <TextView
                            android:id="@+id/energyEnd"
                            style="@style/DetailTileCaption"
                            android:layout_marginTop="0dp"
                            tools:text="2:49" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Estilo: géneros, etiquetas y letra ═══ -->
            <TextView
                android:id="@+id/styleLabel"
                style="@style/RsSectionTitle"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="Estilo"
                android:textSize="18sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/styleScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-16dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/styleChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ═══ Álbum: fila normal (portada + textos), como las de la lista ═══ -->
            <LinearLayout
                android:id="@+id/albumCard"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginHorizontal="-8dp"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/albumCover"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/songAlbum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_medium"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="WE DON'T TRUST YOU" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_medium"
                        android:maxLines="1"
                        android:text="Del álbum"
                        android:textColor="@color/textTheme"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:rotation="-90"
                    android:src="@drawable/ic_keyboard_arrow_down"
                    app:tint="@color/textTheme" />
            </LinearLayout>

            <!-- ═══ Artistas ═══ -->
            <TextView
                android:id="@+id/artistText"
                style="@style/RsSectionTitle"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="Artistas"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artistList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-8dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

            <!-- ═══ Relacionadas ═══ -->
            <LinearLayout
                android:id="@+id/relatedSongsHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/relatedSongsHeader"
                    style="@style/RsSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="Suena parecido"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnPlayRelated"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_playmix_icon_button"
                    android:contentDescription="Reproducir relacionadas"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/white" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedSongsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-8dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerRelatedSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_song_shimmer_placeholder" />

                    <include layout="@layout/item_song_shimmer_placeholder" />

                    <include layout="@layout/item_song_shimmer_placeholder" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
