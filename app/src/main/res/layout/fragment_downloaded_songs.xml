<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- Hero por capas con parallax (ChartHero) -->
            <include
                android:id="@+id/chartHero"
                layout="@layout/view_chart_hero" />

            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Atrás"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvToolbarTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:paddingStart="56dp"
                        android:paddingEnd="56dp"
                        android:text="Descargas"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/deleteAllButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Eliminar todas las descargas"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_delete"
                        android:tooltipText="Eliminar todas las descargas"
                        android:visibility="gone"
                        app:tint="@color/white" />

                </FrameLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Búsqueda siempre visible: se queda pegada bajo la toolbar al colapsar. -->
        <FrameLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColorTheme"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_chart_period_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/textTheme" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/unageo_medium"
                    android:hint="Buscar en tus descargas"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/textTheme"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/closeSearchButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Borrar búsqueda"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/textTheme" />
            </LinearLayout>
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Zona de contenido: lista (con almacenamiento/consejo/acciones como cabecera) y estados. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fade_slide"
            android:paddingHorizontal="10dp"
            android:paddingBottom="250dp" />

        <include
            android:id="@+id/stateView"
            layout="@layout/view_collection_state" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
