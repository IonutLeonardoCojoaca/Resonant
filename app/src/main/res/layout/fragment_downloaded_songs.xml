<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@id/topBar">

            <!-- Hero por capas con parallax (ChartHero) -->
            <include
                android:id="@+id/chartHero"
                layout="@layout/view_chart_hero" />

            <!-- Barra estándar fija (TopBar): atrás + título que aparece al plegar (ChartHero). -->
            <LinearLayout
                android:id="@+id/topBar"
                style="@style/TopBar"
                android:layout_gravity="top"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/TopBar.Back" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    style="@style/TopBar.Title.Collapsed"
                    android:text="Descargas" />

                <ImageButton
                    android:id="@+id/deleteAllButton"
                    style="@style/TopBar.Action"
                    android:contentDescription="Eliminar todas las descargas"
                    android:src="@drawable/ic_delete"
                    android:tooltipText="Eliminar todas las descargas"
                    android:visibility="gone" />
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Búsqueda siempre visible: se queda pegada bajo la toolbar al colapsar. -->
        <FrameLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColorTheme"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_chart_period_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/textTheme" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/unageo_medium"
                    android:hint="Buscar en tus descargas"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/textTheme"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/closeSearchButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Borrar búsqueda"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/textTheme" />
            </LinearLayout>
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Zona de contenido: lista (con almacenamiento/consejo/acciones como cabecera) y estados. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fade_slide"
            android:paddingHorizontal="10dp"
            android:paddingBottom="250dp" />

        <!-- Arriba y no centrado: el área se extiende bajo el mini player al plegar la cabecera. -->
        <include
            android:id="@+id/stateView"
            layout="@layout/view_collection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="0dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
