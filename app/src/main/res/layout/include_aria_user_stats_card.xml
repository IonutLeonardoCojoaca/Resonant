<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de datos del usuario en Aria: título, una fila de 3 cifras clave y, debajo, el ranking.
     Sin rejilla de tiles ni etiquetas en mayúsculas por bloque. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ariaUserStatsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_aria_glass_panel"
    android:clipToOutline="true"
    android:visibility="gone">

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-90dp"
        android:alpha="0.3"
        android:background="@drawable/bg_aria_ai_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/userStatsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <!-- Cifras clave: una sola fila de 3 -->
        <LinearLayout
            android:id="@+id/userStatsGridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/userStatsPlaysCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userStatsTotalPlaysValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:text="reproducciones"
                    android:textColor="@color/textTheme"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/userStatsHoursCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userStatsListenHoursValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:text="horas"
                    android:textColor="@color/textTheme"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/userStatsDaysCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userStatsDaysActiveValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:text="días activo"
                    android:textColor="@color/textTheme"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Datos secundarios en una línea (playlists · media diaria · últimos 7 días · favoritos) -->
        <TextView
            android:id="@+id/userStatsMetaLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Ranking de artistas -->
        <LinearLayout
            android:id="@+id/userStatsTopArtistsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/userStatsTopArtistsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/unageo_bold"
                android:text="Top artistas"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/userStatsTopArtistsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Géneros: ranking si es el tema de la tarjeta; si no, píldoras -->
        <LinearLayout
            android:id="@+id/userStatsTopGenresContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/userStatsTopGenresLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/unageo_bold"
                android:text="Tus géneros"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/userStatsTopGenresList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/userStatsTopGenresChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:flexWrap="wrap" />
        </LinearLayout>

        <!-- Favoritas (user_favorites) -->
        <LinearLayout
            android:id="@+id/userStatsFavoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/userStatsFavoritesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Mood (user_mood) -->
        <LinearLayout
            android:id="@+id/userStatsMoodContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/userStatsMoodValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:textColor="@color/aria_accent_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/userStatsMoodTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Historial (user_history) -->
        <LinearLayout
            android:id="@+id/userStatsHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/userStatsHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
