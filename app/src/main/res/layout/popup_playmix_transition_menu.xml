<?xml version="1.0" encoding="utf-8"?>
<!--
    Menú ⋮ del conector de transición de PlayMix. Mismo estilo que el menú de Aria
    (panel redondeado, insignia de icono, título y subtítulo); acento de PlayMix.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aria_popup_menu"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/menuEditTransition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aria_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_playmix_popup_icon">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                app:tint="@color/playmix_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_semi_bold"
                android:text="Editar transición"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/menuEditSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/unageo_medium"
                android:text="Puntos, curva y EQ"
                android:textColor="@color/textTheme"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/menuCopyDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="@color/dividerOverlay" />

    <LinearLayout
        android:id="@+id/menuCopyTransition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aria_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_playmix_popup_icon">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_playmix"
                app:tint="@color/playmix_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_semi_bold"
                android:text="Copiar a otra PlayMix"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/unageo_medium"
                android:text="Usa esta mezcla en otro set"
                android:textColor="@color/textTheme"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
