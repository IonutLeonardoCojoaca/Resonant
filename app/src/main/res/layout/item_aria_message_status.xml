<?xml version="1.0" encoding="utf-8"?>
<!-- Aria trabajando: tarjeta de estado del agente (orbe animado + paso actual). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aria_thinking_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.example.resonant.ui.views.AriaAgentOrbView
            android:id="@+id/statusOrb"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.14"
                android:text="ARIA ESTÁ TRABAJANDO"
                android:textColor="@color/aria_accent_text"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/statusMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/unageo_medium"
                android:maxLines="2"
                android:textColor="@color/textEmphasisHigh"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
