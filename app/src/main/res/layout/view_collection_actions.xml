<?xml version="1.0" encoding="utf-8"?>
<!-- Acciones rápidas de una colección de canciones (historial, descargas): reproducir todo y aleatorio.
     El color de acento lo pone CollectionActions.bind(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayAll"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:fontFamily="@font/unageo_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Reproducir"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShuffle"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:fontFamily="@font/unageo_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Aleatorio"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@color/cardsTheme"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_random"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/white"
        app:strokeColor="@color/discTheme"
        app:strokeWidth="1dp" />
</LinearLayout>
