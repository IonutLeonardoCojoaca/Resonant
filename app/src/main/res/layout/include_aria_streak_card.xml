<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de racha en el chat de Aria (content.kind = "streak"). Estilo de ariaUserStatsCard. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ariaStreakCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_aria_glass_panel"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:visibility="gone">

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-90dp"
        android:alpha="0.3"
        android:background="@drawable/bg_aria_ai_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_streak_flame" />

            <TextView
                android:id="@+id/ariaStreakDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/unageo_bold"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/ariaStreakLongest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/unageo_medium"
                android:maxLines="1"
                android:textColor="@color/textTheme"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ariaStreakToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/ariaStreakProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressBackgroundTint="@color/discTheme"
            android:progressTint="@color/secondaryColorTheme" />

        <TextView
            android:id="@+id/ariaStreakFreezes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ariaStreakMilestone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
