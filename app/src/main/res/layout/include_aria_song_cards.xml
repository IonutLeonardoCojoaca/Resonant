<?xml version="1.0" encoding="utf-8"?>
<!-- Panel agrupado de canciones: una sola superficie con filas separadas por divisores
     (sin huecos entre tarjetas). Lo usan recomendaciones, vista previa de playlist y
     la desambiguación "elige una versión". -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ariaSongCardsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_aria_glass_panel"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/songCardsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/songCardsKindLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.14"
                android:text="CANCIONES RECOMENDADAS"
                android:textColor="@color/aria_accent_text"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/songCardsArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/songCardsCatalogCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/songCardsCountPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/songCardsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_aria_result_row"
        android:orientation="vertical"
        android:showDividers="middle" />

    <TextView
        android:id="@+id/songCardsMoreButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_keyboard_arrow_down"
        android:drawableTint="@color/textTheme"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="72dp"
        android:paddingEnd="16dp"
        android:textColor="@color/textTheme"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
