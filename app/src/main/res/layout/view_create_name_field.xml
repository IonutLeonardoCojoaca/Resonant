<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de nombre grande de las pantallas de creación (playlist / PlayMix): texto
     centrado, subrayado que toma el acento al enfocar, error + contador e ideas de nombre.
     Lo controla CreateNameField. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/createNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingVertical="6dp"
        android:textColor="@color/white"
        android:textColorHint="@color/textTheme"
        android:textSize="26sp"
        tools:hint="Ponle un nombre" />

    <View
        android:id="@+id/createNameUnderline"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:background="@color/discTheme" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/createNameError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/errorColor"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="El nombre es obligatorio"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/createNameCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            tools:text="0/30" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/unageo_bold"
        android:letterSpacing="0.14"
        android:text="IDEAS"
        android:textColor="@color/textTheme"
        android:textSize="10sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-24dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="24dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/createNameSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true" />
    </HorizontalScrollView>
</LinearLayout>
