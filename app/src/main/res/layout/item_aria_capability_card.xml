<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta informativa de capacidad de Aria (bienvenida). Al pulsarla se prepara su ejemplo en el composer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_aria_glass_panel"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="168dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:stateListAnimator="@animator/explore_quick_card_press">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/capabilityBadge"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/capabilityIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/capabilityTool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aria_genre_chip"
            android:fontFamily="@font/unageo_bold"
            android:letterSpacing="0.08"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/textSecondaryAlpha"
            android:textSize="8.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/capabilityTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/unageo_bold"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/capabilityDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/unageo_regular"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:textColor="@color/textTheme"
        android:textSize="11.5sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/capabilityExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/unageo_medium_italic"
        android:maxLines="2"
        android:textColor="@color/aria_accent_text"
        android:textSize="11sp" />
</LinearLayout>
