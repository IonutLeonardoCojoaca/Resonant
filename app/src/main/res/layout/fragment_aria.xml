<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ariaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/primaryColorTheme">

    <!-- ─────────────────────────────────────────────────────────────────
         CAPA 0 — fondo ambiental (auroras, ondas y rejilla con parallax)
    ────────────────────────────────────────────────────────────────── -->
    <com.example.resonant.ui.views.AriaAmbientView
        android:id="@+id/ariaAmbient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ─────────────────────────────────────────────────────────────────
         BIENVENIDA
    ────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ariaWelcomeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar"
        app:layout_constraintBottom_toTopOf="@id/ariaInputContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp">

            <!-- Tarjeta de marca: motivo de conversación (capa con parallax propio) -->
            <FrameLayout
                android:id="@+id/ariaHeroCard"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:background="@drawable/bg_explore_quick_card"
                android:clipToOutline="true">

                <View
                    android:id="@+id/ariaHeroGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <com.example.resonant.ui.views.AriaConversationMotifView
                    android:id="@+id/ariaHeroMotif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp" />

                <LinearLayout
                    android:id="@+id/ariaHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_aria_genre_chip"
                    android:backgroundTint="#33FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <View
                        android:id="@+id/ariaHeroLiveDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_aria_live_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/unageo_bold"
                        android:letterSpacing="0.12"
                        android:text="AGENTE MUSICAL · IA"
                        android:textColor="#E6FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/ariaGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:textColor="@color/aria_accent_text"
                android:textSize="10sp"
                android:text="Hola" />

            <TextView
                android:id="@+id/ariaTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="¿Qué te gustaría escuchar?"
                android:textColor="@color/white"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/ariaWelcomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_medium"
                android:lineSpacingExtra="2dp"
                android:text="Soy tu agente musical: busco en el catálogo, creo playlists, analizo lo que escuchas y controlo la reproducción por ti."
                android:textColor="@color/textTheme"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/ariaCapabilitiesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.16"
                android:text="LO QUE PUEDO HACER"
                android:textColor="@color/textTheme"
                android:textSize="10sp" />

            <!-- Tarjetas informativas de capacidades: sangran hasta el borde de la pantalla -->
            <HorizontalScrollView
                android:id="@+id/ariaCapabilitiesScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ariaCapabilitiesRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/ariaPromptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.16"
                android:text="PRUEBA A PEDIRME"
                android:textColor="@color/textTheme"
                android:textSize="10sp" />

            <!-- Sugerencias en cuadrícula 2×2 -->
            <LinearLayout
                android:id="@+id/ariaPromptRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ariaPromptChip1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_aria_glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="104dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:stateListAnimator="@animator/explore_quick_card_press">

                        <FrameLayout
                            android:id="@+id/ariaPromptBadge1"
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <ImageView
                                android:id="@+id/ariaPromptIcon1"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_star_ai" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/unageo_bold"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="Música relajante para desconectar"
                            android:textColor="@color/white"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ariaPromptChip2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_aria_glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="104dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:stateListAnimator="@animator/explore_quick_card_press">

                        <FrameLayout
                            android:id="@+id/ariaPromptBadge2"
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <ImageView
                                android:id="@+id/ariaPromptIcon2"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_playlist_stack" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/unageo_bold"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="Playlist para entrenar"
                            android:textColor="@color/white"
                            android:textSize="13.5sp" />
                    </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ariaPromptRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ariaPromptChip3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_aria_glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="104dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:stateListAnimator="@animator/explore_quick_card_press">

                        <FrameLayout
                            android:id="@+id/ariaPromptBadge3"
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <ImageView
                                android:id="@+id/ariaPromptIcon3"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_trending_up" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/unageo_bold"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="Mis canciones más escuchadas"
                            android:textColor="@color/white"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ariaPromptChip4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_aria_glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="104dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:stateListAnimator="@animator/explore_quick_card_press">

                        <FrameLayout
                            android:id="@+id/ariaPromptBadge4"
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <ImageView
                                android:id="@+id/ariaPromptIcon4"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_artist_person" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/unageo_bold"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="Descubre artistas nuevos"
                            android:textColor="@color/white"
                            android:textSize="13.5sp" />
                    </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─────────────────────────────────────────────────────────────────
         CHAT — ocupa toda la pantalla; el contenido pasa por debajo de la
         toolbar y del composer (los paddings se calculan en código).
    ────────────────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ariaChatRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="64dp"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/ariaChatTopFade"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_aria_chat_top_fade"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ─────────────────────────────────────────────────────────────────
         TOOLBAR — presencia del agente
    ────────────────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/superiorToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/userProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircularUserImage" />

        <com.example.resonant.ui.views.AriaAgentOrbView
            android:id="@+id/ariaToolbarOrb"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/userProfile"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/toolbarTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ariaToolbarOrb"
            app:layout_constraintEnd_toStartOf="@id/ariaOptionsButton"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:text="Aria"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ariaStatusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_aria_live_dot" />

                <TextView
                    android:id="@+id/tvToolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_medium"
                    android:maxLines="1"
                    android:text="En línea · Agente musical"
                    android:textColor="@color/textTheme"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/ariaOptionsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_aria_toolbar_options"
            android:contentDescription="Opciones de Aria"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_ai"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ─────────────────────────────────────────────────────────────────
         COMPOSER — píldora con anillo degradado (se intensifica al enfocar)
    ────────────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ariaInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aria_fade_bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="22dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ConstraintLayout (no FrameLayout): el anillo a 0dp sigue al composer sin
             dictar el alto; un match_parent aquí estiraba el contenedor a toda la pantalla. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ariaComposerFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/ariaComposerRing"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.35"
                android:background="@drawable/bg_aria_composer_ring"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/ariaComposer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="1.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/bg_aria_composer"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="5dp">

                <EditText
                    android:id="@+id/ariaInputField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:hint="Pide algo a Aria…"
                    android:textColorHint="@color/textTheme"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/unageo_regular"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="1"
                    android:importantForAutofill="no"
                    android:autofillHints=""
                    tools:ignore="Autofill,LabelFor" />

                <ImageButton
                    android:id="@+id/ariaMicButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_aria_mic_button"
                    android:src="@drawable/ic_mic"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/white"
                    android:contentDescription="Entrada de voz" />

                <ImageButton
                    android:id="@+id/ariaSendButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_aria_send_button"
                    android:src="@drawable/ic_send"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    app:tint="@android:color/white"
                    android:contentDescription="Enviar mensaje" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- ─────────────────────────────────────────────────────────────────
         VOICE MODE OVERLAY
    ────────────────────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/ariaVoiceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aria_voice_overlay"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ariaVoiceCloseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_aria_toolbar_options"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="@color/white"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Cerrar entrada de voz" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_aria_prompt_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.15"
                android:text="ESCUCHANDO"
                android:textAllCaps="true"
                android:textColor="@color/secondaryColorTheme"
                android:textSize="11sp" />

            <com.example.resonant.ui.customviews.VoiceSpectrumSphereView
                android:id="@+id/ariaSpectrumView"
                android:layout_width="260dp"
                android:layout_height="260dp" />

            <TextView
                android:id="@+id/ariaVoiceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:fontFamily="@font/unageo_bold"
                android:text="Habla con Aria"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/unageo_regular"
                android:text="Pide canciones, artistas o playlists"
                android:textColor="@color/textTheme"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/ariaVoiceRecordButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_aria_voice_record_button"
                android:src="@drawable/ic_mic"
                android:scaleType="centerInside"
                android:padding="18dp"
                app:tint="@android:color/white"
                android:elevation="6dp"
                android:contentDescription="Detener grabación" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
