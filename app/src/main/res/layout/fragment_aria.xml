<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ariaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/primaryColorTheme">

    <!-- ─────────────────────────────────────────────────────────────────
         AMBIENT ORBS — subtle atmospheric glow layer
    ────────────────────────────────────────────────────────────────── -->
    <View
        android:id="@+id/ariaAmbientOrb1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.14"
        android:background="@drawable/bg_aria_ai_glow"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="-40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ariaAmbientOrb2"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:alpha="0.12"
        android:background="@drawable/bg_aria_ai_glow_purple"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ariaAmbientOrb3"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.10"
        android:background="@drawable/bg_aria_ai_glow"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="260dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ariaAmbientOrb4"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.12"
        android:background="@drawable/bg_aria_ai_glow_purple"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="-60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/ariaAmbientOrb5"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.08"
        android:background="@drawable/bg_aria_ai_glow"
        android:layout_marginBottom="-80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Optional compatibility views -->
    <View
        android:id="@+id/ariaGlowTop"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:alpha="0.0"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/ariaWelcomeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:visibility="gone"/>

    <!-- ─────────────────────────────────────────────────────────────────
         TOOLBAR
    ────────────────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/superiorToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/userProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircularUserImage" />

        <LinearLayout
            android:id="@+id/toolbarTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/userProfile"
            app:layout_constraintEnd_toStartOf="@id/ariaOptionsButton"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Aria"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_regular"
                android:text="Asistente musical con IA"
                android:textColor="@color/textTheme"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/ariaOptionsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_aria_toolbar_options"
            android:contentDescription="Opciones de Aria"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_ai"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ─────────────────────────────────────────────────────────────────
         WELCOME / CENTERED HERO STATE
    ────────────────────────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ariaWelcomeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar"
        app:layout_constraintBottom_toTopOf="@id/ariaInputContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Glowing Aria Badge / Icon -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_aria_hero_badge">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star_ai"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <!-- Main Title -->
            <TextView
                android:id="@+id/ariaTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/unageo_bold"
                android:gravity="center"
                android:text="¿Qué te gustaría escuchar?"
                android:textColor="@color/white"
                android:textSize="23sp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/ariaWelcomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="@font/unageo_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="Pídeme playlists por mood, recomendaciones según tus gustos o mezclas en lenguaje natural."
                android:textColor="@color/textTheme"
                android:textSize="13sp" />

            <!-- Section label: prompt suggestions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.12"
                android:text="SUGERENCIAS RÁPIDAS"
                android:textAllCaps="true"
                android:textColor="@color/textTheme"
                android:textSize="11sp" />

            <!-- Realistic Suggestion Chips List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <!-- Chip 1: Mood chill -->
                <LinearLayout
                    android:id="@+id/ariaPromptChip1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_aria_prompt_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_star_ai"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="Recomiéndame música relajante para desconectar"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Chip 2: Workout playlist -->
                <LinearLayout
                    android:id="@+id/ariaPromptChip2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_aria_prompt_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_playlist_stack"
                        app:tint="@color/secondaryColorTheme"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="Crea una playlist energética para entrenar"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Chip 3: Stats / Top songs -->
                <LinearLayout
                    android:id="@+id/ariaPromptChip3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_aria_prompt_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_trending_up"
                        app:tint="#FA8231"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="¿Cuáles son mis canciones y artistas más escuchados?"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Chip 4: Emerging artists -->
                <LinearLayout
                    android:id="@+id/ariaPromptChip4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_aria_prompt_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_artist_person"
                        app:tint="@color/white"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="Descubre artistas emergentes basados en mi gusto"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Chip 5: DJ mix session -->
                <LinearLayout
                    android:id="@+id/ariaPromptChip5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_aria_prompt_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_random"
                        app:tint="@color/white"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="Prepara una sesión DJ continua con mis favoritos"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ─────────────────────────────────────────────────────────────────
         CHAT LIST (Visible during active conversation)
    ────────────────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ariaChatRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar"
        app:layout_constraintBottom_toTopOf="@id/ariaInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/ariaChatTopFade"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_aria_chat_top_fade"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ─────────────────────────────────────────────────────────────────
         INPUT BAR
    ────────────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ariaInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/ariaInputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_aria_input"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:hint="Pregunta a Aria..."
            android:textColorHint="@color/textTheme"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/unageo_regular"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="1"
            android:importantForAutofill="no"
            android:autofillHints=""
            tools:ignore="Autofill,LabelFor" />

        <ImageButton
            android:id="@+id/ariaMicButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_aria_mic_button"
            android:src="@drawable/ic_mic"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/white"
            android:contentDescription="Entrada de voz" />

        <ImageButton
            android:id="@+id/ariaSendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_aria_send_button"
            android:src="@drawable/ic_send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@android:color/white"
            android:contentDescription="Enviar mensaje" />

    </LinearLayout>

    <!-- ─────────────────────────────────────────────────────────────────
         VOICE MODE OVERLAY
    ────────────────────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/ariaVoiceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aria_voice_overlay"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ariaVoiceCloseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_aria_toolbar_options"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="@color/white"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Cerrar entrada de voz" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_aria_prompt_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.15"
                android:text="ESCUCHANDO"
                android:textAllCaps="true"
                android:textColor="@color/secondaryColorTheme"
                android:textSize="11sp" />

            <com.example.resonant.ui.customviews.VoiceSpectrumSphereView
                android:id="@+id/ariaSpectrumView"
                android:layout_width="260dp"
                android:layout_height="260dp" />

            <TextView
                android:id="@+id/ariaVoiceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:fontFamily="@font/unageo_bold"
                android:text="Habla con Aria"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/unageo_regular"
                android:text="Pide canciones, artistas o playlists"
                android:textColor="@color/textTheme"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/ariaVoiceRecordButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_aria_voice_record_button"
                android:src="@drawable/ic_mic"
                android:scaleType="centerInside"
                android:padding="18dp"
                app:tint="@android:color/white"
                android:elevation="6dp"
                android:contentDescription="Detener grabación" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
