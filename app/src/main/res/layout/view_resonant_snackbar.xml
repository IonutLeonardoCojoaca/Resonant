<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del snackbar de Resonant. Se infla dentro del SnackbarLayout de
     Material (ver utils/ResonantSnackbar.kt), que aporta anclaje, cola y swipe. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/snackIconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/snackIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_success" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/snackProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="22dp"
                app:trackCornerRadius="2dp"
                app:trackThickness="2.5dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/snackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_semi_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/snackbar_title"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Transición guardada"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/snackMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="@color/snackbar_title"
                android:textSize="13.5sp"
                tools:text="Track A → Track B · 8 compases" />
        </LinearLayout>

        <TextView
            android:id="@+id/snackAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/unageo_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Deshacer"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Indicador de tiempo restante: se encoge de izquierda a derecha. -->
    <View
        android:id="@+id/snackTimer"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="5dp"
        android:importantForAccessibility="no" />
</FrameLayout>
