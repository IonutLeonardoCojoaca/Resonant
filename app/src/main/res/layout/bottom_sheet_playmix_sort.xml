<?xml version="1.0" encoding="utf-8"?>
<!-- Ordenar una PlayMix por criterio (playmix-sharing-discovery): criterio, dirección, vista previa y "Aplicar". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/unageo_semi_bold"
        android:text="Ordenar por"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortCriterionGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:theme="@style/Theme.MaterialComponents.Light"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sortDirectionGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:theme="@style/Theme.MaterialComponents.Light"
        app:chipSpacingHorizontal="6dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/sortPreviewLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/unageo_medium"
        android:text="Vista previa"
        android:textColor="@color/textTheme"
        android:textSize="12sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/sortPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_regular"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/white"
            android:textSize="13.5sp" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sortApplyButton"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:fontFamily="@font/unageo_semi_bold"
        android:text="Aplicar"
        android:textAllCaps="false"
        app:backgroundTint="@color/playmix_accent"
        app:cornerRadius="24dp" />
</LinearLayout>
