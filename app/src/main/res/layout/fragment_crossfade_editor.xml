<?xml version="1.0" encoding="utf-8"?>
<!--
    Editor de transiciones de PlayMix. Capas, de atrás adelante:
      1. backdrop: portadas de A y B desenfocadas (parallax al hacer scroll) fundidas con el fondo.
      2. editorScroll: cabecera A → B (BPM y Camelot), modo (motor antiguo), escenario con la mezcla, compases
         bajo la ventana, estilos y, con el motor v2, ajuste fino por carriles y beatmatching.
      3. topBar: atrás, título (aparece al hacer scroll) y Guardar.
      4. statusCapsule: guardando / renderizando / lista. Encima, el cargador y el error de carga.
    Lo controla CrossfadeEditorFragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.CrossfadeEditorFragment">

    <!-- ═══ Capa 1: fondo ambiental con las portadas ═══ -->
    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/backdropArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backdropCoverA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/backdropCoverB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mx_scrim" />
    </FrameLayout>

    <!-- ═══ Capa 2: contenido ═══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/editorScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/editorContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="200dp">

            <!-- ─── Cabecera: A → B ─── -->
            <LinearLayout
                android:id="@+id/heroPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp">

                <LinearLayout
                    android:id="@+id/songACard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:clipChildren="false">

                        <FrameLayout
                            android:id="@+id/songACoverFrame"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_mx_cover"
                            android:elevation="14dp"
                            android:outlineSpotShadowColor="@color/playmix_accent">

                            <ImageView
                                android:id="@+id/songACover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Portada de la canción A"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_disc" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/songABadge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_mx_side_badge"
                            android:backgroundTint="@color/playmix_accent"
                            android:elevation="16dp"
                            android:fontFamily="@font/unageo_bold"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="A"
                            android:textColor="#1A0F0C"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/songATitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:text="Summertime" />

                    <TextView
                        android:id="@+id/songAArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/textTheme"
                        android:textSize="12sp"
                        tools:text="Artista" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/songABpm"
                            style="@style/MxTag"
                            tools:text="128 BPM" />

                        <TextView
                            android:id="@+id/songAKey"
                            style="@style/MxTag"
                            android:layout_marginStart="6dp"
                            tools:text="8A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Conector: cómo casan tempo y tonalidad -->
                <LinearLayout
                    android:id="@+id/heroConnector"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="31dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="34dp">

                        <View
                            android:id="@+id/heroConnectorLine"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center_vertical"
                            android:alpha="0.7"
                            android:background="@drawable/bg_mx_connector" />

                        <FrameLayout
                            android:id="@+id/heroConnectorHub"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_mx_connector_hub"
                            android:elevation="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_compare_arrows"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/heroTempoMatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/unageo_bold"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        tools:text="± 1,6 %" />

                    <TextView
                        android:id="@+id/heroKeyMatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/unageo_medium"
                        android:gravity="center"
                        android:textColor="@color/textTheme"
                        android:textSize="9.5sp"
                        tools:text="Armónica" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/songBCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:clipChildren="false">

                        <FrameLayout
                            android:id="@+id/songBCoverFrame"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_mx_cover"
                            android:elevation="14dp"
                            android:outlineSpotShadowColor="@color/playmix_accent_end">

                            <ImageView
                                android:id="@+id/songBCover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Portada de la canción B"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_disc" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/songBBadge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_mx_side_badge"
                            android:backgroundTint="@color/playmix_accent_end"
                            android:elevation="16dp"
                            android:fontFamily="@font/unageo_bold"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="B"
                            android:textColor="#1A0F0C"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/songBTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:text="Always Be My Fault" />

                    <TextView
                        android:id="@+id/songBArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/textTheme"
                        android:textSize="12sp"
                        tools:text="Artista" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/songBBpm"
                            style="@style/MxTag"
                            tools:text="126 BPM" />

                        <TextView
                            android:id="@+id/songBKey"
                            style="@style/MxTag"
                            android:layout_marginStart="6dp"
                            tools:text="9A" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Modo (motor antiguo): automático o avanzado ─── -->
            <include
                android:id="@+id/playmixModePanel"
                layout="@layout/view_playmix_mode_panel" />

            <!-- ─── Escenario: la mezcla ─── -->
            <LinearLayout
                android:id="@+id/stageSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/MxEyebrow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="LA MEZCLA" />

                    <LinearLayout
                        android:id="@+id/stageStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_mx_tag"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:id="@+id/stageStatusDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_lane_dot" />

                        <TextView
                            android:id="@+id/stageStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/unageo_semi_bold"
                            android:textColor="@color/white"
                            android:textSize="10.5sp"
                            tools:text="Renderizada" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/stageHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:text="Arrastra cada canción para mover su punto · se ajusta al compás"
                    android:textColor="@color/textTheme"
                    android:textSize="11.5sp" />

                <FrameLayout
                    android:id="@+id/stageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_mx_stage"
                    android:elevation="8dp"
                    android:outlineSpotShadowColor="@color/playmix_accent_end"
                    android:padding="8dp">

                    <FrameLayout
                        android:id="@+id/waveformContainer"
                        android:layout_width="match_parent"
                        android:layout_height="300dp">

                        <com.example.resonant.ui.views.WaveformView
                            android:id="@+id/waveformView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.example.resonant.ui.views.MixEditorView
                            android:id="@+id/mixEditorView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp">

                            <View
                                android:id="@+id/previewPulseRing"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:alpha="0"
                                android:background="@drawable/bg_mx_play_ring" />

                            <ImageButton
                                android:id="@+id/previewToggleButton"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_mx_play_button"
                                android:contentDescription="Escuchar la transición"
                                android:elevation="6dp"
                                android:padding="15dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                app:tint="@color/mx_on_stage" />
                        </FrameLayout>
                    </FrameLayout>
                </FrameLayout>

                <!-- Compases justo bajo la ventana de mezcla (centrada en el escenario), con salida y entrada a los lados -->
                <LinearLayout
                    android:id="@+id/stageControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MxEyebrow"
                            android:layout_width="wrap_content"
                            android:text="SALIDA · A"
                            android:textColor="@color/playmix_accent"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/exitPointLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/unageo_bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            tools:text="2:31.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/windowEarlierButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_mx_icon_button"
                            android:contentDescription="Mover la mezcla un compás antes"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chevron_left_mini"
                            android:visibility="gone"
                            app:tint="@color/white"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/measureDropdownButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_mx_pill_outline"
                            android:drawableEnd="@drawable/ic_keyboard_arrow_down"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/textTheme"
                            android:fontFamily="@font/unageo_bold"
                            android:gravity="center"
                            android:minWidth="118dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:text="8 compases" />

                        <ImageButton
                            android:id="@+id/windowLaterButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_mx_icon_button"
                            android:contentDescription="Mover la mezcla un compás después"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chevron_right_mini"
                            android:visibility="gone"
                            app:tint="@color/white"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MxEyebrow"
                            android:layout_width="wrap_content"
                            android:text="ENTRADA · B"
                            android:textColor="@color/playmix_accent_end"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/entryPointLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/unageo_bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            tools:text="0:16.0" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/crossfadeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center"
                    android:textColor="@color/textTheme"
                    android:textSize="11.5sp"
                    tools:text="Cruce de 15,2 s · 32 beats a 126 BPM" />
            </LinearLayout>

            <!-- ─── Estilo de la transición ─── -->
            <LinearLayout
                android:id="@+id/styleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    style="@style/MxEyebrow"
                    android:layout_marginHorizontal="16dp"
                    android:text="ESTILO" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="¿Cómo quieres que suene el cambio?"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <HorizontalScrollView
                        android:id="@+id/styleScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/styleChipsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="2dp" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/styleSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="96dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_mx_skeleton" />

                        <View
                            android:layout_width="84dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_mx_skeleton" />

                        <View
                            android:layout_width="104dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_mx_skeleton" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_mx_skeleton" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/styleErrorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mx_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/unageo_medium"
                        android:text="No se pudieron cargar los estilos"
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/styleRetryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_mx_save_button"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Reintentar"
                        android:textColor="@color/mx_on_stage"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/styleDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/unageo_medium"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/textTheme"
                    android:textSize="12.5sp"
                    tools:text="La intro de la segunda canción entra bajo el final de la primera." />
            </LinearLayout>

            <!-- ─── Motor v2: ajuste fino por carriles y beatmatching ─── -->
            <include
                android:id="@+id/mixV2Controls"
                layout="@layout/view_mix_v2_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══ Capa 3: barra superior ═══ -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <View
            android:id="@+id/topBarBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/primaryColorTheme"
            android:elevation="0dp" />

        <ImageButton
            android:id="@+id/arrowGoBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_mx_icon_button"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:alpha="0"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="120dp"
            android:text="Transición"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/topSaveButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_mx_save_button"
            android:contentDescription="Guardar la transición"
            android:minWidth="96dp"
            android:paddingHorizontal="18dp">

            <TextView
                android:id="@+id/topSaveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/unageo_bold"
                android:text="Guardar"
                android:textColor="@color/mx_on_stage"
                android:textSize="13.5sp" />

            <ProgressBar
                android:id="@+id/topSaveProgress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/mx_on_stage"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- ═══ Capa 4: cápsula de estado (guardando / renderizando / lista) ═══ -->
    <LinearLayout
        android:id="@+id/statusCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_mx_capsule"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <com.example.resonant.ui.views.MixPulseView
                android:id="@+id/statusPulse"
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/statusCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mx_check"
                android:visibility="gone"
                app:tint="#7CF2B0" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:textColor="@color/mx_on_stage"
                android:textSize="13sp"
                tools:text="Renderizando la mezcla" />

            <TextView
                android:id="@+id/statusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/mx_on_stage_dim"
                android:textSize="11sp"
                tools:text="Mientras tanto suena en directo" />
        </LinearLayout>
    </LinearLayout>

    <!-- Carga inicial -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLoader"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        app:lottie_autoPlay="false"
        app:lottie_enableMergePathsForKitKatAndAbove="true"
        app:lottie_fileName="loader.json"
        app:lottie_loop="true"
        app:lottie_repeatCount="-1" />

    <!-- Error de carga con reintento -->
    <LinearLayout
        android:id="@+id/loadErrorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_playmix"
            app:tint="@color/playmix_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:text="No se pudo cargar la transición"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/loadErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/unageo_medium"
            android:gravity="center"
            android:text="Comprueba la conexión e inténtalo de nuevo."
            android:textColor="@color/textTheme"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/loadRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_mx_save_button"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Reintentar"
            android:textColor="@color/mx_on_stage"
            android:textSize="13.5sp" />
    </LinearLayout>

</FrameLayout>
