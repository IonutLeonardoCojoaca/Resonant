<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Playmix info header -->
    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/playmixImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            app:shapeAppearanceOverlay="@style/RoundedCornersImage"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/playmixData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/playmixImage"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playmixName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/white"
                android:fontFamily="@font/unageo_bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/playmixInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/subtitleBottomSheet"
                android:fontFamily="@font/unageo_medium"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/playmixDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/textBottomSheet"
                android:fontFamily="@font/unageo_regular"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Separator -->
    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerOverlay"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="12dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator">

        <!-- Play all -->
        <TextView
            style="@style/OptionRow"
            android:id="@+id/playAllButton"
            android:drawableStart="@drawable/ic_play"
            android:text="Reproducir PlayMix" />

        <!-- Cola: la Playmix entera como un bloque, con sus mezclas -->
        <TextView
            style="@style/OptionRow"
            android:id="@+id/playNextButton"
            android:drawableStart="@drawable/ic_play_next_compact"
            android:text="Reproducir a continuación"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/addToQueueButton"
            android:drawableStart="@drawable/ic_queue_add"
            android:text="Añadir a la cola"
            android:visibility="gone" />

        <!-- Descarga sin conexión -->
        <TextView
            style="@style/OptionRow"
            android:id="@+id/downloadPlaymixButton"
            android:drawableStart="@drawable/ic_download"
            android:text="Descargar"
            android:visibility="gone" />

        <!-- Compartir y descubrir (playmix-sharing-discovery); sin callback, ocultas -->
        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixLikeOptionButton"
            android:drawableStart="@drawable/ic_favorite_border"
            android:text="Me gusta"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixShareOptionButton"
            android:drawableStart="@drawable/ic_share"
            android:text="Compartir"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixVisibilityOptionButton"
            android:drawableStart="@drawable/ic_public"
            android:text="Visibilidad"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixDuplicateOptionButton"
            android:drawableStart="@drawable/ic_unisound_copy"
            android:text="Duplicar"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixSortOptionButton"
            android:drawableStart="@drawable/ic_queue_list"
            android:text="Ordenar por…"
            android:visibility="gone" />

        <TextView
            style="@style/OptionRow"
            android:id="@+id/playmixMergeOptionButton"
            android:drawableStart="@drawable/ic_playmix"
            android:text="Fusionar con…"
            android:visibility="gone" />

        <!-- Edit name -->
        <TextView
            style="@style/OptionRow"
            android:id="@+id/editNameButton"
            android:drawableStart="@drawable/ic_edit"
            android:text="Editar nombre" />

        <!-- Delete playmix -->
        <TextView
            style="@style/OptionRow.Destructive"
            android:id="@+id/deletePlaymixButton"
            android:drawableStart="@drawable/ic_delete"
            android:text="Eliminar PlayMix" />

        <!-- Cancel -->
        <TextView
            style="@style/OptionRow.Muted"
            android:id="@+id/cancelButton"
            android:drawableStart="@drawable/ic_cancel"
            android:text="Cancelar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
