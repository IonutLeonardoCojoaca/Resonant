<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.CreatePlaymixFragment">

    <LinearLayout
        android:id="@+id/superiorToolbar"
        style="@style/TopBar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="Nuevo PlayMix" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/superiorToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- Portada de vista previa: muestra el nombre en directo -->
            <FrameLayout
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_marginTop="4dp">

                <include
                    android:id="@+id/coverPreview"
                    layout="@layout/view_explore_quick_card"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:scaleX="1.3"
                    android:scaleY="1.3" />
            </FrameLayout>

            <include
                android:id="@+id/nameField"
                layout="@layout/view_create_name_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp" />

            <!-- Visibilidad al crear (playmix-sharing-discovery); oculta con la capacidad apagada. Por defecto, privada. -->
            <LinearLayout
                android:id="@+id/visibilitySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Quién puede verla"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/visibilityChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:theme="@style/Theme.MaterialComponents.Light"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/visibilityPrivateChip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="Privada"
                    android:textColor="@color/chip_text_color_selector"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="35dp"
                    app:chipStrokeColor="@android:color/transparent"
                    app:fontFamily="@font/unageo_medium"
                    app:rippleColor="@android:color/transparent"
                    app:useMaterialThemeColors="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/visibilityUnlistedChip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:checkable="true"
                    android:text="Con enlace"
                    android:textColor="@color/chip_text_color_selector"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="35dp"
                    app:chipStrokeColor="@android:color/transparent"
                    app:fontFamily="@font/unageo_medium"
                    app:rippleColor="@android:color/transparent"
                    app:useMaterialThemeColors="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/visibilityPublicChip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:checkable="true"
                    android:text="Pública"
                    android:textColor="@color/chip_text_color_selector"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="35dp"
                    app:chipStrokeColor="@android:color/transparent"
                    app:fontFamily="@font/unageo_medium"
                    app:rippleColor="@android:color/transparent"
                    app:useMaterialThemeColors="false" />

                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Cómo funciona un PlayMix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_surface_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Cómo funciona"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <include
                    android:id="@+id/step1"
                    layout="@layout/view_create_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/step2"
                    layout="@layout/view_create_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/step3"
                    layout="@layout/view_create_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createPlaymixButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Crear PlayMix"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
