<?xml version="1.0" encoding="utf-8"?>
<!-- Widget compacto (2x1): portada y play/pausa. Solo vistas válidas en RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_resonant"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding">

    <ImageView
        android:id="@+id/widgetCover"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_disc" />

    <ImageButton
        android:id="@+id/widgetPlayPause"
        android:layout_width="@dimen/widget_play_size"
        android:layout_height="@dimen/widget_play_size"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_play"
        android:contentDescription="@string/widget_play"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <TextView
        android:id="@+id/widgetOpenButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_pill"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
