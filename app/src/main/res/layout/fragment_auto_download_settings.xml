<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical"
    tools:context=".ui.fragments.AutoDownloadSettingsFragment">

    <!-- Barra fija fuera del scroll -->
    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/autoDownloadBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="@string/auto_download_settings_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="@dimen/screen_bottom_inset">

        <TextView
            android:id="@+id/autoDownloadDisabledText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_disabled"
            android:textColor="@color/textTheme"
            android:visibility="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/autoDownloadPauseSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_pause"
            android:textColor="@color/white"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_pause_hint"
            android:textColor="@color/textTheme"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/autoDownloadWifiSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_wifi_only"
            android:textColor="@color/white"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/autoDownloadChargingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_charging_only"
            android:textColor="@color/white"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />

        <TextView
            android:id="@+id/autoDownloadQuotaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/white"
            tools:text="Espacio máximo: 2048 MB" />

        <com.google.android.material.slider.Slider
            android:id="@+id/autoDownloadQuotaSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="256"
            android:valueFrom="256"
            android:valueTo="8192"
            android:value="2048" />

        <TextView
            android:id="@+id/autoDownloadUsedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            tools:text="340 MB usados de 2,0 GB" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/autoDownloadUsedProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/autoDownloadKeepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/white"
            tools:text="Conservar: siempre" />

        <com.google.android.material.slider.Slider
            android:id="@+id/autoDownloadKeepSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="90"
            android:value="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/unageo_bold"
            android:text="@string/auto_download_subscriptions"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/autoDownloadNoSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_no_subscriptions"
            android:textColor="@color/textTheme"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/autoDownloadSubscriptionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/unageo_bold"
            android:text="@string/auto_download_recent_plans"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/autoDownloadNoPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/auto_download_no_plans"
            android:textColor="@color/textTheme"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/autoDownloadPlansList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
