<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Brillo ambiental de Aria (decorativo, se desenfoca en código) -->
    <ImageView
        android:id="@+id/ariaInfoGlowBg"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:alpha="0.75"
        android:background="@drawable/bg_circle_aria_gradient"
        android:importantForAccessibility="no"
        android:translationX="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/superiorToolbar"
        style="@style/TopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back" />

        <TextView
            style="@style/TopBar.Title"
            android:text="Qué puede hacer Aria" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/screen_bottom_inset_compact"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
