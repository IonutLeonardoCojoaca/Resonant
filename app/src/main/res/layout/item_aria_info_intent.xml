<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_aria_suggestion_chip"
    android:layout_marginHorizontal="16dp">

    <TextView
        android:id="@+id/intentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="crear_playlist"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/unageo_medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/intentDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description of the intent here."
        android:textColor="#BBBBBB"
        android:textSize="13sp"
        android:fontFamily="@font/unageo_regular"
        android:lineSpacingMultiplier="1.2" />

</LinearLayout>
