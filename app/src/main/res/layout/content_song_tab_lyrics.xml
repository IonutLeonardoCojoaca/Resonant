<?xml version="1.0" encoding="utf-8"?>
<!-- "Lyrics" tab content for fragment_song.xml. Same view ids as the old
     lyricsCard body (SongFragment.kt's lyrics-loading/sync logic is unchanged,
     only re-hosted here) minus the "LETRA" header row, which the TabLayout
     label already covers. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lyricsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingTop="96dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/lyricsTopFade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_lyrics_fade_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/lyricsBottomFade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_lyrics_fade_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/expandLyricsButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_expand"
        app:tint="@color/textSecondaryAlpha"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/lyricsLoadingIndicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminateTint="@color/secondaryColorTheme"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/noLyricsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="No hay letra disponible"
        android:textColor="@color/textTertiaryAlpha"
        android:textSize="13sp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
