<?xml version="1.0" encoding="utf-8"?>
<!--
    Ajustes (redesign-settings): secciones con tarjetas. Las filas son includes de
    item_settings_switch_row / item_settings_nav_row / item_settings_choice; iconos y textos
    los pone SettingsFragment. Las filas que dependen de una capacidad del servidor empiezan ocultas.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.fragments.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="15dp"
        android:paddingBottom="120dp">

        <TextView
            android:id="@+id/title_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:fontFamily="@font/unageo_semi_bold"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <!-- ─── Reproducción ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_playback" />

        <LinearLayout style="@style/SettingsSectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_transition_title" />

                <TextView
                    style="@style/SettingsRowSubtitle"
                    android:text="@string/settings_transition_subtitle" />

                <include
                    android:id="@+id/transition_auto"
                    layout="@layout/item_settings_choice" />

                <include
                    android:id="@+id/transition_fade"
                    layout="@layout/item_settings_choice" />

                <LinearLayout
                    android:id="@+id/fade_duration_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/settings_fade_duration" />

                        <TextView
                            android:id="@+id/fade_duration_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_semi_bold"
                            android:textColor="@color/secondaryColorTheme"
                            android:textSize="13sp"
                            tools:text="6 s" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/fade_duration_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1.0"
                        android:value="6.0"
                        android:valueFrom="1.0"
                        android:valueTo="12.0" />
                </LinearLayout>

                <include
                    android:id="@+id/transition_cut"
                    layout="@layout/item_settings_choice" />
            </LinearLayout>

            <View style="@style/SettingsDivider" android:layout_marginStart="14dp" />

            <include
                android:id="@+id/row_album_gapless"
                layout="@layout/item_settings_switch_row" />
        </LinearLayout>

        <!-- ─── Al terminar tu cola (Flow) ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_queue_end" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_flow"
                layout="@layout/item_settings_switch_row" />

            <!-- Nivel de descubrimiento: solo con la capacidad flowV2. -->
            <LinearLayout
                android:id="@+id/flow_discovery_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/flow_discovery_selector"
                    layout="@layout/view_chart_period_selector"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="14dp" />

                <TextView
                    android:id="@+id/flow_discovery_hint"
                    style="@style/SettingsRowSubtitle"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    tools:text="Tus favoritos con alguna novedad entre medias" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Sonido ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_sound" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_normalization"
                layout="@layout/item_settings_switch_row" />

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_equalizer"
                layout="@layout/item_settings_nav_row" />

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_quality"
                layout="@layout/item_settings_nav_row" />
        </LinearLayout>

        <!-- ─── Descargas y almacenamiento ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_storage" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_downloads"
                layout="@layout/item_settings_nav_row" />

            <LinearLayout
                android:id="@+id/auto_downloads_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View style="@style/SettingsDivider" />

                <include
                    android:id="@+id/row_auto_downloads"
                    layout="@layout/item_settings_nav_row" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_cache"
                layout="@layout/item_settings_nav_row" />
        </LinearLayout>

        <!-- ─── Aria ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_aria" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_aria_floating"
                layout="@layout/item_settings_switch_row" />

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_aria_wake_word"
                layout="@layout/item_settings_switch_row" />

            <!-- Aria DJ en Live (add-aria-dj): solo con la capacidad ariaDj. -->
            <LinearLayout
                android:id="@+id/live_dj_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View style="@style/SettingsDivider" />

                <include
                    android:id="@+id/row_live_dj"
                    layout="@layout/item_settings_nav_row" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Notificaciones ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_notifications" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_streak_reminder"
                layout="@layout/item_settings_switch_row" />

            <!-- Bandeja de notificaciones (add-notifications): una categoría por interruptor, guardadas en
                 el servidor. Solo con la capacidad notifications y si GET /settings respondió. -->
            <LinearLayout
                android:id="@+id/notification_categories_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    style="@style/SettingsDivider"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="0dp" />

                <TextView
                    style="@style/SettingsRowSubtitle"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/notifications_settings_subtitle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_aria_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_aria" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_unisound_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_unisound" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_live_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_live" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_streak_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_streak" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_song_of_day_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_song_of_day" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notification_app_update_switch"
                    style="@style/SettingsCategorySwitch"
                    android:text="@string/notifications_settings_app_update" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_system_notifications"
                layout="@layout/item_settings_nav_row" />
        </LinearLayout>

        <!-- ─── Tu actividad ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_activity" />

        <LinearLayout style="@style/SettingsSectionCard">

            <!-- Estadísticas: solo con la capacidad listeningStats. -->
            <LinearLayout
                android:id="@+id/stats_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/row_stats"
                    layout="@layout/item_settings_nav_row" />

                <View style="@style/SettingsDivider" />
            </LinearLayout>

            <include
                android:id="@+id/row_history"
                layout="@layout/item_settings_nav_row" />

            <!-- Resumen mensual (add-monthly-recap): solo con la capacidad monthlyRecap. -->
            <LinearLayout
                android:id="@+id/recap_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View style="@style/SettingsDivider" />

                <include
                    android:id="@+id/row_recap"
                    layout="@layout/item_settings_nav_row" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Apariencia ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_appearance" />

        <LinearLayout
            android:id="@+id/theme_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/theme_dark_card"
                style="@style/SettingsThemeOption">

                <ImageView
                    style="@style/SettingsThemeIcon"
                    android:src="@drawable/ic_theme_dark" />

                <TextView
                    style="@style/SettingsThemeLabel"
                    android:text="@string/settings_theme_dark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_light_card"
                style="@style/SettingsThemeOption"
                android:layout_marginStart="10dp">

                <ImageView
                    style="@style/SettingsThemeIcon"
                    android:src="@drawable/ic_theme_light" />

                <TextView
                    style="@style/SettingsThemeLabel"
                    android:text="@string/settings_theme_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_system_card"
                style="@style/SettingsThemeOption"
                android:layout_marginStart="10dp">

                <ImageView
                    style="@style/SettingsThemeIcon"
                    android:src="@drawable/ic_phone_device" />

                <TextView
                    style="@style/SettingsThemeLabel"
                    android:text="@string/settings_theme_system" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Cuenta y app ─── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_account" />

        <LinearLayout style="@style/SettingsSectionCard">

            <include
                android:id="@+id/row_whats_new"
                layout="@layout/item_settings_nav_row" />

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_version"
                layout="@layout/item_settings_nav_row" />

            <View style="@style/SettingsDivider" />

            <include
                android:id="@+id/row_logout"
                layout="@layout/item_settings_nav_row" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
