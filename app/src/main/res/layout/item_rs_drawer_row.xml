<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del menú lateral: icono en su cuadradito (en degradado en la pantalla actual) y nombre.
     El id lo pone cada <include>; icono y texto los rellena DrawerMenu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_rs_drawer_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:id="@+id/drawerRowTile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_rs_icon_tile">

        <ImageView
            android:id="@+id/drawerRowIcon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/drawerRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_semi_bold"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="15sp" />
</LinearLayout>
