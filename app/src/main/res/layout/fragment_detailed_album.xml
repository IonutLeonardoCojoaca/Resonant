<?xml version="1.0" encoding="utf-8"?>
<!--
    Ficha de álbum: cabecera por capas con parallax (view_detail_hero), cifras en tarjetas de
    colores, curva de tempo del disco, lista de canciones, artistas y más del artista.
    Lo rellena DetailedAlbumFragment.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConstraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.DetailedAlbumFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:background="@color/primaryColorTheme"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="250"
            app:titleEnabled="false">

            <include
                android:id="@+id/hero"
                layout="@layout/view_detail_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/detailToolbar"
                layout="@layout/view_detail_toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- ═══ En cifras ═══ -->
            <LinearLayout
                android:id="@+id/statsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/DetailSectionLabel"
                    android:text="EN CIFRAS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statStreams"
                        layout="@layout/view_detail_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statDuration"
                        layout="@layout/view_detail_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statFavorites"
                        layout="@layout/view_detail_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statTracks"
                        layout="@layout/view_detail_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Curva de tempo del disco ═══ -->
            <LinearLayout
                android:id="@+id/tempoSection"
                style="@style/DetailTile"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tempoLabel"
                        style="@style/DetailTileLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="TEMPO A LO LARGO DEL DISCO" />

                    <TextView
                        android:id="@+id/tempoRange"
                        style="@style/DetailTileLabel"
                        android:textColor="@color/white"
                        tools:text="92–140 BPM" />
                </LinearLayout>

                <com.example.resonant.ui.views.PlaymixTempoFlowView
                    android:id="@+id/tempoFlow"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- ═══ Canciones ═══ -->
            <TextView
                android:id="@+id/tracksLabel"
                style="@style/DetailSectionLabel"
                android:layout_marginTop="26dp"
                android:text="CANCIONES"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-8dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

            <!-- ═══ Artistas ═══ -->
            <TextView
                android:id="@+id/artistText"
                style="@style/DetailSectionLabel"
                android:layout_marginTop="22dp"
                android:text="ARTISTAS" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artistList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-8dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

            <!-- ═══ Más del artista ═══ -->
            <TextView
                android:id="@+id/moreLabel"
                style="@style/DetailSectionLabel"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                tools:text="MÁS DE METRO BOOMIN"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moreAlbums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-16dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
