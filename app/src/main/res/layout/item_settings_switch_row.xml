<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de Ajustes con interruptor. Icono y textos los pone SettingsFragment; tocar la fila cambia el interruptor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/settingIcon"
        style="@style/SettingsRowIcon"
        tools:src="@drawable/ic_sound" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingTitle"
            style="@style/SettingsRowTitle"
            tools:text="Volumen equilibrado" />

        <TextView
            android:id="@+id/settingSubtitle"
            style="@style/SettingsRowSubtitle"
            tools:text="Iguala el volumen entre canciones" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/settingSwitch"
        android:layout_width="wrap_content"
        android:saveEnabled="false"
        android:layout_height="wrap_content"
        app:thumbTint="@color/switch_thumb_selector"
        app:trackTint="@color/switch_track_selector" />
</LinearLayout>
