<?xml version="1.0" encoding="utf-8"?>
<!-- Opción de un PlaymixDialog con lista: título, detalle opcional e indicador (radio o casilla) con el acento PlayMix. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_mx_dialog_choice"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mxChoiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_semi_bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Con enlace" />

        <TextView
            android:id="@+id/mxChoiceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_medium"
            android:maxLines="2"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Solo quien tenga el enlace"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/mxChoiceRadio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:saveEnabled="false"
        android:visibility="gone"
        app:buttonTint="@color/mx_choice_indicator" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/mxChoiceCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:saveEnabled="false"
        android:visibility="gone"
        app:buttonIconTint="@color/mx_on_stage"
        app:buttonTint="@color/mx_choice_indicator" />
</LinearLayout>
