<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/unisoundBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/unisoundTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/unageo_bold"
        android:text="Escuchar juntos"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@id/unisoundShareButton"
        app:layout_constraintStart_toEndOf="@id/unisoundBackButton"
        app:layout_constraintTop_toTopOf="@id/unisoundBackButton" />

    <TextView
        android:id="@+id/unisoundConnectionStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unageo_regular"
        android:textColor="@color/textTheme"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/unisoundTitle"
        app:layout_constraintStart_toStartOf="@id/unisoundTitle"
        app:layout_constraintTop_toBottomOf="@id/unisoundTitle"
        tools:text="Código K7M2QX" />

    <ImageButton
        android:id="@+id/unisoundShareButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Compartir la sala"
        android:padding="10dp"
        android:src="@drawable/ic_share"
        app:layout_constraintEnd_toStartOf="@id/unisoundSettingsButton"
        app:layout_constraintTop_toTopOf="@id/unisoundBackButton"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/unisoundSettingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ajustes de la sala"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/unisoundBackButton"
        app:tint="@color/white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/unisoundNowPlayingCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardsTheme"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundConnectionStatus">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/unisoundCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_disc"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/unisoundSongTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        tools:text="Do I Wanna Know?" />

                    <TextView
                        android:id="@+id/unisoundSongSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_regular"
                        android:maxLines="1"
                        android:textColor="@color/textTheme"
                        android:textSize="13sp"
                        tools:text="Arctic Monkeys · Añadido por Ana" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/unisoundProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="1000"
                app:indicatorColor="@color/secondaryColorTheme"
                app:trackColor="@color/discTheme"
                app:trackCornerRadius="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/unisoundPreviousButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Anterior"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/unisoundPlayPauseButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_play_button_pill_accent"
                    android:contentDescription="Reproducir o pausar"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/unisoundNextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Siguiente"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/unisoundReengageButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/unageo_bold"
                android:gravity="center"
                android:padding="10dp"
                android:text="Volver a la sala"
                android:textColor="@color/secondaryColorTheme"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/unisoundMembersLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/unageo_bold"
        android:text="En la sala"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundNowPlayingCard" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/unisoundMembers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundMembersLabel" />

    <TextView
        android:id="@+id/unisoundQueueLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/unageo_bold"
        android:text="A continuación"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/unisoundAddButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundMembers" />

    <TextView
        android:id="@+id/unisoundAddButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/unageo_bold"
        android:padding="8dp"
        android:text="Añadir"
        android:textColor="@color/secondaryColorTheme"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/unisoundQueueLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unisoundQueue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/unisoundLeaveButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundQueueLabel" />

    <TextView
        android:id="@+id/unisoundEmptyQueue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:fontFamily="@font/unageo_regular"
        android:gravity="center"
        android:text="La cola está vacía. Añade una canción para empezar"
        android:textColor="@color/textTheme"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/unisoundQueue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/unisoundQueue" />

    <TextView
        android:id="@+id/unisoundLeaveButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:text="Salir de la sala"
        android:textColor="@color/secondaryColorTheme"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
