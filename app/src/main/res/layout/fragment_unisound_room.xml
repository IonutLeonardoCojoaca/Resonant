<?xml version="1.0" encoding="utf-8"?>
<!-- Unisound room, mirroring the web: header with the code and actions, tabs
     Sala / Añadir / Miembros and the room content under them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/unisoundBackButton"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="Unisound" />
    </LinearLayout>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_unisound_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_unisound"
                app:tint="@color/secondaryColorTheme" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/unisoundCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    tools:text="Sala · 4QF3F4" />

                <TextView
                    android:id="@+id/unisoundRoleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_regular"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp"
                    tools:text="Eres invitado · 2 conectados" />

                <TextView
                    android:id="@+id/unisoundHealthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawableStart="@drawable/bg_unisound_dot"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/successColor"
                    android:textSize="12sp"
                    tools:text="Todo correcto" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/unisoundActionCopy"
                style="@style/UnisoundHeaderAction"
                android:contentDescription="Copiar código"
                android:src="@drawable/ic_unisound_copy" />

            <ImageButton
                android:id="@+id/unisoundActionShare"
                style="@style/UnisoundHeaderAction"
                android:contentDescription="Invitar con QR o enlace"
                android:src="@drawable/ic_unisound_link" />

            <ImageButton
                android:id="@+id/unisoundActionSave"
                style="@style/UnisoundHeaderAction"
                android:contentDescription="Guardar lo que ha sonado como playlist"
                android:src="@drawable/ic_unisound_list_plus" />

            <ImageButton
                android:id="@+id/unisoundActionLeave"
                style="@style/UnisoundHeaderAction"
                android:contentDescription="Salir de la sala"
                android:src="@drawable/ic_unisound_log_out" />

            <ImageButton
                android:id="@+id/unisoundActionEnd"
                style="@style/UnisoundHeaderAction"
                android:background="@drawable/bg_unisound_pill_danger"
                android:contentDescription="Terminar la sala para todos"
                android:src="@drawable/ic_unisound_power"
                android:visibility="gone"
                app:tint="@color/secondaryColorTheme" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_unisound_card"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/unisoundTabRoom"
            style="@style/UnisoundTab"
            android:drawableStart="@drawable/ic_unisound"
            android:text="Sala" />

        <TextView
            android:id="@+id/unisoundTabAdd"
            style="@style/UnisoundTab"
            android:drawableStart="@drawable/ic_unisound_search"
            android:text="Añadir" />

        <TextView
            android:id="@+id/unisoundTabMembers"
            style="@style/UnisoundTab"
            android:drawableStart="@drawable/ic_unisound_users"
            android:text="Miembros" />
    </LinearLayout>

    <TextView
        android:id="@+id/unisoundBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_unisound_card"
        android:fontFamily="@font/unageo_medium"
        android:padding="12dp"
        android:text="Conectando con la sala…"
        android:textColor="@color/adviseColor"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Sala -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/unisoundRoomTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/screen_bottom_inset_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:id="@+id/unisoundHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_unisound_hero"
                    android:clipChildren="true"
                    android:clipToOutline="true">

                    <!-- Layer 1: the cover, blurred and oversized; drifts slower than the page (parallax). -->
                    <ImageView
                        android:id="@+id/unisoundHeroBackdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.9"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:scaleX="1.5"
                        android:scaleY="1.5" />

                    <!-- Layer 2: the cover's dominant tone. -->
                    <View
                        android:id="@+id/unisoundHeroTint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Layer 3: fade into black under the controls. -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_unisound_hero_scrim" />

                    <LinearLayout
                        android:id="@+id/unisoundNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/unisoundCover"
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:elevation="16dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_disc"
                            app:shapeAppearanceOverlay="@style/RoundedCornersImageLarge" />

                        <TextView
                            android:id="@+id/unisoundEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/unageo_bold"
                            android:letterSpacing="0.1"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp"
                            tools:text="Elegido para la sala" />

                        <TextView
                            android:id="@+id/unisoundSongTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/unageo_bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="#FFFFFFFF"
                            android:textSize="22sp"
                            tools:text="XO / The Host" />

                        <TextView
                            android:id="@+id/unisoundSongArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp"
                            tools:text="The Weeknd" />

                        <LinearLayout
                            android:id="@+id/unisoundProgressRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/unisoundElapsed"
                                style="@style/UnisoundTime"
                                android:textColor="#CCFFFFFF"
                                tools:text="3:25" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/unisoundProgress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_weight="1"
                                android:max="1000"
                                app:indicatorColor="#FFFFFFFF"
                                app:trackColor="#33FFFFFF"
                                app:trackCornerRadius="2dp" />

                            <TextView
                                android:id="@+id/unisoundDuration"
                                style="@style/UnisoundTime"
                                android:textColor="#CCFFFFFF"
                                tools:text="7:24" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/unisoundControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/unisoundPreviousButton"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_unisound_hero_button"
                                android:contentDescription="Anterior"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_skip_previous"
                                app:tint="#FFFFFFFF" />

                            <ImageButton
                                android:id="@+id/unisoundPlayPauseButton"
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:layout_marginHorizontal="24dp"
                                android:background="@drawable/bg_unisound_hero_play"
                                android:contentDescription="Reproducir o pausar"
                                android:elevation="10dp"
                                android:padding="26dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                app:tint="#FF111114" />

                            <ImageButton
                                android:id="@+id/unisoundNextButton"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_unisound_hero_button"
                                android:contentDescription="Siguiente"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_skip_next"
                                app:tint="#FFFFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/unisoundLockedNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/unageo_regular"
                            android:text="El anfitrión controla la reproducción"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/unisoundReengageButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_unisound_pill"
                            android:fontFamily="@font/unageo_bold"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp"
                            android:text="Volver a la sala"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Floating reactions, drawn over the now-playing card -->
                    <FrameLayout
                        android:id="@+id/unisoundReactionLayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/unisoundReactionBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_unisound_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_unisound_card"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/unageo_bold"
                            android:text="A continuación"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/unisoundQueueCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_medium"
                            android:textColor="@color/textTheme"
                            android:textSize="13sp"
                            tools:text="3/200" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerOverlay" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/unisoundQueue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/unisoundEmptyQueue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unageo_regular"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="No hay nada en la cola"
                        android:textColor="@color/textTheme"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Añadir -->
        <LinearLayout
            android:id="@+id/unisoundAddTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/unisoundSearchInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_unisound_input"
                android:drawableStart="@drawable/ic_unisound_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/textTheme"
                android:fontFamily="@font/unageo_regular"
                android:hint="Busca canciones para la sala"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/textTheme"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/unisoundSearchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_regular"
                android:gravity="center"
                android:padding="24dp"
                android:text="Escribe para buscar. También puedes añadir álbumes y playlists desde sus opciones."
                android:textColor="@color/textTheme"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/unisoundSearchResults"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/screen_bottom_inset_compact" />
        </LinearLayout>

        <!-- Miembros -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/unisoundMembersTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/screen_bottom_inset_compact"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_unisound_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/unisoundMemberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Ajustes de la sala"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/unisoundSettingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/unisoundNewCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_unisound_pill"
                    android:drawableStart="@drawable/ic_unisound_refresh"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Nuevo código"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/unisoundSettingsNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/unageo_regular"
                    android:text="Solo el anfitrión puede cambiar estos ajustes."
                    android:textColor="@color/textTheme"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
