<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_bold"
                android:text="Cola de reproducción"
                android:textColor="@color/white"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/queue_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_regular"
                android:textColor="@color/textTheme"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/queue_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffle_upcoming"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Mezclar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="#17171A"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_random"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:iconSize="19dp"
            app:iconTint="@color/white"
            app:rippleColor="#33FFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_upcoming"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Vaciar"
            android:textAllCaps="false"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="13sp"
            app:backgroundTint="#17171A"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:iconSize="19dp"
            app:iconTint="@color/secondaryColorTheme"
            app:rippleColor="#33FFFFFF"
            app:strokeColor="#55E21616"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/queue_reorder_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        android:fontFamily="@font/unageo_regular"
        android:textColor="@color/textTheme"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playback_queue_list"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/empty_queue"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:fontFamily="@font/unageo_medium"
        android:text="Todavía no hay una cola activa"
        android:textColor="@color/textTheme"
        android:visibility="gone" />
</LinearLayout>
