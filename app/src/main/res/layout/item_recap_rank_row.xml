<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un top del resumen mensual (canción o artista). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/recapRankNumber"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/unageo_bold"
        android:textColor="@color/recap_accent"
        android:textSize="18sp"
        tools:text="1" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/recapRankImage"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedCornersExploreGrid"
        tools:src="@drawable/ic_disc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recapRankTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:maxLines="1"
            android:textColor="@color/recap_text_primary"
            android:textSize="16sp"
            tools:text="Like a Villain" />

        <TextView
            android:id="@+id/recapRankSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_medium"
            android:maxLines="1"
            android:textColor="@color/recap_text_secondary"
            android:textSize="13sp"
            tools:text="Bad Omens · 31 reproducciones" />
    </LinearLayout>
</LinearLayout>
