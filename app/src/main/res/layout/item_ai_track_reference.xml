<?xml version="1.0" encoding="utf-8"?>
<!-- Resultado de búsqueda de una canción de referencia en Crear con IA. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/referenceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_medium"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="Midnight City" />

    <TextView
        android:id="@+id/referenceArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_regular"
        android:maxLines="1"
        android:textColor="@color/textTheme"
        android:textSize="12sp"
        tools:text="M83" />
</LinearLayout>
