<?xml version="1.0" encoding="utf-8"?>
<!--
    Buscar. De arriba abajo:
      1. Barra: atrás + el propio campo de búsqueda (píldora rellena) en el sitio del título.
      2. Filtros: chips FilterChip en una fila deslizable alineada a 16dp.
      3. Cabecera de la lista: título de sección (Búsquedas recientes / Resultados / Quizás…) y, con solo el
         filtro PlayMix, el acceso a las PlayMix públicas.
      4. Contenido: historial, sugerencias o resultados; loader; sin resultados; y el estado inicial sin historial.
    Lo controla SearchFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical"
    tools:context=".ui.fragments.SearchFragment">

    <!-- ═══ 1. Barra con el campo ═══ -->
    <LinearLayout
        android:id="@+id/superiorToolbar"
        style="@style/TopBar"
        android:layout_height="64dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputSearchContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            app:boxBackgroundMode="none"
            app:endIconContentDescription="Borrar búsqueda"
            app:endIconMode="clear_text"
            app:endIconTint="@color/textTheme"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextQuery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="12dp"
                android:drawableTint="@color/textTheme"
                android:fontFamily="@font/unageo_medium"
                android:hint="Canciones, artistas, álbumes…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingTop="0dp"
                android:paddingEnd="4dp"
                android:paddingBottom="0dp"
                android:textColor="@color/white"
                android:textColorHint="@color/textTheme"
                android:textCursorDrawable="@null"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- ═══ 2. Filtros ═══ -->
    <HorizontalScrollView
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipGroupContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSongs"
                style="@style/FilterChip"
                android:checked="true"
                android:text="Canciones" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAlbums"
                style="@style/FilterChip"
                android:checked="true"
                android:text="Álbumes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipArtists"
                style="@style/FilterChip"
                android:checked="true"
                android:text="Artistas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaylists"
                style="@style/FilterChip"
                android:checked="true"
                android:text="Playlists" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEssentials"
                style="@style/FilterChip"
                android:checked="true"
                android:text="Essentials" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaymixes"
                style="@style/FilterChip"
                android:checked="true"
                android:text="PlayMix" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGenres"
                style="@style/FilterChip"
                android:layout_marginEnd="0dp"
                android:checked="true"
                android:text="Géneros" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ═══ 3. Cabecera de la lista ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/searchSectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="gone"
            tools:text="Búsquedas recientes"
            tools:visibility="visible" />

        <!-- Con solo el filtro PlayMix: acceso a las PlayMix públicas (playmix-sharing-discovery) -->
        <TextView
            android:id="@+id/searchPublicPlaymixesLink"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="PlayMix públicas ›"
            android:textColor="@color/playmix_accent"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ═══ 4. Contenido ═══ -->
    <FrameLayout
        android:id="@+id/listSongsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="@dimen/screen_bottom_inset"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestionsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="@dimen/screen_bottom_inset"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filteredListResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="@dimen/screen_bottom_inset"
            android:visibility="invisible" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loadingAnimation"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:contentDescription="Buscando"
            android:visibility="invisible"
            app:lottie_autoPlay="true"
            app:lottie_fileName="loader.json"
            app:lottie_loop="true" />

        <!-- Sin resultados (CollectionState). Arriba y no centrado: con el teclado abierto se vería a medias. -->
        <include
            android:id="@+id/noSongFoundedText"
            layout="@layout/view_collection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <!-- Estado inicial sin historial: invita a buscar en lugar de dejar la pantalla en blanco. -->
        <include
            android:id="@+id/searchIdleState"
            layout="@layout/view_collection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
