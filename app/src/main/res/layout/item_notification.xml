<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la bandeja: icono o imagen, título, cuerpo, hora y punto rojo si no está leída. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/notificationIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_explore_quick_card"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Viernes noche: 2000s empieza a las 22:00" />

        <TextView
            android:id="@+id/notificationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_medium"
            android:maxLines="3"
            android:textColor="@color/textTheme"
            android:textSize="13sp"
            tools:text="90 minutos de los 2000. Entra cuando quieras." />

        <TextView
            android:id="@+id/notificationTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/unageo_medium"
            android:textColor="@color/textTheme"
            android:textSize="11sp"
            tools:text="Hace 5 min" />
    </LinearLayout>

    <View
        android:id="@+id/notificationUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_notification_unread_dot" />
</LinearLayout>
