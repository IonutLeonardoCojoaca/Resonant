<?xml version="1.0" encoding="utf-8"?>
<!-- "Radio de <artista>": foto circular del artista dentro de ondas de radio
     concéntricas sobre fondo oscuro con brillo amarillo. Lo rellena ArtistMixAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="200dp"
    android:layout_marginHorizontal="5dp"
    android:background="@drawable/bg_artist_radio_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:stateListAnimator="@animator/explore_quick_card_press">

    <FrameLayout
        android:layout_width="122dp"
        android:layout_height="122dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_artist_radio_waves"
            android:importantForAccessibility="no" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mixImage"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircularUserImage"
            app:strokeColor="#FFD43B"
            app:strokeWidth="2dp"
            tools:src="@drawable/ic_user" />
    </FrameLayout>

    <TextView
        android:id="@+id/mixEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/unageo_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.16"
        android:text="● Radio"
        android:textAllCaps="true"
        android:textColor="#FFD43B"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/mixTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        tools:text="Bad Bunny" />

    <TextView
        android:id="@+id/mixMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/unageo_medium"
        android:includeFontPadding="false"
        android:text="Mezcla sin fin"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
