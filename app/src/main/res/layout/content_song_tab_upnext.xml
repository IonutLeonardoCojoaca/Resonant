<?xml version="1.0" encoding="utf-8"?>
<!-- "Up Next" tab content for fragment_song.xml. Same view ids as
     bottom_sheet_playback_queue.xml (both are wired by PlaybackQueueController)
     minus the bottom-sheet-only handle/title, which the TabLayout label already
     covers, and minus the "Relacionadas" mini-list — SongFragment already has
     its own dedicated Related tab, so PlaybackQueueController skips that
     section here (relatedSection/relatedRecycler passed as null). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp">

    <TextView
        android:id="@+id/queue_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:fontFamily="@font/unageo_regular"
        android:textColor="@color/textTheme"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/queue_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffle_upcoming"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Mezclar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/cardsTheme"
            app:cornerRadius="@dimen/radius_sm"
            app:icon="@drawable/ic_random"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:iconSize="18dp"
            app:iconTint="@color/white"
            app:rippleColor="@color/dividerOverlay"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_upcoming"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Vaciar"
            android:textAllCaps="false"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="13sp"
            app:backgroundTint="@color/cardsTheme"
            app:cornerRadius="@dimen/radius_sm"
            app:rippleColor="@color/dividerOverlay"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/queue_reorder_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:fontFamily="@font/unageo_regular"
        android:textColor="@color/textTheme"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playback_queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/empty_queue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:fontFamily="@font/unageo_medium"
        android:text="Todavía no hay una cola activa"
        android:textColor="@color/textTheme"
        android:visibility="gone" />

</LinearLayout>
