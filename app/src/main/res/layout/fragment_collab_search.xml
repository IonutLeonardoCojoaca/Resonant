<?xml version="1.0" encoding="utf-8"?>
<!--
    Collab Finder · búsqueda. Dos fases sobre la misma pantalla:
    - Intro: motivo de órbitas (parallax), título, buscador y sugerencias.
    - Órbita: el mapa de colaboraciones (BubbleOrbitView, altura fija) que muestra
      la búsqueda en curso y luego el resultado sin cambiar de vista.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <!-- Glow de acento de fondo (capa más lejana del parallax) -->
    <View
        android:id="@+id/backdropGlow"
        android:layout_width="0dp"
        android:layout_height="460dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/superiorToolbar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Atrás"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_extra_bold"
            android:letterSpacing="0.18"
            android:text="COLLAB FINDER"
            android:textColor="#8C9DFF"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superiorToolbar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="120dp">

            <!-- ── INTRO ── -->
            <LinearLayout
                android:id="@+id/introContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <com.example.resonant.feature.collabfinder.ui.views.CollabOrbitMotifView
                    android:id="@+id/heroMotif"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvIntroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:text="¿Con quién ha colaborado?"
                    android:textColor="@color/white"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvIntroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Busca un artista y descubre su mapa de colaboraciones y las canciones que comparten."
                    android:textColor="@color/textTheme"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/searchFieldCard"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/textTheme" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/unageo_medium"
                        android:hint="Shakira, Eminem, Bad Bunny…"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="@color/textTheme"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Borrar búsqueda"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/textTheme" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchGo"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/unageo_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="Buscar"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        app:cornerRadius="20dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="@font/unageo_bold"
                    android:letterSpacing="0.16"
                    android:text="PRUEBA CON"
                    android:textColor="@color/textTheme"
                    android:textSize="10sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupArtists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="7dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="false" />
            </LinearLayout>

            <!-- ── ÓRBITA (búsqueda en curso + resultado) ── -->
            <LinearLayout
                android:id="@+id/orbitSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.example.resonant.feature.collabfinder.ui.views.BubbleOrbitView
                    android:id="@+id/bubbleOrbitView"
                    android:layout_width="match_parent"
                    android:layout_height="380dp" />

                <TextView
                    android:id="@+id/tvOrbitEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/unageo_bold"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"
                    android:textColor="#8C9DFF"
                    android:textSize="10sp"
                    tools:text="Mapa de colaboraciones" />

                <TextView
                    android:id="@+id/tvArtistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="28dp"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    tools:text="The Weeknd" />

                <TextView
                    android:id="@+id/tvCollabSubtext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="34dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/unageo_medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp"
                    tools:text="Toca un artista para ver vuestras canciones" />

                <LinearLayout
                    android:id="@+id/resultActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:fontFamily="@font/unageo_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver todas las colaboraciones"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        app:cornerRadius="26dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchAnother"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/unageo_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Buscar otro artista"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="24dp"
                        app:strokeColor="@color/discTheme"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
