<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta "genres" del resumen mensual. recapCardRoot es lo que se comparte como imagen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recapCardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_recap_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/recapCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:fontFamily="@font/unageo_bold"
        android:textColor="@color/recap_text_primary"
        android:textSize="18sp"
        android:text="@string/recap_genres_title" />

    <TextView
        android:id="@+id/recapGenreTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/unageo_bold"
        android:textColor="@color/recap_text_primary"
        android:textSize="40sp"
        tools:text="Metalcore" />

    <TextView
        android:id="@+id/recapGenreTopShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/unageo_medium"
        android:textColor="@color/recap_text_secondary"
        android:textSize="16sp"
        tools:text="34 % de tus escuchas" />

    <TextView
        android:id="@+id/recapGenreRisingLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/unageo_medium"
        android:textColor="@color/recap_text_secondary"
        android:textSize="14sp"
        android:text="@string/recap_rising_genre_label" />

    <TextView
        android:id="@+id/recapGenreRising"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/unageo_bold"
        android:textColor="@color/recap_text_primary"
        android:textSize="26sp"
        tools:text="Indie" />

    <TextView
        android:id="@+id/recapGenreRisingShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/unageo_medium"
        android:textColor="@color/recap_text_secondary"
        android:textSize="14sp"
        tools:text="18 % (antes 5 %)" />
</LinearLayout>
