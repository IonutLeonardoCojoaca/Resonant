<?xml version="1.0" encoding="utf-8"?>
<!-- Un carril del editor v2: tarjeta con el nombre en su color y la opción elegida; al tocarla se abre el desplegable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/laneDropdown"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_mix_lane_cell"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/laneDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_lane_dot" />

        <TextView
            android:id="@+id/laneName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/unageo_bold"
            android:letterSpacing="0.12"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/laneSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_medium"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/unageo_medium"
            android:text="▾"
            android:textColor="#88FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
