<?xml version="1.0" encoding="utf-8"?>
<!-- Crear con IA (add-ai-track-generation): idea + referencias → sugerencia de Aria → campos editables → generar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.AiTrackCreateFragment">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="Crear con IA" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <TextView
                style="@style/AiTrackLabel"
                android:layout_marginTop="4dp"
                android:text="¿Qué quieres escuchar?" />

            <EditText
                android:id="@+id/descriptionInput"
                style="@style/AiTrackInput"
                android:gravity="top|start"
                android:hint="Trap oscuro de noche, 808 fuerte…"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:minLines="2" />

            <TextView
                style="@style/AiTrackLabel"
                android:text="Canciones de referencia (opcional, hasta 3)" />

            <EditText
                android:id="@+id/referenceSearchInput"
                style="@style/AiTrackInput"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="8dp"
                android:hint="Busca una canción"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/referenceResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/referenceChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:theme="@style/Theme.MaterialComponents.Light"
                app:chipSpacingHorizontal="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/suggestButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/unageo_bold"
                android:text="Sugerir con Aria"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_star_ai"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:strokeColor="@color/dividerOverlay" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/suggestProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                style="@style/AiTrackLabel"
                android:text="Título" />

            <EditText
                android:id="@+id/titleInput"
                style="@style/AiTrackInput"
                android:hint="Neón"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:maxLines="1" />

            <TextView
                style="@style/AiTrackLabel"
                android:text="Estilo (mejor en inglés, separado por comas)" />

            <EditText
                android:id="@+id/styleInput"
                style="@style/AiTrackInput"
                android:gravity="top|start"
                android:hint="dark trap, heavy 808 bass, eerie bells"
                android:inputType="textMultiLine"
                android:maxLength="200"
                android:minLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AiTrackLabel"
                        android:text="BPM" />

                    <EditText
                        android:id="@+id/bpmInput"
                        style="@style/AiTrackInput"
                        android:hint="120"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AiTrackLabel"
                        android:text="Tonalidad" />

                    <EditText
                        android:id="@+id/keyInput"
                        style="@style/AiTrackInput"
                        android:hint="A minor"
                        android:inputType="text"
                        android:maxLength="16"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/durationLabel"
                style="@style/AiTrackLabel"
                tools:text="Duración: 2:30" />

            <com.google.android.material.slider.Slider
                android:id="@+id/durationSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="30"
                android:value="150"
                android:valueFrom="60"
                android:valueTo="240"
                app:labelBehavior="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/unageo_regular"
                android:text="Solo instrumental. Se genera en el servidor y tarda más o menos lo que dura la pista; aparecerá en tu catálogo como «Resonant AI»."
                android:textColor="@color/textTheme"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Generar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
