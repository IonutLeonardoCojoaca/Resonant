<?xml version="1.0" encoding="utf-8"?>
<!-- Artista relacionado en el carrusel de Aria: foto circular protagonista + nombre + motivo,
     sin panel alrededor (como los carruseles de artistas del resto de la app). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingBottom="4dp"
    android:stateListAnimator="@animator/explore_quick_card_press">

    <FrameLayout
        android:id="@+id/relatedArtistAvatarFrame"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/relatedArtistInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/unageo_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@android:color/white"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/relatedArtistImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/relatedArtistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/relatedArtistReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/textTheme"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/relatedArtistMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/unageo_medium"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/aria_accent_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
