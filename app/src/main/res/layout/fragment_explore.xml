<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.ExploreFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/exploreScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- Barra de pestaña (components.md §0): misma que Inicio. -->
            <LinearLayout
                android:id="@+id/superiorToolbar"
                style="@style/TopBar">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/userProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user"
                    app:shapeAppearanceOverlay="@style/CircularUserImage" />

                <TextView
                    android:id="@+id/textView2"
                    style="@style/TopBar.Title"
                    android:layout_marginStart="12dp"
                    android:text="Explorar"
                    android:textSize="22sp" />

                <ImageButton
                    android:id="@+id/searchButton"
                    style="@style/TopBar.Action"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exploreIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/exploreHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="Descubre sin ruido"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

                <!-- Racha: solo visible con features.streaks -->
                <include layout="@layout/view_streak_chip" />

            </LinearLayout>

            <!-- ── Canción del día: solo visible con features.streaks ── -->
            <include layout="@layout/view_song_of_day_card" />

            <!-- ── Resumen mensual sin ver: solo con features.monthlyRecap ── -->
            <include layout="@layout/view_recap_banner" />

            <!-- ── Lo más top ── -->
            <LinearLayout
                android:id="@+id/quickActionsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:text="Lo más top"
                    android:textColor="@color/white"
                    android:textSize="19sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/quickActionsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/quickActionsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp">

                    <include
                        android:id="@+id/btnArtistas"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnAlbumes"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnCanciones"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnListas"
                        layout="@layout/view_explore_quick_card" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── Explorar v2: secciones dinámicas (las pinta ExploreSectionsRenderer) ── -->
            <LinearLayout
                android:id="@+id/exploreDynamicContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- ── Explorar fijo: fallback cuando Explorar v2 no está disponible ── -->
            <LinearLayout
                android:id="@+id/exploreLegacyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── Álbumes recomendados (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/recommendedAlbumsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/recommendedAlbumsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewRecommendedAlbums"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_album" />

                        <TextView
                            android:id="@+id/recommendedAlbumsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="Escucha algo para recibir recomendaciones."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/recommendedAlbumsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── En el momento (bloque intercalado: en Explorar v2 lo recoloca ExploreSectionsRenderer) ── -->
                <LinearLayout
                    android:id="@+id/liveNowBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_bold"
                            android:includeFontPadding="false"
                            android:text="En el momento"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingBottom="6dp"
                        android:scrollbars="none">

                        <!-- Fila preparada para crecer: aquí irá también la tarjeta "Live". -->
                        <LinearLayout
                            android:id="@+id/liveNowGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="11dp">

                            <include
                                android:id="@+id/btnTendencias"
                                layout="@layout/view_explore_quick_card" />

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ── Álbumes nuevos (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/albumsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/albumsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewAlbums"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_album" />

                        <TextView
                            android:id="@+id/albumsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="No hay albumes recientes."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/albumsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Esto es… (bloque intercalado: en Explorar v2 lo recoloca ExploreSectionsRenderer) ── -->
                <LinearLayout
                    android:id="@+id/artistEssentialsBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_bold"
                            android:includeFontPadding="false"
                            android:text="Esto es…"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewArtistEssentials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="8dp"
                        android:scrollbars="none" />
                </LinearLayout>

                <!-- ── Artistas recomendados (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/recommendedArtistsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/recommendedArtistsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewRecommendedArtists"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingStart="8dp"
                            android:paddingEnd="16dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_artist" />

                        <TextView
                            android:id="@+id/recommendedArtistsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="Escucha algo para recibir recomendaciones."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/recommendedArtistsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Géneros — tanda 1 (los más populares) ── -->
                <LinearLayout
                    android:id="@+id/genresSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/genresHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="142dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewGenres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_genre" />

                        <TextView
                            android:id="@+id/genresPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="132dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="No hay generos disponibles."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/genresShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Descubre (bloque intercalado: en Explorar v2 lo recoloca ExploreSectionsRenderer) ── -->
                <LinearLayout
                    android:id="@+id/discoverBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_bold"
                            android:includeFontPadding="false"
                            android:text="Descubre"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <!-- Collab Finder: tarjeta propia con el motivo de órbitas (ExploreCollabFinderCard). -->
                    <include
                        android:id="@+id/btnCollabFinder"
                        layout="@layout/view_explore_collab_finder_card"
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp" />

                    <!-- PlayMix de la comunidad (playmix-sharing-discovery): estantería con las públicas más populares.
                         Oculta con la capacidad apagada o sin PlayMix; la rellena PublicPlaymixShelf. -->
                    <LinearLayout
                        android:id="@+id/publicPlaymixesShelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/publicPlaymixesHeader"
                            layout="@layout/view_explore_section_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/publicPlaymixesList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Playlists (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/playlistsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/playlistsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewPlaylists"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_playlist" />

                        <TextView
                            android:id="@+id/playlistsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="Aun no hay playlists publicas."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/playlistsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Radios de artistas (bloque intercalado: en Explorar v2 lo recoloca ExploreSectionsRenderer) ── -->
                <LinearLayout
                    android:id="@+id/artistRadiosBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unageo_bold"
                            android:includeFontPadding="false"
                            android:text="Radios de artistas"
                            android:textColor="@color/white"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewArtistRadios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="8dp"
                        android:scrollbars="none" />
                </LinearLayout>

                <!-- ── Géneros — tanda 2 (menos escuchados) ── -->
                <LinearLayout
                    android:id="@+id/genresMoreSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/genresMoreHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="142dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewGenresMore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_genre" />

                        <TextView
                            android:id="@+id/genresMorePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="132dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:text="No hay mas generos disponibles."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/genresMoreShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/view_search_header"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

</FrameLayout>
