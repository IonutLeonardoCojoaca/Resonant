<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.ExploreFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/exploreScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="188dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/superiorToolbar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/userProfile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircularUserImage" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="Explorar"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/userProfile"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/searchButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/exploreIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/exploreHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:text="Descubre sin ruido"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

            </LinearLayout>

            <!-- ── Lo más top: cabecera de sección (título + subtítulo) ── -->
            <LinearLayout
                android:id="@+id/quickActionsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:text="Lo más top"
                    android:textColor="@color/white"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:includeFontPadding="false"
                    android:text="Los rankings de Resonant, a un toque"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/quickActionsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/quickActionsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <include
                        android:id="@+id/btnArtistas"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnAlbumes"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnCanciones"
                        layout="@layout/view_explore_quick_card" />

                    <include
                        android:id="@+id/btnListas"
                        layout="@layout/view_explore_quick_card" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── En el momento: cabecera de sección (título + subtítulo) ── -->
            <LinearLayout
                android:id="@+id/liveNowHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_bold"
                    android:includeFontPadding="false"
                    android:text="En el momento"
                    android:textColor="@color/white"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:includeFontPadding="false"
                    android:text="Lo que está pasando ahora mismo"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Fila preparada para crecer: aquí irá también la tarjeta "Live". -->
            <HorizontalScrollView
                android:id="@+id/liveNowScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/liveNowGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <include
                        android:id="@+id/btnTendencias"
                        layout="@layout/view_explore_quick_card" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── Explorar v2: secciones dinámicas (las pinta ExploreSectionsRenderer) ── -->
            <LinearLayout
                android:id="@+id/exploreDynamicContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- ── Explorar fijo: fallback cuando Explorar v2 no está disponible ── -->
            <LinearLayout
                android:id="@+id/exploreLegacyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── Álbumes recomendados (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/recommendedAlbumsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/recommendedAlbumsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewRecommendedAlbums"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_album" />

                        <TextView
                            android:id="@+id/recommendedAlbumsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Escucha algo para recibir recomendaciones."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/recommendedAlbumsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Álbumes nuevos (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/albumsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/albumsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewAlbums"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_album" />

                        <TextView
                            android:id="@+id/albumsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="No hay albumes recientes."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/albumsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Artistas recomendados (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/recommendedArtistsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/recommendedArtistsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewRecommendedArtists"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingStart="8dp"
                            android:paddingEnd="16dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_artist" />

                        <TextView
                            android:id="@+id/recommendedArtistsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Escucha algo para recibir recomendaciones."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/recommendedArtistsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                                <include layout="@layout/item_artist_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Géneros — tanda 1 (los más populares) ── -->
                <LinearLayout
                    android:id="@+id/genresSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/genresHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="142dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewGenres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_genre" />

                        <TextView
                            android:id="@+id/genresPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="132dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="No hay generos disponibles."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/genresShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Playlists (horizontal) ── -->
                <LinearLayout
                    android:id="@+id/playlistsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/playlistsHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="196dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewPlaylists"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_explore_playlist" />

                        <TextView
                            android:id="@+id/playlistsPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="Aun no hay playlists publicas."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/playlistsShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Géneros — tanda 2 (menos escuchados) ── -->
                <LinearLayout
                    android:id="@+id/genresMoreSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/genresMoreHeader"
                        layout="@layout/view_explore_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="142dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewGenresMore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="8dp"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_genre" />

                        <TextView
                            android:id="@+id/genresMorePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="132dp"
                            android:fontFamily="@font/unageo_regular"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp"
                            android:text="No hay mas generos disponibles."
                            android:textColor="@color/textTheme"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/genresMoreShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                                <include layout="@layout/item_album_shimmer_placeholder"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- ── Collab Finder (al final: función más nicho, no compite con
                     el contenido de descubrimiento principal por la parte alta
                     de la pantalla) ── -->
                <include
                    android:id="@+id/collabFinderSection"
                    layout="@layout/view_explore_collab_card" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/view_search_header"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

</FrameLayout>
