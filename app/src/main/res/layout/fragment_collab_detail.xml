<?xml version="1.0" encoding="utf-8"?>
<!--
    Collab Finder · detalle de una colaboración (artista A × artista B). Capas:
    glow de fondo → banner doble (parallax interno) con nombres y "×" encima →
    título, estadísticas y canciones. La barra superior se vuelve opaca al hacer scroll.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <View
        android:id="@+id/backdropGlow"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- Banner doble con nombres y "×" superpuestos -->
            <FrameLayout
                android:id="@+id/bannerFrame"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp">

                <com.example.resonant.feature.collabfinder.ui.views.CollabDuoBannerView
                    android:id="@+id/duoBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvArtistAName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="18dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:maxLines="1"
                    android:maxWidth="140dp"
                    android:shadowColor="#CC000000"
                    android:shadowDy="1"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="Future" />

                <TextView
                    android:id="@+id/tvArtistBName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="18dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="end"
                    android:maxLines="1"
                    android:maxWidth="140dp"
                    android:shadowColor="#CC000000"
                    android:shadowDy="1"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="Lil Uzi Vert" />

                <TextView
                    android:id="@+id/tvCrossBadge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/unageo_bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="×"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCollabEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/unageo_bold"
                android:letterSpacing="0.16"
                android:text="COLABORACIÓN"
                android:textColor="#8C9DFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvCollabTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="26sp"
                tools:text="Future × Lil Uzi Vert" />

            <!-- Estadísticas -->
            <LinearLayout
                android:id="@+id/statsStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <include
                    android:id="@+id/statCount"
                    layout="@layout/view_collab_stat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statYears"
                    layout="@layout/view_collab_stat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_panel"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.example.resonant.feature.collabfinder.ui.views.CollabScoreGaugeView
                        android:id="@+id/scoreGaugeView"
                        android:layout_width="50dp"
                        android:layout_height="50dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/unageo_medium"
                        android:includeFontPadding="false"
                        android:text="afinidad"
                        android:textColor="@color/textTheme"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayAll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Reproducir todas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@android:color/white" />

            <TextView
                android:id="@+id/tvSongsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:text="Canciones juntos"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvSongsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                tools:text="12 canciones encontradas en esta colaboración" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSharedSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_fade_slide"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="10dp" />

            <TextView
                android:id="@+id/tvEmptySongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/unageo_medium"
                android:gravity="center"
                android:text="No hemos encontrado canciones reproducibles de esta colaboración."
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra estándar (TopBar): transparente sobre el banner, opaca al hacer scroll. Los iconos usan la
         variante OnImage hasta que el fondo es opaco y entonces pasan a la del tema (OnImageTopBar). -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <View
            android:id="@+id/topBarBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/primaryColorTheme" />

        <LinearLayout style="@style/TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/TopBar.Back.OnImage" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TopBar.Title.Collapsed"
                android:layout_marginEnd="12dp"
                tools:text="Future × Lil Uzi Vert" />
        </LinearLayout>
    </FrameLayout>

    <!-- Carga: el motivo de órbitas de Collab Finder -->
    <com.example.resonant.feature.collabfinder.ui.views.CollabOrbitMotifView
        android:id="@+id/loadingMotif"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
