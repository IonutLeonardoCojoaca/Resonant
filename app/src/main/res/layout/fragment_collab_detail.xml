<?xml version="1.0" encoding="utf-8"?>
<!--
    Collab Finder · detalle de una colaboración (artista A × artista B). Capas:
    glow de fondo → hero a sangre (banner doble con parallax interno que se funde con el fondo, etiqueta
    y título) → panel de estadísticas y canciones. La barra superior se vuelve opaca al hacer scroll.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <View
        android:id="@+id/backdropGlow"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <!-- Hero a sangre: banner doble (se funde con el fondo por abajo) y, sobre el fundido, la etiqueta
                 y el título. -->
            <FrameLayout
                android:id="@+id/bannerFrame"
                android:layout_width="match_parent"
                android:layout_height="420dp">

                <com.example.resonant.feature.collabfinder.ui.views.CollabDuoBannerView
                    android:id="@+id/duoBanner"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:importantForAccessibility="no" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/tvCollabEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_collab_eyebrow_pill"
                        android:fontFamily="@font/unageo_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.16"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="COLABORACIÓN"
                        android:textColor="@color/collab_accent_text"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCollabTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.01"
                        android:maxLines="2"
                        android:textColor="@color/white"
                        android:textSize="30sp"
                        tools:text="The Weeknd × Future" />
                </LinearLayout>
            </FrameLayout>

            <!-- Estadísticas: un solo panel en tres columnas (valor arriba y etiqueta debajo, alineados entre
                 columnas); la afinidad añade su medidor bajo la etiqueta. -->
            <LinearLayout
                android:id="@+id/statsStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_surface_panel"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="16dp"
                android:screenReaderFocusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatCount"
                        style="@style/CollabStatValue"
                        android:text="–"
                        tools:text="9" />

                    <TextView
                        style="@style/CollabStatLabel"
                        android:text="CANCIONES" />
                </LinearLayout>

                <View style="@style/CollabStatDivider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatYears"
                        style="@style/CollabStatValue"
                        android:layout_width="match_parent"
                        android:paddingHorizontal="6dp"
                        android:text="–"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="13sp"
                        app:autoSizeTextType="uniform"
                        tools:text="2016 – 2024" />

                    <TextView
                        style="@style/CollabStatLabel"
                        android:text="PERIODO" />
                </LinearLayout>

                <View style="@style/CollabStatDivider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatScore"
                        style="@style/CollabStatValue"
                        android:text="–"
                        tools:text="56" />

                    <TextView
                        style="@style/CollabStatLabel"
                        android:text="AFINIDAD" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/scoreMeter"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:max="100"
                        app:indicatorColor="@color/collab_accent_text"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="@color/dividerOnSurface"
                        app:trackCornerRadius="2dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayAll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Reproducir todas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@android:color/white" />

            <TextView
                android:id="@+id/tvSongsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:text="Canciones juntos"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvSongsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                tools:text="12 canciones encontradas en esta colaboración" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSharedSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_fade_slide"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="10dp" />

            <TextView
                android:id="@+id/tvEmptySongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/unageo_medium"
                android:gravity="center"
                android:text="No hemos encontrado canciones reproducibles de esta colaboración."
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra estándar (TopBar): transparente sobre el banner, opaca al hacer scroll. El fondo es el de la propia
         barra (no un hijo) para que cubra también la franja de la barra de estado que le añade StatusBarInsets. Los iconos usan la
         variante OnImage hasta que el fondo es opaco y entonces pasan a la del tema (OnImageTopBar). -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primaryColorTheme">

        <LinearLayout style="@style/TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/TopBar.Back.OnImage" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TopBar.Title.Collapsed"
                android:layout_marginEnd="12dp"
                tools:text="Future × Lil Uzi Vert" />
        </LinearLayout>
    </FrameLayout>

    <!-- Carga: el motivo de órbitas de Collab Finder -->
    <com.example.resonant.feature.collabfinder.ui.views.CollabOrbitMotifView
        android:id="@+id/loadingMotif"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
