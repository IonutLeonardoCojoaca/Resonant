<?xml version="1.0" encoding="utf-8"?>
<!-- Resonant Live: emisión de un canal. Solo se puede entrar y salir; el progreso no se arrastra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical">

    <!-- Top bar: atrás + nombre del canal con la insignia EN DIRECTO pegada al título. -->
    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/liveBackButton"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/liveChannelName"
                style="@style/TopBar.Title"
                android:layout_width="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/liveBadge"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Resonant Rock" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_live_badge"
                android:fontFamily="@font/unageo_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="@string/live_badge"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/liveChannelName"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/screen_bottom_inset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/liveBlockTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                tools:text="Resonant Rock · tarde" />

            <ImageView
                android:id="@+id/liveCover"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_explore_quick_card"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/liveSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_bold"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="Mr. Brightside" />

            <TextView
                android:id="@+id/liveSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_medium"
                android:maxLines="1"
                android:textColor="@color/textTheme"
                android:textSize="14sp"
                tools:text="The Killers" />

            <LinearLayout
                android:id="@+id/liveProgressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/liveElapsed"
                    style="@style/UnisoundTime"
                    tools:text="3:25" />

                <!-- Not a SeekBar on purpose: the broadcast cannot be moved. -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/liveProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:max="1000"
                    app:indicatorColor="@color/live_red"
                    app:trackCornerRadius="2dp" />

                <TextView
                    android:id="@+id/liveDuration"
                    style="@style/UnisoundTime"
                    tools:text="3:42" />
            </LinearLayout>

            <TextView
                android:id="@+id/liveMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/unageo_medium"
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Empieza en 01:30"
                tools:visibility="visible" />

            <!-- Aria DJ: intro que se está leyendo (o subtítulo unos segundos). Oculta sin intro. -->
            <LinearLayout
                android:id="@+id/liveDjSubtitleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_explore_quick_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.example.resonant.ui.views.AriaBadgeView
                    android:id="@+id/liveDjBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/liveDjSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/unageo_medium"
                    android:textColor="@color/textTheme"
                    android:textSize="14sp"
                    tools:text="Viernes noche en Resonant Rock. Abrimos con The Killers." />
            </LinearLayout>

            <TextView
                android:id="@+id/liveUpNextLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/unageo_bold"
                android:text="@string/live_up_next"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/liveUpNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/unageo_medium"
                android:maxLines="1"
                android:textColor="@color/textTheme"
                android:textSize="13sp"
                tools:text="R U Mine? · Arctic Monkeys" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveActionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/unageo_bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/live_red"
                app:cornerRadius="26dp"
                tools:text="@string/live_listen" />

            <TextView
                android:id="@+id/liveScheduleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/unageo_bold"
                android:text="@string/live_schedule"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_live_schedule" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
