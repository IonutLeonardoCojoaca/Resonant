<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.AlbumFragment"
    android:background="@color/primaryColorTheme">

    <ImageView
        android:id="@+id/artistImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitStart"
        android:alpha="1"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent">

            <RelativeLayout
                android:id="@+id/artistBanner"
                android:layout_width="match_parent"
                android:layout_height="360dp">

                <View
                    android:id="@+id/gradientOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_gradient_artist"
                    android:layout_alignParentBottom="true" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/albumDataContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primaryColorTheme"
                android:layout_below="@id/artistBanner">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/albumInfoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/albumName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="2dp"
                        android:paddingEnd="8dp"
                        android:breakStrategy="simple"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_bold"
                        android:hyphenationFrequency="normalFast"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/albumDownloadBackground"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/albumArtistName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unageo_regular"
                        android:text=""
                        android:textColor="@color/numberTime"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/albumDownloadBackground"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/albumName" />

                    <TextView
                        android:id="@+id/albumMetadataText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unageo_regular"
                        android:text="345345345345"
                        android:textColor="@color/textTheme"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingEnd="8dp"
                        android:visibility="invisible"
                        app:layout_constraintEnd_toEndOf="@+id/albumArtistName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/albumArtistName" />

                    <TextView
                        android:id="@+id/albumDownloadStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/unageo_medium"
                        android:maxLines="1"
                        android:textColor="@color/secondaryColorTheme"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="@+id/albumMetadataText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/albumMetadataText"
                        tools:text="Descargando 45% · 5 de 12" />

                    <FrameLayout
                        android:id="@+id/albumDownloadBackground"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Descargar álbum"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintBottom_toBottomOf="@+id/playButton"
                        app:layout_constraintEnd_toStartOf="@+id/playButton"
                        app:layout_constraintTop_toTopOf="@+id/playButton">

                        <ImageView
                            android:id="@+id/albumDownloadButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Descargar álbum"
                            android:src="@drawable/ic_download" />

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playButton"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:backgroundTint="@color/secondaryColorTheme"
                        app:cornerRadius="40dp"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="40dp"
                        app:iconTint="@color/white"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.example.resonant.ui.views.ExpandedRecyclerView
                    android:id="@+id/albumSongsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/albumInfoContainer"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="@dimen/screen_bottom_inset"
                    android:clipToPadding="false"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerSongLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/albumInfoContainer"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:id="@+id/shimmerSongItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_song_shimmer_placeholder" />
                        <include layout="@layout/item_song_shimmer_placeholder" />
                        <include layout="@layout/item_song_shimmer_placeholder" />
                        <include layout="@layout/item_song_shimmer_placeholder" />

                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@android:color/transparent"
                    android:layout_below="@id/albumSongsContainer"/>

            </RelativeLayout>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra estándar (TopBar) sobre la portada: el fondo y el título aparecen al hacer scroll
         (AlbumFragment) y los iconos pasan de la variante OnImage a la del tema (OnImageTopBar). -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/arrowGoBackButton"
            style="@style/TopBar.Back.OnImage" />

        <TextView
            android:id="@+id/albumTopBarText"
            style="@style/TopBar.Title.Collapsed" />

        <ImageButton
            android:id="@+id/favoriteButton"
            style="@style/TopBar.Action.OnImage"
            android:contentDescription="Me gusta"
            android:src="@drawable/ic_favorite_border"
            android:tooltipText="Me gusta" />
    </LinearLayout>

</RelativeLayout>
