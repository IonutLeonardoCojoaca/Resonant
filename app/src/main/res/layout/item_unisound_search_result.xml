<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/unisoundResultCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedCornersImage"
        tools:src="@drawable/ic_disc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unisoundResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Numb" />

        <TextView
            android:id="@+id/unisoundResultArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_regular"
            android:maxLines="1"
            android:textColor="@color/textTheme"
            android:textSize="12sp"
            tools:text="Linkin Park" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/unisoundResultAdd"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_unisound_round_button"
        android:contentDescription="Añadir a la sala"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_unisound_plus"
        app:tint="@color/white" />
</LinearLayout>
