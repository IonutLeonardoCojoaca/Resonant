<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingStart="56dp"
    android:paddingEnd="16dp"
    android:layout_marginBottom="18dp">

    <!-- Burbuja del usuario (derecha) -->
    <LinearLayout
        android:id="@+id/userBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_aria_message_user"
        android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/userMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14.5sp"
            android:fontFamily="@font/unageo_medium"
            android:lineSpacingMultiplier="1.35"/>

    </LinearLayout>

    <TextView
        android:id="@+id/userTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/textTertiaryAlpha"
        android:textSize="10sp"
        android:fontFamily="@font/unageo_regular"/>

</LinearLayout>
