<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/unisoundSummaryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/unageo_bold"
        android:text="Habéis escuchado juntos"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/unisoundSummaryStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/unageo_medium"
        android:textColor="@color/textTheme"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/unisoundSummaryTitle"
        app:layout_constraintStart_toStartOf="@id/unisoundSummaryTitle"
        app:layout_constraintTop_toBottomOf="@id/unisoundSummaryTitle"
        tools:text="42 min · 11 canciones" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unisoundSummarySongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/unisoundSummaryClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unisoundSummaryStats" />

    <TextView
        android:id="@+id/unisoundSummaryEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:fontFamily="@font/unageo_regular"
        android:gravity="center"
        android:text="No ha sonado ninguna canción"
        android:textColor="@color/textTheme"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/unisoundSummarySongs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/unisoundSummarySongs" />

    <TextView
        android:id="@+id/unisoundSummaryClose"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_play_button_pill_accent"
        android:fontFamily="@font/unageo_bold"
        android:gravity="center"
        android:text="Cerrar"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
