<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    tools:context=".ui.fragments.PlaymixListFragment">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/arrowGoBackButton"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            android:id="@+id/titleText"
            style="@style/TopBar.Title"
            android:text="Mis PlayMixes" />

        <!-- Crear con IA (add-ai-track-generation); visible solo con features.aiTracks. -->
        <ImageButton
            android:id="@+id/aiTracksButton"
            style="@style/TopBar.Action"
            android:contentDescription="Pistas con IA"
            android:src="@drawable/ic_star_ai"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playmixRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/screen_bottom_inset"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_playmix"
            android:alpha="0.3"
            app:tint="@color/textTheme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/unageo_regular"
            android:gravity="center"
            android:text="No tienes PlayMixes aún.\nCrea uno con el botón +"
            android:textColor="@color/textTheme"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreatePlaymix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="@dimen/screen_bottom_inset_compact"
        android:src="@drawable/ic_add"
        app:backgroundTint="#E21616"
        app:tint="@android:color/white" />

    <!-- Loader -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLoader"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerInParent="true"
        app:lottie_fileName="loader.json"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_repeatCount="-1"
        app:lottie_enableMergePathsForKitKatAndAbove="true" />

</RelativeLayout>
