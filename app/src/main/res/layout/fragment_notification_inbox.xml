<?xml version="1.0" encoding="utf-8"?>
<!-- Bandeja de notificaciones: lista paginada, estado vacío y "Marcar todo como leído". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/notificationInboxBack"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ic_arrow_back"
                android:clickable="false"
                android:contentDescription="Volver"
                android:focusable="false"
                android:scaleX="0.8"
                android:scaleY="0.8" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/unageo_bold"
            android:maxLines="1"
            android:text="@string/notifications_inbox_title"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/notificationInboxMarkAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/unageo_medium"
            android:padding="8dp"
            android:text="@string/notifications_mark_all_read"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notificationInboxList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="@dimen/screen_bottom_inset"
            tools:listitem="@layout/item_notification" />

        <TextView
            android:id="@+id/notificationInboxEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/unageo_medium"
            android:text="@string/notifications_inbox_empty"
            android:textColor="@color/textTheme"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notificationInboxError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_medium"
                android:text="@string/notifications_load_failed"
                android:textColor="@color/textTheme"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/notificationInboxRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/unageo_bold"
                android:padding="8dp"
                android:text="@string/notifications_retry"
                android:textColor="@color/secondaryColorTheme"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/notificationInboxProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/secondaryColorTheme"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
