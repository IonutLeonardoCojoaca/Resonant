<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:contentScrim="@color/primaryColorTheme"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@id/topBar">

            <!-- Hero por capas con parallax (ChartHero) -->
            <include
                android:id="@+id/chartHero"
                layout="@layout/view_chart_hero" />

            <!-- Barra estándar fija (TopBar): atrás + título que aparece al plegar (ChartHero). -->
            <LinearLayout
                android:id="@+id/topBar"
                style="@style/TopBar"
                android:layout_gravity="top"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/TopBar.Back" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    style="@style/TopBar.Title.Collapsed"
                    android:text="Historial" />
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Cuántas canciones mostrar: fijo bajo la toolbar al colapsar. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColorTheme"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <include
                android:id="@+id/limitSelector"
                layout="@layout/view_chart_period_selector" />
        </FrameLayout>

        <!-- Entrada a "Tus estadísticas": solo con features.listeningStats. -->
        <TextView
            android:id="@+id/btnListeningStats"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/primaryColorTheme"
            android:drawablePadding="8dp"
            android:fontFamily="@font/unageo_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Tus estadísticas"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableEndCompat="@drawable/ic_chevron_right_mini"
            app:drawableTint="@color/secondaryColorTheme" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Zona de contenido: lista (con acciones como cabecera), skeleton y estados vacío/error. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fade_slide"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/screen_bottom_inset" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="5dp"
                android:paddingTop="4dp">

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

                <include layout="@layout/item_song_shimmer_placeholder" />

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Arriba y no centrado: el área se extiende bajo el mini player al plegar la cabecera. -->
        <include
            android:id="@+id/stateView"
            layout="@layout/view_collection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="0dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
