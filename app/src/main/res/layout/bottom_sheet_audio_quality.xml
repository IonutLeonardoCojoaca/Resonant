<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <!-- Handle -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_bold"
            android:text="Calidad de audio"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/unageo_regular"
            android:text="Resonant solicitará la calidad indicada al servidor. La calidad real entregada puede variar."
            android:textColor="@color/textTheme"
            android:textSize="13sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/discTheme" />

        <!-- Streaming section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_bold"
            android:letterSpacing="0.05"
            android:text="STREAMING"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/unageo_regular"
            android:text="Calidad de reproducción en tiempo real"
            android:textColor="@color/textTheme"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/streaming_quality_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/cardsTheme"
            app:boxStrokeColor="@color/discTheme"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintTextColor="@color/textTheme"
            app:endIconTint="@color/textTheme">

            <AutoCompleteTextView
                android:id="@+id/streaming_quality_dropdown"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:dropDownSelector="@android:color/transparent"
                android:fontFamily="@font/unageo_medium"
                android:inputType="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="@color/discTheme" />

        <!-- Downloads section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unageo_bold"
            android:letterSpacing="0.05"
            android:text="NUEVAS DESCARGAS"
            android:textColor="@color/secondaryColorTheme"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/unageo_regular"
            android:text="Se aplica a las canciones que descargues a partir de ahora"
            android:textColor="@color/textTheme"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/download_quality_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/cardsTheme"
            app:boxStrokeColor="@color/discTheme"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintTextColor="@color/textTheme"
            app:endIconTint="@color/textTheme">

            <AutoCompleteTextView
                android:id="@+id/download_quality_dropdown"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:dropDownSelector="@android:color/transparent"
                android:fontFamily="@font/unageo_medium"
                android:inputType="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Footer note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/unageo_regular"
            android:text="Cambiar esta opción no modifica ni vuelve a etiquetar las descargas ya existentes."
            android:textColor="@color/textBottomSheet"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
