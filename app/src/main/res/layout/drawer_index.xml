<?xml version="1.0" encoding="utf-8"?>
<!--
    Menú lateral. Aurora de marca arriba, tarjeta de perfil, secciones con filas (icono en su cuadradito; la pantalla
    actual queda marcada) y, al pie, cerrar sesión y la versión. Lo montan MainActivity y DrawerMenu; las filas entran
    en cascada al abrir el menú.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:importantForAccessibility="noHideDescendants">

        <com.example.resonant.ui.views.AuroraView
            android:id="@+id/drawerAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mx_scrim" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Marca -->
        <LinearLayout
            android:id="@+id/drawerBrandRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="18dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="104dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/logo_resonant_text_adaptive" />
        </LinearLayout>

        <!-- Perfil -->
        <LinearLayout
            android:id="@+id/headerDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rs_profile_card"
            android:clickable="true"
            android:contentDescription="Ver perfil y ajustes"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/headerUserPhoto"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user"
                app:shapeAppearanceOverlay="@style/CircularUserImage" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerUserGreeting"
                    style="@style/RsEyebrow"
                    android:text="TU CUENTA" />

                <TextView
                    android:id="@+id/headerUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/unageo_bold"
                    android:maxLines="1"
                    android:text="Usuario"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    tools:text="Ionut Leonardo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/unageo_medium"
                    android:text="Perfil y ajustes"
                    android:textColor="@color/textTheme"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_mini"
                app:tint="@color/textTheme" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/drawerScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/RsEyebrow"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:text="DESCUBRIR" />

                <include android:id="@+id/homeButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/exploreButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/searchButton" layout="@layout/item_rs_drawer_row" />

                <TextView
                    style="@style/RsEyebrow"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="12dp"
                    android:text="TU MÚSICA" />

                <include android:id="@+id/savedButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/playmixButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/downloadsButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/historyButton" layout="@layout/item_rs_drawer_row" />
                <include android:id="@+id/statsButton" layout="@layout/item_rs_drawer_row" />

                <TextView
                    style="@style/RsEyebrow"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="12dp"
                    android:text="SISTEMA" />

                <include android:id="@+id/settingsButton" layout="@layout/item_rs_drawer_row" />
            </LinearLayout>
        </ScrollView>

        <!-- Pie: cerrar sesión y versión -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_rs_logout"
                android:clickable="true"
                android:contentDescription="Cerrar sesión"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/secondaryColorTheme" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/unageo_semi_bold"
                    android:text="Cerrar sesión"
                    android:textColor="@color/secondaryColorTheme"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/unageo_medium"
                android:letterSpacing="0.06"
                android:text="Resonant 2.2.0"
                android:textColor="@color/textTheme"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
