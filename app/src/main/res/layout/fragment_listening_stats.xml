<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColorTheme"
    android:orientation="vertical">

    <!-- Barra superior estándar: atrás + título a la izquierda. -->
    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TopBar.Back"
            android:contentDescription="Volver" />

        <TextView
            style="@style/TopBar.Title"
            android:text="Estadísticas" />
    </LinearLayout>

    <!-- Periodo: píldora deslizante con el acento de la sección (ListeningStatsFragment.setupPeriodTabs). -->
    <com.example.resonant.ui.components.SlidingPillTabs
        android:id="@+id/periodTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPreviousPeriod"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Periodo anterior"
            android:src="@drawable/ic_chevron_left_mini"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvPeriodLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/unageo_medium"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnNextPeriod"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Periodo siguiente"
            android:src="@drawable/ic_chevron_right_mini"
            app:tint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/screen_bottom_inset">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvInsufficientData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/cardsTheme"
                    android:fontFamily="@font/unageo_medium"
                    android:padding="12dp"
                    android:text="Escucha unos días más para ver tus estadísticas"
                    android:textColor="@color/textTheme"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/unageo_extra_bold"
                    android:textColor="@color/white"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tvMinutesCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unageo_medium"
                    android:text="minutos escuchados"
                    android:textColor="@color/textTheme"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMinutesComparison"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/unageo_medium"
                    android:textColor="@color/textTheme"
                    android:textSize="13sp" />

                <com.example.resonant.ui.customviews.DailyMinutesChartView
                    android:id="@+id/chartMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ListeningStatsSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Canciones más escuchadas" />

                    <ImageButton
                        android:id="@+id/btnPlayTopSongs"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reproducir canciones más escuchadas"
                        android:src="@drawable/ic_play"
                        app:tint="@color/secondaryColorTheme" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topSongsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/ListeningStatsSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="24dp"
                    android:text="Artistas" />

                <LinearLayout
                    android:id="@+id/topArtistsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/ListeningStatsSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="24dp"
                    android:text="Géneros" />

                <LinearLayout
                    android:id="@+id/topGenresContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/onThisDaySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ListeningStatsSectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Hoy hace un año" />

                        <ImageButton
                            android:id="@+id/btnPlayOnThisDay"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Reproducir Hoy hace un año"
                            android:src="@drawable/ic_play"
                            app:tint="@color/secondaryColorTheme" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/onThisDayContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/progressLoading"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:lottie_autoPlay="false"
            app:lottie_enableMergePathsForKitKatAndAbove="true"
            app:lottie_fileName="loader.json"
            app:lottie_loop="true"
            app:lottie_repeatCount="-1" />

        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unageo_medium"
                android:gravity="center"
                android:text="No se pudieron cargar tus estadísticas"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/unageo_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/secondaryColorTheme"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
