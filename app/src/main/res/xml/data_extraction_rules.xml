<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_media/" />
        <exclude domain="file" path="offline_covers/" />
        <exclude domain="sharedpref" path="Auth.xml" />
        <exclude domain="sharedpref" path="user_data.xml" />
        <exclude domain="sharedpref" path="playback_resumption.xml" />
        <exclude domain="sharedpref" path="home_v2_cache.xml" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_media/" />
        <exclude domain="file" path="offline_covers/" />
        <exclude domain="sharedpref" path="Auth.xml" />
        <exclude domain="sharedpref" path="user_data.xml" />
        <exclude domain="sharedpref" path="playback_resumption.xml" />
        <exclude domain="sharedpref" path="home_v2_cache.xml" />
    </device-transfer>
</data-extraction-rules>
