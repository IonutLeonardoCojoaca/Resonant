<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta OSCURA (comportamiento actual de la app, sin cambios).
    Se activa cuando ThemeMode.DARK -> AppCompatDelegate.MODE_NIGHT_YES.
    Ver también values/colors.xml para la paleta CLARA equivalente.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="switch_thumb_on">#E21616</color>
    <color name="switch_track_on">#4DE21616</color>

    <color name="switch_thumb_off">#BDBDBD</color>
    <color name="switch_track_off">#424242</color>

    <color name="transparent">#00000000</color>

    <!-- SNACKBAR COLORS -->
    <color name="successColor">#1CC145</color>
    <color name="errorColor">#E21616</color>
    <color name="adviseColor">#D5A91B</color>

    <color name="primaryColorButton">#D1D1D1</color>
    <color name="selectedSongColorWhilePlaying">#2C2C2C</color>
    <color name="titleSongColorWhilePlaying">#E21616</color>

    <color name="sideBar">#0D0D0D</color>

    <color name="primaryColorTheme">#000000</color>
    <color name="cardsTheme">#171717</color>
    <color name="secondaryColorTheme">#E21616</color>
    <color name="textTheme">#A8A8A8</color>
    <color name="pointersTheme">#0D0D0D</color>
    <color name="discTheme">#2B2B2B</color>

    <color name="subtitleBottomSheet">#AAFFFFFF</color>
