    <color name="textTertiaryAlpha">#66FFFFFF</color>
    <color name="surfaceCardOverlay">#26FFFFFF</color>
    <color name="dividerOverlay">#18FFFFFF</color>

    <!-- Player / lyrics card colors -->
    <color name="playerCardBackground">#1A1A1A</color>
    <color name="playerCardHeader">#FF1A1A1A</color>

    <!-- Aria voice overlay colors (Dark mode) -->
    <color name="aria_voice_overlay_bg_start">#2E1224</color>
    <color name="aria_voice_overlay_bg_center">#140A1A</color>
    <color name="aria_voice_overlay_bg_end">#050508</color>

    <color name="nav_text_icon_color">#7A7A7E</color>
