    <color name="login_background">#050506</color>
    <color name="login_accent">#E21616</color>
    <color name="login_text_primary">#FFF8F8</color>
    <color name="login_text_secondary">#B8FFFFFF</color>
    <color name="login_text_tertiary">#7AFFFFFF</color>
    <color name="login_google_surface">#FFF8F8</color>
    <color name="login_google_text">#161416</color>

    <!-- Artist banner gradient overlay -->
    <color name="artist_gradient_start">#FF000000</color>
    <color name="artist_gradient_center">#80000000</color>
    <color name="artist_gradient_end">#00000000</color>

    <!-- Playmix header scrim colors (Dark mode) -->
    <color name="playmix_scrim_start">#00000000</color>
    <color name="playmix_scrim_center">#99000000</color>
    <color name="playmix_scrim_end">#FF000000</color>

    <!-- Search floating header background -->
    <color name="search_header_background">#F0000000</color>

