<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed translucent-dark capsule behind songTabLayout: grounds the icon-only
     tabs so they stay legible regardless of the per-song dynamic background
     color (which can be very light), independent of the day/night theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33000000" />
    <corners android:radius="24dp" />
</shape>
