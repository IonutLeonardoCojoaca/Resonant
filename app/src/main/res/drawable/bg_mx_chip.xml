<?xml version="1.0" encoding="utf-8"?>
<!-- Chip de estilo del editor de PlayMix: degradado de la marca al elegirlo, superficie de tarjeta si no. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22FF7A59">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/playmix_accent_end"
                        android:startColor="@color/playmix_accent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cardsTheme" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/dividerOverlay" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
