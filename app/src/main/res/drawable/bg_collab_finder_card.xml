<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de Collab Finder en Explorar: escenario oscuro fijo de la submarca (degradado vertical + filo de luz),
     igual en los dos temas; sobre él van el motivo de órbitas y textos en blanco literal. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#FF000000"
                android:startColor="#FF1E1E1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
