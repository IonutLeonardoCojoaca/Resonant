<?xml version="1.0" encoding="utf-8"?>
<!-- Opción de los diálogos de PlayMix (visibilidad, fusionar…): borde con el acento de la marca al marcarla. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22FF7A59">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cardsTheme" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/playmix_accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cardsTheme" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/dividerOverlay" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
