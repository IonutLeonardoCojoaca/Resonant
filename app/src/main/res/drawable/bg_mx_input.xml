<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto de los diálogos de PlayMix: borde con el color de la marca al escribir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cardsTheme" />
            <stroke
                android:width="1.5dp"
                android:color="@color/playmix_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cardsTheme" />
            <stroke
                android:width="1dp"
                android:color="@color/dividerOverlay" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
