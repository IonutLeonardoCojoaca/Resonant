<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de los diálogos de PlayMix: superficie de hoja con un brillo cálido arriba y borde fino. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pointersTheme" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#00FF7A59"
                android:gradientRadius="260dp"
                android:startColor="#1FFF7A59"
                android:type="radial" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dividerOverlay" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
