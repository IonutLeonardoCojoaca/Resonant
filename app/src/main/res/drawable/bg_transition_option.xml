<?xml version="1.0" encoding="utf-8"?>
<!-- Opción del selector de transición: borde de acento cuando está seleccionada. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/selectedSongColorWhilePlaying" />
            <stroke android:width="1.5dp" android:color="@color/secondaryColorTheme" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/primaryColorTheme" />
            <stroke android:width="1dp" android:color="@color/dividerOverlay" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
