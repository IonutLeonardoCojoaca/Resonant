<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los ítems de radio: base oscura de las tarjetas + brillo amarillo radial. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_explore_quick_card" />
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.33"
                android:endColor="#00FFD43B"
                android:gradientRadius="95dp"
                android:startColor="#3DFFD43B"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
