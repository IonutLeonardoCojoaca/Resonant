<?xml version="1.0" encoding="utf-8"?>
<!-- PlayMix: dos discos que se solapan. Cada aro es una canción y la lente rellena
     donde se cruzan es la transición, el momento en que suenan las dos a la vez.
     Monocromo (blanco) para que los app:tint de cada pantalla sigan funcionando. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Canción A (saliente) -->
    <path
        android:pathData="M2,12a6.5,6.5 0,1 0,13 0a6.5,6.5 0,1 0,-13 0"
        android:strokeWidth="1.8"
        android:strokeColor="@color/white" />

    <!-- Canción B (entrante) -->
    <path
        android:pathData="M9,12a6.5,6.5 0,1 0,13 0a6.5,6.5 0,1 0,-13 0"
        android:strokeWidth="1.8"
        android:strokeColor="@color/white" />

    <!-- Transición: la lente donde se solapan -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,6.52A6.5,6.5 0,0 1,12 17.48A6.5,6.5 0,0 1,12 6.52Z" />
</vector>
