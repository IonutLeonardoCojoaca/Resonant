<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-anchored fade used behind the featured-album caption (title + track
     count) so they stay legible over any album art, regardless of its own
     brightness. angle=90 draws start->end from bottom to top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#CC000000"
        android:endColor="#00000000" />
</shape>
