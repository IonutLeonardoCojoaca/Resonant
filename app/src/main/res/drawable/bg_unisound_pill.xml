<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined pill for Unisound header actions (copy, share, save, leave). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dividerOverlay">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/pointersTheme" />
            <stroke android:width="1dp" android:color="@color/dividerOverlay" />
        </shape>
    </item>
</ripple>
