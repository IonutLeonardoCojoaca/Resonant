<?xml version="1.0" encoding="utf-8"?>
<!-- Botón Guardar de la barra superior: degradado de PlayMix con cambios pendientes; apagado sin ellos. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cardsTheme" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/dividerOverlay" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/playmix_accent_end"
                        android:startColor="@color/playmix_accent" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
