<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta CLARA (nueva, bucket por defecto / MODE_NIGHT_NO).
    La app usa nombres de color "semánticos" (white = texto/ícono principal,
    textTheme = texto secundario, cardsTheme = superficie de tarjetas,
    discTheme = separadores, pointersTheme = fondo de bottom sheets, etc.)
    en lugar de atributos de Material Theme, así que estos mismos nombres
    se re-mapean aquí a tonos claros y en values-night/colors.xml a los
    tonos oscuros originales. Cualquier layout que use @color/xxx se adapta
    automáticamente al activar AppCompatDelegate.MODE_NIGHT_NO/YES.
-->
<resources>
    <color name="black">#FF000000</color>
    <!-- "white" es el color de texto/ícono principal: en oscuro es blanco
         real, en claro se convierte en un gris casi negro para contraste. -->
    <color name="white">#1A1A1A</color>

    <color name="switch_thumb_on">#E21616</color>
    <color name="switch_track_on">#4DE21616</color>

    <color name="switch_thumb_off">#9E9E9E</color>
    <color name="switch_track_off">#D6D6D6</color>

    <color name="transparent">#00000000</color>

    <!-- SNACKBAR COLORS -->
    <color name="successColor">#1CC145</color>
    <color name="errorColor">#E21616</color>
    <color name="adviseColor">#D5A91B</color>

    <color name="primaryColorButton">#4A4A4A</color>
    <color name="selectedSongColorWhilePlaying">#FBEAEA</color>
    <color name="titleSongColorWhilePlaying">#E21616</color>

    <color name="sideBar">#FFFFFF</color>

    <color name="primaryColorTheme">#FFFFFF</color>
    <color name="cardsTheme">#F1F1F3</color>
    <color name="secondaryColorTheme">#E21616</color>
    <color name="textTheme">#5B5B5F</color>
    <color name="pointersTheme">#FFFFFF</color>
    <color name="discTheme">#E2E2E5</color>

    <color name="subtitleBottomSheet">#AA1A1A1A</color>
    <color name="textBottomSheet">#661A1A1A</color>
    <color name="textEmphasisHigh">#D91A1A1A</color>
    <color name="dividerOnSurface">#1A1A1A1A</color>

    <color name="numberTime">#757575</color>

    <!-- Overlay text colors: use these instead of hardcoded #xxFFFFFF alpha whites.
         In dark mode (values-night) these map to white with alpha;
         in light mode they map to dark with alpha for readability. -->
    <color name="textSecondaryAlpha">#991A1A1A</color>
    <color name="textTertiaryAlpha">#661A1A1A</color>
    <color name="surfaceCardOverlay">#14000000</color>
    <color name="dividerOverlay">#181A1A1A</color>

    <!-- Player / lyrics card colors -->
    <color name="playerCardBackground">#F0F0F2</color>

    <!-- Aria voice overlay colors (Light mode) -->
    <color name="aria_voice_overlay_bg_start">#FFF0F6</color>
    <color name="aria_voice_overlay_bg_center">#FAF5FC</color>
    <color name="aria_voice_overlay_bg_end">#FFFFFF</color>
    <color name="playerCardHeader">#E8E8EA</color>

    <color name="nav_text_icon_color">#76767A</color>
    <color name="nav_text_icon_color_selected">#1A1A1A</color>

    <color name="no_selected_color_icon">#76767A</color>
    <color name="nav_aria_star_unselected">#9E9E9E</color>

    <color name="chip_selected_background">#E21616</color>
    <color name="chip_unselected_background">#ECECEE</color>

    <!-- Login experience: pantalla de marca fija, no cambia con el tema. -->
    <color name="login_background">#050506</color>
    <color name="login_accent">#E21616</color>
    <color name="login_text_primary">#FFF8F8</color>
    <color name="login_text_secondary">#B8FFFFFF</color>
    <color name="login_text_tertiary">#7AFFFFFF</color>
    <color name="login_google_surface">#FFF8F8</color>
    <color name="login_google_text">#161416</color>

    <!-- Artist banner gradient overlay -->
    <color name="artist_gradient_start">#FFFFFFFF</color>
    <color name="artist_gradient_center">#80FFFFFF</color>
    <color name="artist_gradient_end">#00FFFFFF</color>

    <!-- Playmix header scrim colors (Light mode) -->
    <!-- Marca PlayMix: degradado atardecer (naranja → rosa); igual en claro y oscuro. -->
    <color name="playmix_accent">#FF7A59</color>
    <color name="playmix_accent_end">#FF4FB8</color>
    <color name="playmix_rail_start">#80FF7A59</color>
    <color name="playmix_rail_end">#80FF4FB8</color>
    <color name="playmix_glow">#55FF7A59</color>
    <color name="playmix_scrim_start">#00FFFFFF</color>
    <color name="playmix_scrim_center">#80FFFFFF</color>
    <color name="playmix_scrim_end">#FFFFFFFF</color>

    <!-- Marca Resonant (Inicio y menú lateral): degradado rojo → magenta → violeta, igual en los dos temas,
         y superficies de cristal sobre la aurora (estas sí cambian con el tema). -->
    <color name="rs_brand_start">#E21616</color>
    <color name="rs_brand_mid">#FF2E7E</color>
    <color name="rs_brand_end">#7C4DFF</color>
    <color name="rs_glass">#B8FFFFFF</color>
    <color name="rs_glass_stroke">#14000000</color>
    <color name="rs_selected_tint">#14E21616</color>

    <!-- Editor de transiciones de PlayMix: el escenario del visualizador es una pantalla oscura fija
         (como la de un deck), igual en claro y oscuro. -->
    <color name="mx_stage_top">#17161C</color>
    <color name="mx_stage_bottom">#0B0B0E</color>
    <color name="mx_stage_stroke">#1CFFFFFF</color>
    <color name="mx_capsule">#F2141418</color>
    <color name="mx_on_stage">#FFFFFFFF</color>
    <color name="mx_on_stage_dim">#8CFFFFFF</color>

    <!-- Search floating header background -->
    <color name="search_header_background">#F5FFFFFF</color>

    <!-- Explore playlist tile scrim colors (Light mode: deactivated to keep artwork sharp and vibrant) -->
    <color name="explore_playlist_scrim_start">#00000000</color>
    <color name="explore_playlist_scrim_center">#00000000</color>
    <color name="explore_playlist_scrim_end">#00000000</color>

    <!-- Now-playing (SongFragment) dynamic background: brand-fixed, same in both
         themes (the screen's own background is recolored per-song by MiniPlayerColorizer;
         this is only the pre-Palette fallback, matching secondaryColorTheme blended ~80% toward black). -->
    <color name="songBackgroundFallback">#2D0404</color>

    <!-- Playback device card (was hardcoded #241010/#55E21616 in fragment_song.xml,
         which didn't adapt to light theme). -->
    <color name="playbackDeviceCardBackground">#FBEAEA</color>
    <color name="playbackDeviceCardStroke">#33E21616</color>

    <!-- Explore: tokenizes hex that used to be hardcoded in drawables/layouts. -->
    <color name="exploreSectionActionText">@color/textTheme</color>
    <color name="collabPlusBackground">#101010</color>
    <color name="collabButtonAccent">#B81414</color>
    <color name="genreMiniOverlay">#2C2C2C</color>


    <!-- Aria (rediseño agente): superficies translúcidas sobre el fondo ambiental. -->
    <color name="aria_glass">#EBFFFFFF</color>
    <color name="aria_glass_stroke">#14000000</color>
    <color name="aria_accent_soft">#26FF2EA8</color>
    <color name="aria_accent_text">#E0127A</color>
    <color name="aria_bg_clear">#00FFFFFF</color>
    <color name="aria_card_scrim_top">#99F7F7F9</color>
    <color name="aria_live">#1FB866</color>

    <!-- Resonant snackbar (ver utils/SnackbarUtils.kt). Superficie "inversa":
         en tema claro el snackbar es oscuro para destacar sobre el contenido.
         Misma paleta que en tema oscuro para que el componente sea idéntico en ambos. -->
    <color name="snackbar_surface">#FF1E1E22</color>
    <color name="snackbar_stroke">#14FFFFFF</color>
    <color name="snackbar_title">#FFF5F5F7</color>
    <color name="snackbar_message">#B3F5F5F7</color>
    <color name="snackbar_track">#14FFFFFF</color>
    <color name="snackbar_success">#34D065</color>
    <color name="snackbar_error">#FF4D4D</color>
    <color name="snackbar_warning">#F0C02E</color>
    <color name="snackbar_info">#5FA8FF</color>
    <color name="snackbar_brand">#FF3B3B</color>
    <color name="snackbar_neutral">#C7F5F5F7</color>

</resources>
