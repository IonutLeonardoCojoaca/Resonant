<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

    </style>

    <style name="PremiumSquareImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="AppModalStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="FullScreenDialogStyle" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Barras transparentes: el contenido (con sus insets) se dibuja detrás, como en Android 15+. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.Grid.TopLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.Grid.TopRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.Grid.BottomLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.Grid.BottomRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.List.TopLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.List.TopRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.List.BottomLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
    </style>

    <style name="ShapeAppearance.Resonant.Corner.List.BottomRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="PlaylistCoverImage">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="PlaylistCoverImage.List" parent="PlaylistCoverImage">
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="RoundedCornersAlbumSubtle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <!-- Explore grid tiles (item_explore_album/item_explore_playlist): rounder
         than RoundedCornersAlbumSubtle to read as clean tiles, not thumbnails. -->
    <style name="RoundedCornersExploreGrid">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="RoundedCornersFavorites">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="RoundedCornersImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- SongFragment hero album art: bigger radius, closer to the reference. -->
    <style name="RoundedCornersImageLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="RoundedCornersAlbumImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="RoundedCornersDetailedSong">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <!-- Portada nítida de la cabecera de las fichas (canción, álbum). -->
    <style name="DetailHeroArtShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="CircularUserImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BottomNavTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/unageo_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">20sp</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemBackground">@android:color/transparent</item>
        <item name="itemIconTint">@null</item>
        <item name="itemTextColor">@color/nav_text_icon_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavTextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavTextAppearance</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="fontFamily">@font/unageo_bold</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
    </style>

    <style name="Widget.App.Button.IconOnly" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconSize">34dp</item>
    </style>

    <style name="DialogAnimationUpDown">
        <item name="android:windowEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_to_bottom</item>
    </style>

    <style name="DrawerItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>


    <!-- Unisound room -->
    <style name="UnisoundHeaderAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/bg_unisound_pill</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="UnisoundTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/textTheme</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="UnisoundTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="UnisoundRowAction">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/textTheme</item>
    </style>

    <!-- Opción del selector de periodo de los rankings (view_chart_period_selector). -->
    <style name="ChartPeriodOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/unageo_semi_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Dato compacto de PlayMix (BPM, duración, tono): píldora oscura con texto en negrita. -->
    <style name="PlaymixStatChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_playmix_stat_chip</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <!-- Fila de "Top canciones" en la tarjeta de entidad de Aria. -->
    <style name="AriaCardTrackRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/textEmphasisHigh</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- ═══ Fichas (canción, álbum, artista) ═══ -->
    <style name="DetailSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <style name="DetailTile">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="DetailTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">9.5sp</item>
    </style>

    <style name="DetailTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="DetailTileCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <!-- ═══ Filas de los bottom sheets de opciones (mismo icono, espacio y tinte en todos) ═══ -->
    <style name="OptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="OptionRow.Destructive">
        <item name="android:drawableTint">@color/errorColor</item>
        <item name="android:textColor">@color/errorColor</item>
    </style>

    <style name="OptionRow.Muted">
        <item name="android:drawableTint">@color/textTheme</item>
        <item name="android:textColor">@color/textTheme</item>
    </style>
    <!-- Título de sección del editor de transición v2 (PRESET, VENTANA). -->
    <!-- Marca Resonant (Inicio y menú lateral): rótulo pequeño, título de sección y acceso rápido. -->
    <style name="RsEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Título y subtítulo de sección de Inicio: los mismos que las cabeceras de Explorar. -->
    <style name="RsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="RsSectionSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="RsShortcut">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_rs_glass_pill</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:fontFamily">@font/unageo_semi_bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13.5sp</item>
    </style>

    <!-- Editor de transiciones de PlayMix: rótulo de sección y pastilla de datos (BPM, Camelot). -->
    <style name="MxEyebrow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/textTheme</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="MxTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:background">@drawable/bg_mx_tag</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">30dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <style name="MixV2SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#80FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ═══ Barra superior: la misma en todas las pantallas ═══
         TopBar (LinearLayout horizontal de 56dp) + TopBar.Back + TopBar.Title + TopBar.Action.
         El paddingHorizontal de 4dp más el padding de 12dp de los botones de 48dp deja el icono a 16dp del borde,
         alineado con el margen de pantalla. Pantallas fijas: título bold 20sp a la izquierda. Fichas y cabeceras
         plegables: TopBar.Title.Collapsed (16sp) que aparece al plegar. Sobre portada: variantes OnImage. -->
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="TopBar.Back">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_nav_back</item>
        <item name="tint">@color/white</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">Volver</item>
        <item name="android:tooltipText">Volver</item>
    </style>

    <!-- Sobre portada o foto: círculo translúcido y blanco literal (el fondo es la imagen, no el tema). -->
    <style name="TopBar.Back.OnImage">
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/bg_top_bar_button_on_image</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="TopBar.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Título de barra que aparece al plegar una cabecera (fichas, rankings, biblioteca). -->
    <style name="TopBar.Title.Collapsed">
        <item name="android:textSize">16sp</item>
        <item name="android:alpha">0</item>
    </style>

    <style name="TopBar.Title.Collapsed.OnImage">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TopBar.Action">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/white</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="TopBar.Action.OnImage">
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/bg_top_bar_button_on_image</item>
        <item name="tint">@android:color/white</item>
    </style>

    <!-- Chip de filtro (Buscar): píldora rellena sin borde, 36dp visibles y 48dp de área táctil. -->
    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:checkable">true</item>
        <item name="android:textColor">@color/chip_text_color_selector</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Acción de texto en la barra ("Marcar todo", "Guardar"): rojo de marca, 48dp de alto. -->
    <style name="TopBar.TextAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondaryColorTheme</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <!-- Crear con IA (add-ai-track-generation) -->
    <style name="AiTrackLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:fontFamily">@font/unageo_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AiTrackInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_mx_input</item>
        <item name="android:fontFamily">@font/unageo_medium</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/textTheme</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="AiTrackCoverShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
</resources>
